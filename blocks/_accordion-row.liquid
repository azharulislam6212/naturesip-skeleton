{% doc %}
  One collapsible row of the accordion block.

  @example
  {% content_for 'block', type: '_accordion-row', id: 'row' %}
{% enddoc %}

<details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
  <summary class="accordion__summary">
    <span class="accordion__title">
      {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
      {{ block.settings.heading | escape }}
    </span>
    <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
  </summary>
  <div class="accordion__content rte">
    {{ block.settings.content }}
    {%- if block.settings.page != blank -%}
      {{ block.settings.page.content }}
    {%- endif -%}
  </div>
</details>

