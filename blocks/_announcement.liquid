{% doc %}
  One message in the announcement bar.

  @example
  {% content_for 'block', type: '_announcement', id: 'message' %}
{% enddoc %}

<li class="announcement slider__slide" {{ block.shopify_attributes }}>
  {%- if block.settings.link != blank -%}
    <a class="announcement__text" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
  {%- else -%}
    <p class="announcement__text">{{ block.settings.text }}</p>
  {%- endif -%}
</li>

{% schema %}
{
  "name": "t:blocks.announcement.name",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:defaults.announcement"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.announcement.name"
    }
  ]
}
{% endschema %}
