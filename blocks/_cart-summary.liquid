{% doc %}
  Cart page summary column: optional blocks (free shipping progress, gift
  wrap, shipping calculator, order note, text…) above the static checkout
  block, which always renders last so totals and the checkout button can't
  be removed. Can stick while the items scroll and sit on a card.

  Static block of sections/main-cart.

  @example
  {% content_for 'block', type: '_cart-summary', id: 'summary' %}
{% enddoc %}

{%- assign s = block.settings -%}

<aside
  class="cart-summary-panel spacing-style{% if s.sticky %} cart-summary-panel--sticky{% endif %}{% if s.show_card %} cart-summary-panel--card{% endif %}{% if s.custom_color_scheme %} color-{{ s.color_scheme.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: s -%}
    --summary-gap: {{ s.gap | divided_by: 16.0 }}rem;
  "
  aria-label="{{ 'cart.summary' | t }}"
  {{ block.shopify_attributes }}
>
  <div class="cart-summary">
    {% content_for 'blocks' %}
    {% content_for 'block', type: '_cart-checkout', id: 'checkout' %}
  </div>
</aside>

{% schema %}
{
  "name": "t:blocks.cart_summary.name",
  "tag": null,
  "blocks": [
    {
      "type": "_cart-free-shipping"
    },
    {
      "type": "_cart-gift-wrap"
    },
    {
      "type": "_cart-shipping-estimator"
    },
    {
      "type": "_cart-note"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "icon-text"
    },
    {
      "type": "divider"
    },
    {
      "type": "_product-payment-icons"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:settings.sticky_summary",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "checkbox",
      "id": "show_card",
      "label": "t:settings.show_card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "custom_color_scheme",
      "label": "t:settings.custom_color_scheme",
      "default": false
    },
    {
      "visible_if": "{{ block.settings.custom_color_scheme }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
