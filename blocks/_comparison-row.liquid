{% doc %}
  One row of the comparison table: a feature, then a tick, a cross or a
  short text for your brand and for "others".

  @example
  {% content_for 'block', type: '_comparison-row', id: 'row' %}
{% enddoc %}

<div class="comparison__row" role="row" {{ block.shopify_attributes }}>
  <div class="comparison__label" role="rowheader">{{ block.settings.label | escape }}</div>
  {%- assign cells = 'us,them' | split: ',' -%}
  {%- for cell in cells -%}
    {%- assign key = cell | append: '_value' -%}
    {%- assign value = block.settings[key] -%}
    <div class="comparison__cell comparison__cell--{{ cell }}" role="cell">
      {%- case value -%}
        {%- when 'yes' -%}
          <svg class="comparison__mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
            <path d="M25.20 14.00Q28.00 18.55 23.06 20.58Q22.65 25.91 17.46 24.65Q14.00 28.72 10.54 24.65Q5.35 25.91 4.94 20.58Q0.00 18.55 2.80 14.00Q0.00 9.45 4.94 7.42Q5.35 2.09 10.54 3.35Q14.00 -0.72 17.46 3.35Q22.65 2.09 23.06 7.42Q28.00 9.45 25.20 14.00Z"/>
            <path d="M9.8 14.2l2.9 2.9 5.5-5.6"/>
          </svg>
          <span class="visually-hidden">{{ 'sections.comparison.yes' | t }}</span>
        {%- when 'no' -%}
          <svg class="comparison__mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
            <path d="M25.20 14.00Q28.00 18.55 23.06 20.58Q22.65 25.91 17.46 24.65Q14.00 28.72 10.54 24.65Q5.35 25.91 4.94 20.58Q0.00 18.55 2.80 14.00Q0.00 9.45 4.94 7.42Q5.35 2.09 10.54 3.35Q14.00 -0.72 17.46 3.35Q22.65 2.09 23.06 7.42Q28.00 9.45 25.20 14.00Z"/>
            <path d="M10.8 10.8l6.4 6.4M17.2 10.8l-6.4 6.4"/>
          </svg>
          <span class="visually-hidden">{{ 'sections.comparison.no' | t }}</span>
        {%- else -%}
          {%- assign text_key = cell | append: '_text' -%}
          <span class="comparison__text">{{ block.settings[text_key] | escape }}</span>
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:blocks.comparison_row.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:defaults.comparison_row"
    },
    {
      "type": "select",
      "id": "us_value",
      "label": "t:settings.us_value",
      "options": [
        {
          "value": "yes",
          "label": "t:options.comparison.yes"
        },
        {
          "value": "no",
          "label": "t:options.comparison.no"
        },
        {
          "value": "text",
          "label": "t:options.comparison.text"
        }
      ],
      "default": "yes"
    },
    {
      "type": "text",
      "id": "us_text",
      "label": "t:settings.us_text",
      "visible_if": "{{ block.settings.us_value == 'text' }}"
    },
    {
      "type": "select",
      "id": "them_value",
      "label": "t:settings.them_value",
      "options": [
        {
          "value": "yes",
          "label": "t:options.comparison.yes"
        },
        {
          "value": "no",
          "label": "t:options.comparison.no"
        },
        {
          "value": "text",
          "label": "t:options.comparison.text"
        }
      ],
      "default": "no"
    },
    {
      "type": "text",
      "id": "them_text",
      "label": "t:settings.them_text",
      "visible_if": "{{ block.settings.them_value == 'text' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.comparison_row.name"
    }
  ]
}
{% endschema %}
