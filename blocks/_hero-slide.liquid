{% doc %}
  One slide of the Slideshow (hero): its gradient (with the section's wave
  and grid), its can on a stage fixed to the viewport (snippets/hero-can.liquid,
  moved by assets/hero-slideshow.js), the big word behind the can, and its
  blocks: heading, text and button, and floating images.

  The word is split into letters here, so its entrance plays from the first
  paint (assets/section-hero-slideshow.css).

  @example
  {% content_for 'block', type: '_hero-slide', id: 'slide' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign index = section.blocks | find_index: 'id', block.id
  if index == nil
    assign index = 0
  endif
  assign position = index | plus: 1
  assign letters = s.word | strip | split: ''
-%}

<div
  class="hero-slide"
  data-index="{{ index }}"
  style="--word-color: {{ s.word_color }}; --copy-color: {{ s.text_color }};"
  data-scroll-turn="{{ s.scroll_turn }}"
  role="group"
  aria-roledescription="{{ 'accessibility.slide' | t }}"
  aria-label="{{ 'accessibility.slide_position' | t: index: position, count: section.blocks.size | escape }}"
  {% if index == 0 %}
    data-active
  {% else %}
    inert
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="hero-slide__backdrop" style="background: {{ s.gradient | default: 'linear-gradient(120deg, #342a5e, #6c4541)' }};" aria-hidden="true"></div>

  {%- if letters.size > 0 -%}
    <p class="hero-slide__word">
      <span class="visually-hidden">{{ s.word | escape }}</span>
      {%- for letter in letters -%}
        <span class="hero-slide__letter" style="--i: {{ forloop.index0 }};" aria-hidden="true">
          {%- if letter == ' ' -%}&nbsp;{%- else -%}{{ letter | escape }}{%- endif -%}
        </span>
      {%- endfor -%}
    </p>
  {%- endif -%}

  <div class="hero-slideshow__stage" aria-hidden="true">
    <div class="hero-slideshow__can">
      <div class="hero-slideshow__float">
        {% render 'hero-can', block: block, index: index %}
      </div>
    </div>
  </div>

  {%- comment -%}
    Heading, text and button blocks stack bottom left; floating images are
    placed over the whole slide (assets/section-hero-slideshow.css). The
    color scheme gives the blocks their button colors; the slide's gradient
    stays the background.
  {%- endcomment -%}
  <div class="hero-slide__content color-{{ s.color_scheme.id }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.hero_slide.name",
  "tag": null,
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "_hero-floater"
    }
  ],
  "settings": [
    {
      "type": "color_background",
      "id": "gradient",
      "label": "t:settings.gradient",
      "default": "linear-gradient(120deg, rgba(52, 42, 94, 1) 0%, rgba(108, 69, 65, 1) 100%)"
    },
    {
      "type": "header",
      "content": "t:blocks.hero_slide.headers.can"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:blocks.hero_slide.settings.product_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.hero_slide.settings.image",
      "info": "t:blocks.hero_slide.settings.image_info"
    },
    {
      "type": "checkbox",
      "id": "scroll_turn",
      "label": "t:blocks.hero_slide.settings.scroll_turn",
      "info": "t:blocks.hero_slide.settings.scroll_turn_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.content"
    },
    {
      "type": "text",
      "id": "word",
      "label": "t:blocks.hero_slide.settings.word",
      "default": "Mango"
    },
    {
      "type": "color",
      "id": "word_color",
      "label": "t:blocks.hero_slide.settings.word_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "info": "t:blocks.hero_slide.settings.color_scheme_info",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.hero_slide.settings.text_color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hero_slide.name",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Made From Nature",
            "type_preset": "h4",
            "animation": "none",
            "text_animation": "none"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Naturally caffeinated. Packed with antioxidants. Zero artificial junk. This is energy, redone right.</p>",
            "type_preset": "paragraph",
            "animation": "none",
            "text_animation": "none"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "Shop now",
            "style": "primary",
            "icon": "bag",
            "animation": "none"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "button"
      ]
    }
  ]
}
{% endschema %}
