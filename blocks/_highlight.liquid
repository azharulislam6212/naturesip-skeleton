{% doc %}
  One highlight of the Featured highlights section: an icon (a static icon
  block, which carries its own tile and gradient), then any heading and
  text blocks. Animates in after the one before it (the section's grid
  staggers its children).

  @example
  {% content_for 'block', type: '_highlight', id: 'highlight' %}
{% enddoc %}

{%- assign s = block.settings -%}

<div
  class="highlight spacing-style"
  style="{%- render 'spacing-style', settings: s -%} --highlight-gap: {{ s.gap | divided_by: 16.0 }}rem;"
  {% render 'animation-attributes', animation: s.animation, delay: s.animation_delay %}
  {{ block.shopify_attributes }}
>
  {% content_for 'block', type: 'icon', id: 'icon' %}
  {% content_for 'blocks' %}
</div>


{% schema %}
{
  "name": "t:blocks.highlight.name",
  "tag": null,
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:headers.animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:settings.animation",
      "options": [
        {
          "value": "theme",
          "label": "t:options.animation.theme"
        },
        {
          "value": "none",
          "label": "t:options.animation.none"
        },
        {
          "value": "fade",
          "label": "t:options.animation.fade"
        },
        {
          "value": "rise",
          "label": "t:options.animation.rise"
        },
        {
          "value": "zoom",
          "label": "t:options.animation.zoom"
        },
        {
          "value": "slide-start",
          "label": "t:options.animation.slide_start"
        },
        {
          "value": "slide-end",
          "label": "t:options.animation.slide_end"
        },
        {
          "value": "fade-up",
          "label": "t:options.animation.fade_up"
        },
        {
          "value": "blur",
          "label": "t:options.animation.blur"
        },
        {
          "value": "clip-up",
          "label": "t:options.animation.clip_up"
        },
        {
          "value": "flip-up",
          "label": "t:options.animation.flip_up"
        },
        {
          "value": "reveal",
          "label": "t:options.animation.reveal"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:settings.animation_delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.highlight.name",
      "category": "t:categories.blocks.text",
      "blocks": {
        "icon": {
          "type": "icon",
          "static": true,
          "settings": {
            "icon": "sparkle",
            "size_preset": "custom",
            "size": 36,
            "show_tile": true
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Highlight",
            "tag": "h3",
            "type_preset": "h6"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Share what makes this product special.</p>"
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ]
    }
  ]
}
{% endschema %}
