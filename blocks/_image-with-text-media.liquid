{% doc %}
  The image of the Image with text section. Scrubs an entrance with the page
  scroll (<scroll-media>, assets/scroll-media.js): a 3D tilt, a zoom reveal,
  a turn or parallax. Static block of sections/image-with-text.

  @example
  {% content_for 'block', type: '_image-with-text-media', id: 'media' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  case s.ratio
    when 'square'
      assign ratio = '1'
    when 'portrait'
      assign ratio = '0.8'
    when 'landscape'
      assign ratio = '1.33'
    else
      assign ratio = s.image.aspect_ratio | default: '1'
  endcase
  assign mobile_image = s.image_mobile | default: s.image
-%}

<div class="image-with-text__media spacing-style" style="{%- render 'spacing-style', settings: s -%}" {{ block.shopify_attributes }}>
  <scroll-media
    class="scroll-media scroll-media--{{ s.scroll_animation }}"
    style="--ratio: {{ ratio }}; --media-radius: {{ s.radius | divided_by: 16.0 }}rem; --scroll-strength: {{ s.strength | divided_by: 100.0 }};"
  >
    <div class="scroll-media__frame media">
      {%- if s.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 1200 }}">
          {% render 'image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', eager: s.priority, placeholder: 'lifestyle-1' %}
        </picture>
      {%- else -%}
        {% render 'image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', eager: s.priority, placeholder: 'lifestyle-1' %}
      {%- endif -%}
    </div>
  </scroll-media>
</div>

{% schema %}
{
  "name": "t:blocks.image_with_text_media.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.image_mobile"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "natural",
          "label": "t:options.ratio.natural"
        },
        {
          "value": "square",
          "label": "t:options.ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.ratio.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "priority",
      "label": "t:settings.priority",
      "default": false
    },
    {
      "type": "header",
      "content": "t:headers.scroll_animation"
    },
    {
      "type": "select",
      "id": "scroll_animation",
      "label": "t:settings.scroll_animation",
      "info": "t:settings.scroll_animation_info",
      "options": [
        {
          "value": "tilt",
          "label": "t:options.scroll_animation.tilt"
        },
        {
          "value": "zoom",
          "label": "t:options.scroll_animation.zoom"
        },
        {
          "value": "rotate",
          "label": "t:options.scroll_animation.rotate"
        },
        {
          "value": "parallax",
          "label": "t:options.scroll_animation.parallax"
        },
        {
          "value": "none",
          "label": "t:options.scroll_animation.none"
        }
      ],
      "default": "tilt"
    },
    {
      "visible_if": "{{ block.settings.scroll_animation != 'none' }}",
      "type": "range",
      "id": "strength",
      "label": "t:settings.animation_strength",
      "min": 20,
      "max": 150,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
