{% doc %}
  One message in the scrolling text ribbon.

  @example
  {% content_for 'block', type: '_marquee-item', id: 'item' %}
{% enddoc %}

<li class="marquee__item" {{ block.shopify_attributes }}>
  <span>{{ block.settings.text }}</span>
  {%- if section.settings.separator != 'none' -%}
    <span class="marquee__separator" aria-hidden="true">{% render 'icon', name: section.settings.separator %}</span>
  {%- endif -%}
</li>

{% schema %}
{
  "name": "t:blocks.marquee_item.name",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:defaults.marquee_1"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.marquee_item.name"
    }
  ]
}
{% endschema %}
