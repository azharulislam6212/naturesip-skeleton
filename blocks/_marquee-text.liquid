{% doc %}
  A message in the scrolling text ribbon.

  @example
  {% content_for 'block', type: '_marquee-text', id: 'text' %}
{% enddoc %}

{% render 'marquee-item', block: block, editor: true %}

{% schema %}
{
  "name": "t:blocks.marquee_text.name",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:defaults.marquee_text"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.marquee_text.name"
    }
  ]
}
{% endschema %}
