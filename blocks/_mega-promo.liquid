{% doc %}
  A promotion banner in a mega menu: heading, image, then a line of text with
  a link.
{% enddoc %}

{%- liquid
  assign p = block.settings
  assign url = p.link | default: '#'
-%}

<div class="mega-menu__promo" {{ block.shopify_attributes }}>
  {%- if p.heading != blank -%}
    <p class="mega-menu__title">{{ p.heading }}</p>
  {%- endif -%}
  <a class="mega-menu__promo-media" href="{{ url }}" tabindex="-1" aria-hidden="true">
    {%- if p.image -%}
      {{ p.image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', widths: '400, 600, 800', sizes: '340px' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </a>
  {%- if p.text != blank or p.link_label != blank -%}
    <p class="mega-menu__promo-text">
      {{ p.text }}
      {%- if p.link_label != blank %}
        <a class="menu-underline" href="{{ url }}">{{ p.link_label | escape }}</a>
      {%- endif -%}
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.mega_promo.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Off work on payday."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "New Arrival Sale 20% Discount"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.mega_promo.name"
    }
  ]
}
{% endschema %}
