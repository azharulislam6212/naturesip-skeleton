{% doc %}
  A promotion card in a mega menu: image on top, then heading, text and a
  button. The image links too, but stays out of the tab order (the button
  carries the link for keyboards and screen readers).
{% enddoc %}

{%- liquid
  assign p = block.settings
  assign url = p.link | default: '#'
-%}

<div class="mega-menu__promo" {{ block.shopify_attributes }}>
  <a class="mega-menu__promo-media" href="{{ url }}" tabindex="-1" aria-hidden="true">
    {%- if p.image -%}
      {{ p.image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', widths: '400, 600, 800', sizes: '340px' }}
    {%- else -%}
      {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  {%- if p.heading != blank or p.text != blank or p.link_label != blank -%}
    <div class="mega-menu__promo-body">
      {%- if p.heading != blank -%}
        <p class="mega-menu__promo-heading">{{ p.heading }}</p>
      {%- endif -%}
      {%- if p.text != blank -%}
        <p class="mega-menu__promo-text">{{ p.text }}</p>
      {%- endif -%}
      {%- if p.link_label != blank -%}
        {% render 'button', label: p.link_label, url: url, size: 'small', icon: 'arrow', class: 'mega-menu__promo-button' %}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.mega_promo.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Off work on payday."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "New Arrival Sale 20% Discount"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.mega_promo.name"
    }
  ]
}
{% endschema %}
