{% doc %}
  Product details column: holds the product information blocks (title,
  price, options, buy buttons…) and any theme or app block. Can stick while
  the gallery scrolls and can sit on its own colour scheme panel.

  Static block of sections/main-product and sections/featured-product.

  @example
  {% content_for 'block', type: '_product-details', id: 'details' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign border_width = 0
  if s.border == 'solid'
    assign border_width = s.border_width
  endif
-%}

<div
  class="product-details spacing-style{% if s.sticky %} product-details--sticky{% endif %}{% if s.custom_color_scheme %} product-details--panel color-{{ s.color_scheme.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: s -%}
    --details-gap: {{ s.gap | divided_by: 16.0 }}rem;
    --details-radius: {{ s.border_radius | divided_by: 16.0 }}rem;
    --details-border-width: {{ border_width }}px;
    --details-border-opacity: {{ s.border_opacity }}%;
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:blocks.product_details.name",
  "tag": null,
  "blocks": [
    {
      "type": "_product-title"
    },
    {
      "type": "_product-rating"
    },
    {
      "type": "_product-price"
    },
    {
      "type": "_product-description"
    },
    {
      "type": "_product-variant-picker"
    },
    {
      "type": "_product-inventory"
    },
    {
      "type": "_product-sku"
    },
    {
      "type": "_product-vendor"
    },
    {
      "type": "_product-buy-buttons"
    },
    {
      "type": "_product-payment-icons"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "icon-text"
    },
    {
      "type": "accordion"
    },
    {
      "type": "share"
    },
    {
      "type": "divider"
    },
    {
      "type": "spacer"
    },
    {
      "type": "group"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:headers.layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:settings.sticky_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "checkbox",
      "id": "custom_color_scheme",
      "label": "t:settings.custom_color_scheme",
      "default": false
    },
    {
      "visible_if": "{{ block.settings.custom_color_scheme }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.border.none"
        },
        {
          "value": "solid",
          "label": "t:options.border.solid"
        }
      ],
      "default": "none"
    },
    {
      "visible_if": "{{ block.settings.border != 'none' }}",
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "visible_if": "{{ block.settings.border != 'none' }}",
      "type": "range",
      "id": "border_opacity",
      "label": "t:settings.border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
