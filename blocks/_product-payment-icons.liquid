{% doc %}
  Payment icons for the payment methods enabled in the store, with an
  optional heading between two dotted rules.

  @example
  {% content_for 'block', type: '_product-payment-icons', id: 'payment-icons' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'products.payment_icons.heading' | t
  endif
-%}

<div
  class="payment-icons payment-icons--{{ s.alignment }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%}"
  {{ block.shopify_attributes }}
>
  {%- if s.show_heading -%}
    <p class="payment-icons__heading{% if s.show_rules %} payment-icons__heading--rules{% endif %}">
      <span>{{ heading | escape }}</span>
    </p>
  {%- endif -%}

  {%- if shop.enabled_payment_types.size > 0 -%}
    <ul class="payment-icons__list" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
      {%- for type in shop.enabled_payment_types -%}
        <li class="payment-icons__item">{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.product_payment_icons.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "t:settings.show_heading",
      "default": true
    },
    {
      "visible_if": "{{ block.settings.show_heading }}",
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:settings.payment_heading_info"
    },
    {
      "visible_if": "{{ block.settings.show_heading }}",
      "type": "checkbox",
      "id": "show_rules",
      "label": "t:settings.show_rules",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.text_align.left"
        },
        {
          "value": "center",
          "label": "t:options.text_align.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_payment_icons.name",
      "category": "t:categories.blocks.product"
    }
  ]
}
{% endschema %}
