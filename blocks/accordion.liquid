{% doc %}
  Accordion block: a list of collapsible rows (private `_accordion-row` blocks).

  @example
  {% content_for 'block', type: 'accordion', id: 'accordion' %}
{% enddoc %}

<div
  class="accordion-block spacing-style size-style"
  style="{%- render 'spacing-style', settings: block.settings -%} {% render 'size-style', settings: block.settings %}"
  {% render 'animation-attributes', animation: block.settings.animation, delay: block.settings.animation_delay %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="type-heading type-{{ block.settings.heading_size | replace: '_', '-' }} accordion-block__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
/* Global: Shopify bundles this into every page, so <details class="accordion">
   in filters, cart, product and password pages uses it too. */
@layer components {
  .accordion {
    border-block-end: 1px solid var(--color-border);
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 3rem;
    padding-block: var(--space-sm);
    cursor: pointer;
    list-style: none;
    font-weight: var(--font-body--weight-bold);
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__icon {
    transition: rotate var(--duration-base) var(--ease-out);
  }

  .accordion[open] .accordion__icon {
    rotate: 45deg;
  }

  .accordion::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size var(--duration-base) var(--ease-out), content-visibility var(--duration-base) allow-discrete;
  }

  .accordion[open]::details-content {
    block-size: auto;
  }

  .accordion__content {
    padding-block-end: var(--space-md);
  }


  /* Accordion: overflow: clip animates the height; room on the sides and
     top keeps checkbox, swatch and slider focus rings whole. */
  .accordion::details-content {
    margin-inline: -0.5rem;
    padding-inline: 0.5rem;
  }

  .accordion__content {
    padding-block-start: 0.375rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.accordion.name",
  "tag": null,
  "blocks": [
    {
      "type": "_accordion-row"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings.heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:options.type_preset.h2"
        },
        {
          "value": "h3",
          "label": "t:options.type_preset.h3"
        },
        {
          "value": "h4",
          "label": "t:options.type_preset.h4"
        },
        {
          "value": "h5",
          "label": "t:options.type_preset.h5"
        },
        {
          "value": "h6",
          "label": "t:options.type_preset.h6"
        }
      ],
      "default": "h4"
    },
    {
      "type": "header",
      "content": "t:headers.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit",
          "label": "t:options.width.fit"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width_mobile",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
