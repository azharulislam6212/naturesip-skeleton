{% doc %}
  Group block: a flexible container for any other blocks. Direction, gaps
  (with a separate row gap when wrapping), alignment, desktop and mobile
  width, colour scheme (with gradient), background image, border, sticky
  positioning and device-aware padding.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign horizontal = false
  if s.direction == 'row'
    assign horizontal = true
  endif

  assign classes = 'group layout-stack spacing-style size-style'
  if horizontal
    assign classes = classes | append: ' layout-stack--horizontal'
  endif
  if s.inherit_color_scheme == false
    assign classes = classes | append: ' color-' | append: s.color_scheme.id
  endif
  if s.sticky
    assign classes = classes | append: ' group--sticky'
  endif
  if s.background_image != blank
    assign classes = classes | append: ' section-surface'
  endif

  # Max width caps any width (Fill grows to the parent up to it). Alignment
  # places a capped or fit group in its parent; 'inherit' follows the parent.
  assign align_self = blank
  assign align_self_mobile = blank
  case s.alignment
    when 'left'
      assign align_self = 'flex-start'
    when 'center'
      assign align_self = 'center'
    when 'right'
      assign align_self = 'flex-end'
  endcase
  case s.alignment_mobile
    when 'left'
      assign align_self_mobile = 'flex-start'
    when 'center'
      assign align_self_mobile = 'center'
    when 'right'
      assign align_self_mobile = 'flex-end'
  endcase

  # Each direction has its own pair of settings, so only valid options show:
  # vertical stacks can't "space between" across, horizontal rows can't
  # "stretch" along. The horizontal setting also sets the text alignment
  # that heading/text blocks inside follow.
  if horizontal
    assign justify = s.horizontal_alignment_row
    assign align = s.vertical_alignment_row
    assign horizontal_choice = s.horizontal_alignment_row
  else
    assign justify = s.vertical_alignment
    assign align = s.horizontal_alignment
    assign horizontal_choice = s.horizontal_alignment
  endif
-%}
{%- capture max_width -%}{% render 'max-width', settings: s %}{%- endcapture -%}
{%- assign max_width = max_width | strip -%}

<div
  class="{{ classes }}"
  style="
    {%- render 'spacing-style', settings: s -%}
    --direction: {{ s.direction }};
    --wrap: {% if s.wrap %}wrap{% else %}nowrap{% endif %};
    --justify: {{ justify }};
    --align: {{ align }};
    --gap: {{ s.gap }}px;
    --gap-tablet: {{ s.gap }}px;
    --gap-mobile: {{ s.gap_mobile }}px;
    {%- if horizontal and s.wrap %}--row-gap: {{ s.row_gap }}px;{% endif %}
    --stack-text-align: {% case horizontal_choice %}{% when 'center' %}center{% when 'flex-end' %}end{% else %}start{% endcase %};
    --group-radius: {{ s.border_radius }}px;
    {%- if s.border %}--group-border-width: {{ s.border_width }}px; --group-border-opacity: {{ s.border_opacity }}%;{% endif -%}
    {% render 'size-style', settings: s %}
    {%- if s.min_height > 0 %}min-height: {{ s.min_height }}px;{% endif -%}
    {%- if max_width != blank %}max-width: {{ max_width }};{% endif -%}
    {%- if align_self != blank %}--align-self: {{ align_self }};{% endif -%}
    {%- if align_self_mobile != blank %}--align-self-mobile: {{ align_self_mobile }};{% endif -%}
  "
  {% if horizontal and s.stack_on_mobile %}
    data-stack-mobile
  {% endif %}
  {% if horizontal and s.wrap %}
    data-row-gap
  {% endif %}
  {% render 'animation-attributes', animation: s.animation, delay: s.animation_delay, stagger: s.stagger_children %}
  {{ block.shopify_attributes }}
>
  {%- if s.background_image != blank -%}
    {% render 'background', settings: s %}
  {%- endif -%}
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:blocks.group.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:headers.layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.direction.column"
        },
        {
          "value": "row",
          "label": "t:options.direction.row"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:settings.stack_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "t:settings.wrap",
      "default": false,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.horizontal_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.alignment.flex_start"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.alignment.flex_end"
        },
        {
          "value": "stretch",
          "label": "t:options.alignment.stretch"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.vertical_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.alignment.flex_start"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.alignment.flex_end"
        },
        {
          "value": "space-between",
          "label": "t:options.alignment.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_row",
      "label": "t:settings.horizontal_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.alignment.flex_start"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.alignment.flex_end"
        },
        {
          "value": "space-between",
          "label": "t:options.alignment.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_row",
      "label": "t:settings.vertical_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.alignment.flex_start"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.alignment.flex_end"
        },
        {
          "value": "stretch",
          "label": "t:options.alignment.stretch"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:settings.gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.row_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.direction == 'row' and block.settings.wrap }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit",
          "label": "t:options.width.fit"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "same",
          "label": "t:options.width.same"
        },
        {
          "value": "fit",
          "label": "t:options.width.fit"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "same"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width_mobile",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' or block.settings.width_mobile == 'same' and block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "max_width_preset",
      "label": "t:settings.max_width",
      "options": [
        {
          "value": "none",
          "label": "t:options.max_width.none"
        },
        {
          "value": "small",
          "label": "t:options.max_width.small"
        },
        {
          "value": "medium",
          "label": "t:options.max_width.medium"
        },
        {
          "value": "large",
          "label": "t:options.max_width.large"
        },
        {
          "value": "custom",
          "label": "t:options.max_width.custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:settings.max_width_custom",
      "min": 200,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 600,
      "visible_if": "{{ block.settings.max_width_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.text_align.inherit"
        },
        {
          "value": "left",
          "label": "t:options.text_align.left"
        },
        {
          "value": "center",
          "label": "t:options.text_align.center"
        },
        {
          "value": "right",
          "label": "t:options.text_align.right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:settings.alignment_mobile",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.text_align.same"
        },
        {
          "value": "left",
          "label": "t:options.text_align.left"
        },
        {
          "value": "center",
          "label": "t:options.text_align.center"
        },
        {
          "value": "right",
          "label": "t:options.text_align.right"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:settings.min_height",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:settings.sticky",
      "default": false
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "t:settings.background_image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.background_image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "t:settings.border",
      "default": false
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0.5,
      "max": 8,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:settings.border_opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
