{% doc %}
  Icon with text: an icon (or image) in an optional frame, a title and text.
  Used on its own or inside sections such as Feature steps.

  @example
  {% content_for 'block', type: 'icon-text', id: 'icon-text' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign title_class = 'icon-text__title type-heading type-' | append: s.title_size | replace: '_', '-'
  if s.title_size == 'subheading'
    assign title_class = 'icon-text__title type-subheading'
  endif
  case s.alignment
    when 'left'
      assign align = 'flex-start'
    when 'right'
      assign align = 'flex-end'
    else
      assign align = 'center'
  endcase
-%}

<div
  class="icon-text spacing-style"
  data-frame="{{ s.frame }}"
  style="
    {%- render 'spacing-style', settings: s -%}
    --icon-direction: {% if s.layout == 'horizontal' %}row{% else %}column{% endif %};
    --icon-align: {% if s.layout == 'horizontal' %}flex-start{% else %}{{ align }}{% endif %};
    --icon-text-align: {% if s.layout == 'horizontal' %}start{% else %}{{ s.alignment }}{% endif %};
    --icon-frame-size: {{ s.frame_size | divided_by: 16.0 }}rem;
    {%- if s.use_custom_color %}--icon-color: {{ s.icon_color }};{% endif -%}
  "
  {% render 'animation-attributes', animation: s.animation, delay: s.animation_delay %}
  {{ block.shopify_attributes }}
>
  <div class="icon-text__media">
    {%- if s.image != blank -%}
      {% render 'image', image: s.image, sizes: '96px', max_width: 240, alt: '' %}
    {%- elsif s.icon != 'none' -%}
      {% render 'icon', name: s.icon %}
    {%- endif -%}
  </div>

  <div class="icon-text__body">
    {%- if s.title != blank -%}
      <h3 class="{{ title_class }}">
        {%- if s.link != blank -%}
          <a href="{{ s.link }}">{{ s.title | escape }}</a>
        {%- else -%}
          {{ s.title | escape }}
        {%- endif -%}
      </h3>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="icon-text__text rte{% if s.text_style == 'subheading' %} type-subheading{% endif %}">{{ s.text }}</div>
    {%- endif -%}
  </div>
</div>

