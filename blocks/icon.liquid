{% doc %}
  Icon block: an icon from the theme set or an uploaded image.

  @example
  {% content_for 'block', type: 'icon', id: 'icon' %}
{% enddoc %}

<div
  class="icon-block spacing-style"
  style="{%- render 'spacing-style', settings: block.settings -%} --icon-size: {{ block.settings.size }}px; {% if block.settings.use_custom_color %}color: {{ block.settings.color }};{% endif %}"
  {% render 'animation-attributes', animation: block.settings.animation, delay: block.settings.animation_delay %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image != blank -%}
    {{ block.settings.image | image_url: width: 160 | image_tag: width: block.settings.size, height: block.settings.size, alt: '', loading: 'lazy', class: 'icon' }}
  {%- else -%}
    {% render 'icon', name: block.settings.icon %}
  {%- endif -%}
</div>

