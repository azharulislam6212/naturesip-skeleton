{% doc %}
  Icon block: an icon from the theme set or an uploaded image. Size: the
  theme default (Theme settings > Icons), small, medium, large or custom.

  @example
  {% content_for 'block', type: 'icon', id: 'icon' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign preset = s.size_preset | default: 'theme'
  if preset == 'theme'
    assign preset = settings.icon_size | default: 'medium'
    assign custom_px = settings.icon_size_custom
  else
    assign custom_px = s.size
  endif

  # Pixel sizes of the scale; keep in step with snippets/theme-styles.liquid.
  case preset
    when 'small'
      assign size_px = 28
    when 'large'
      assign size_px = 64
    when 'custom'
      assign size_px = custom_px
    else
      assign size_px = 40
  endcase
  assign size_css = size_px | divided_by: 16.0 | append: 'rem'
-%}

<div
  class="icon-block spacing-style"
  style="{%- render 'spacing-style', settings: s -%} --icon-size: {{ size_css }}; {% if s.use_custom_color %}color: {{ s.color }};{% endif %}"
  {% render 'animation-attributes', animation: s.animation, delay: s.animation_delay %}
  {{ block.shopify_attributes }}
>
  {%- if s.image != blank -%}
    {{ s.image | image_url: width: 320 | image_tag: width: size_px, height: size_px, alt: '', loading: 'lazy', class: 'icon' }}
  {%- else -%}
    {% render 'icon', name: s.icon %}
  {%- endif -%}
</div>

