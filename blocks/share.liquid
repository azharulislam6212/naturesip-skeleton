{% doc %}
  Share block: social share links for the product or article it sits in
  (falls back to the current page). Networks are chosen in
  Theme settings > Social sharing.

  @example
  {% content_for 'block', type: 'share', id: 'share' %}
{% enddoc %}

{%- liquid
  if closest.product != blank
    assign share_path = closest.product.url
    assign share_title = closest.product.title
    assign share_image = closest.product.featured_image
  elsif closest.article != blank
    assign share_path = closest.article.url
    assign share_title = closest.article.title
    assign share_image = closest.article.image
  else
    assign share_path = request.path
    assign share_title = page_title
    assign share_image = blank
  endif
  assign share_url = request.origin | append: share_path
-%}

<div class="share-block" {{ block.shopify_attributes }}>
  {% render 'share-buttons', url: share_url, title: share_title, image: share_image, label: block.settings.label %}
</div>

{% stylesheet %}
@layer components {
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .share-buttons__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  share-copy {
    display: contents;
  }

  share-copy[data-copied] .icon-button {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.share.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:defaults.share_label"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.share.name",
      "category": "t:categories.blocks.actions"
    }
  ]
}
{% endschema %}
