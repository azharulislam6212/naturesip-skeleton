{% doc %}
  Social links block: the social profiles set in theme settings.

  @example
  {% content_for 'block', type: 'social-links', id: 'social' %}
{% enddoc %}

<div class="social-block spacing-style" style="{%- render 'spacing-style', settings: block.settings -%}" {{ block.shopify_attributes }}>
  {% render 'social-links' %}
</div>

{% stylesheet %}
@layer components {
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid currentColor;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.social_links.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.social_links.name",
      "category": "t:categories.blocks.actions"
    }
  ]
}
{% endschema %}
