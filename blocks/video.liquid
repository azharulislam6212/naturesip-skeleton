{% doc %}
  Video block: a Shopify-hosted video or a YouTube/Vimeo link. External
  players load only when the visitor presses play.

  @example
  {% content_for 'block', type: 'video', id: 'video' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  case s.ratio
    when 'square'
      assign ratio = '1'
    when 'portrait'
      assign ratio = '0.5625'
    else
      assign ratio = '1.7778'
  endcase
-%}

<div
  class="video-block spacing-style block-width-fill"
  style="{%- render 'spacing-style', settings: s -%}"
  {% render 'animation-attributes', animation: s.animation, delay: s.animation_delay %}
  {{ block.shopify_attributes }}
>
  {%- if s.video != blank -%}
    <div class="media" style="--ratio: {{ ratio }}; --media-radius: {{ s.radius }}px;">
      {%- if s.autoplay -%}
        {{ s.video | video_tag: autoplay: true, muted: true, loop: s.loop, playsinline: true, controls: s.controls, image_size: '1600x', preload: 'none' }}
      {%- else -%}
        {{ s.video | video_tag: controls: true, loop: s.loop, playsinline: true, image_size: '1600x', preload: 'none' }}
      {%- endif -%}
    </div>
  {%- elsif s.video_url != blank -%}
    <deferred-media class="media deferred-media" style="--ratio: {{ ratio }}; --media-radius: {{ s.radius }}px;">
      {%- if s.cover_image != blank -%}
        {% render 'image', image: s.cover_image, alt: '', sizes: '(min-width: 990px) 70vw, 100vw' %}
      {%- endif -%}
      <button class="deferred-media__button" type="button" data-load>
        <span class="deferred-media__icon">{% render 'icon', name: 'play' %}</span>
        {%- assign play_label = 'accessibility.play_video' | t -%}
        <span class="visually-hidden">{{ s.description | default: play_label | escape }}</span>
      </button>
      <template>
        {%- if s.video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube-nocookie.com/embed/{{ s.video_url.id }}?autoplay=1&rel=0&playsinline=1"
            title="{{ s.description | escape }}"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- else -%}
          <iframe
            src="https://player.vimeo.com/video/{{ s.video_url.id }}?autoplay=1&dnt=1"
            title="{{ s.description | escape }}"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      </template>
    </deferred-media>
  {%- else -%}
    <div class="media" style="--ratio: {{ ratio }};">{{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.video.name",
  "tag": null,
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:settings.video_url",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:settings.cover_image"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:settings.video_description"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "wide",
          "label": "t:options.ratio.wide"
        },
        {
          "value": "square",
          "label": "t:options.ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.ratio.portrait"
        }
      ],
      "default": "wide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:settings.loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "t:settings.controls",
      "default": true
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:settings.padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:settings.padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:headers.animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:settings.animation",
      "options": [
        {
          "value": "theme",
          "label": "t:options.animation.theme"
        },
        {
          "value": "none",
          "label": "t:options.animation.none"
        },
        {
          "value": "fade",
          "label": "t:options.animation.fade"
        },
        {
          "value": "rise",
          "label": "t:options.animation.rise"
        },
        {
          "value": "zoom",
          "label": "t:options.animation.zoom"
        },
        {
          "value": "slide-start",
          "label": "t:options.animation.slide_start"
        },
        {
          "value": "slide-end",
          "label": "t:options.animation.slide_end"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:settings.animation_delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.video.name",
      "category": "t:categories.blocks.media"
    }
  ]
}
{% endschema %}
