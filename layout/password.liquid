<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'text-direction' %}">
  <head>
    <style>
      @layer reset, tokens, base, layout, components, utilities;
    </style>

    {% render 'meta-tags' %}
    {% render 'scripts', context: 'password' %}
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.body_color_scheme.id }} template-password">
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    <p class="visually-hidden" id="LiveRegion" role="status" aria-live="polite"></p>
  </body>
</html>
