<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  data-button-hover="{{ settings.button_hover_effect }}"
  data-image-hover="{{ settings.image_hover }}"
  {% if settings.page_transition != 'none' %}
    data-page-transition="{{ settings.page_transition }}"
  {% endif %}
>
  <head>
    <style>
      @layer reset, tokens, base, layout, components, utilities;
    </style>

    {% render 'meta-tags' %}
    {% render 'scripts' %}

    {%- unless settings.type_body_font.system? and settings.type_accent_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}
    {%- unless settings.type_accent_font.system? -%}
      {{ settings.type_accent_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless %}

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- if settings.page_transition != 'none' -%}
      <style>
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      </style>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.body_color_scheme.id }} template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% sections 'overlay-group' %}

    <p class="visually-hidden" id="LiveRegion" role="status" aria-live="polite"></p>
  </body>
</html>
