<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{% render 'text-direction' %}"
>
  <head>
    
    <style>
      @layer reset, tokens, base, layout, components, sections, utilities;
    </style>



    {% render 'meta-tags' %}
    {% render 'scripts' %}
    {% render 'font' %}
    {% render 'theme-styles' %}
    {% render 'stylesheets' %}

    {%- comment -%}
      Hold the first paint until the end of <body> is parsed. Otherwise the
      browser paints the top of the page while the rest is still arriving, and
      on reload shows the hero first, then jumps back to where you were (e.g. the
      footer). Once the whole page is parsed it can restore straight away.
      No JavaScript; browsers without support ignore it.
    {%- endcomment -%}
    <link rel="expect" href="#LiveRegion" blocking="render">

    {{ content_for_header }}
  </head>

  <body class="gradient template-{{ template.name }}">
    {% render 'page-transition' %}
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% sections 'overlay-group' %}
    {% render 'scroll-to-top' %}

    <p class="visually-hidden" id="LiveRegion" role="status" aria-live="polite"></p>
  </body>
</html>
