<!doctype html>
<html
  class="no-js{% if settings.animations_reveal %} animations-on{% endif %}"
  lang="{{ request.locale.iso_code }}"
  dir="{% render 'text-direction' %}"
>
  <head>
    <style>
      @layer reset, tokens, base, layout, components, sections, utilities;
    </style>

    {% render 'meta-tags' %}
    {% render 'scripts' %}
    {% render 'font' %}
    {% render 'theme-styles' %}
    {% render 'stylesheets' %}
    {% render 'scroll-restore' %}

    {{ content_for_header }}
  </head>

  <body class="gradient template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% sections 'overlay-group' %}
    {% render 'scroll-to-top' %}

    <p class="visually-hidden" id="LiveRegion" role="status" aria-live="polite"></p>
  </body>
</html>
