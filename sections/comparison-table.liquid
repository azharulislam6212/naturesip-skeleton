{%- comment -%}
  Comparison table: your brand against "others", one row per block.
  A real <table> with header cells, so screen readers announce each cell.
{%- endcomment -%}

{%- assign s = section.settings -%}
<section
  class="section section-surface comparison color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%}"
  {% render 'shape-attributes', settings: s %}
>
  {% render 'background', settings: s %}

  <div class="layout-stack" style="--gap: var(--space-2xl);">
    {% content_for 'block', type: 'section-heading', id: 'heading' %}
    <div class="comparison__card color-{{ s.table_color_scheme.id }}" {% render 'animation-attributes' %}>
      <table class="comparison__table">
        <caption class="visually-hidden">{{ s.caption | escape }}</caption>
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="comparison__us">
              {%- if s.logo != blank -%}
                {{ s.logo | image_url: width: 320 | image_tag: alt: s.us_label, width: s.logo_width, loading: 'lazy', class: 'comparison__logo' }}
              {%- else -%}
                {{ s.us_label | escape }}
              {%- endif -%}
            </th>
            <th scope="col" class="comparison__them">{{ s.them_label | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {% content_for 'blocks' %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.comparison.name",
  "class": "section-wrapper",
  "max_blocks": 15,
  "blocks": [
    {
      "type": "_comparison-row"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "us_label",
      "label": "t:settings.us_label",
      "default": "t:defaults.us_label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:settings.us_logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:settings.logo_width",
      "min": 60,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "text",
      "id": "them_label",
      "label": "t:settings.them_label",
      "default": "t:defaults.them_label"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:settings.table_caption",
      "default": "t:defaults.table_caption"
    },
    {
      "type": "color_scheme",
      "id": "table_color_scheme",
      "label": "t:settings.table_color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "t:settings.background_image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "shape_top",
      "label": "t:settings.shape_top",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_bottom",
      "label": "t:settings.shape_bottom",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_size",
      "label": "t:settings.shape_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.shape_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.shape_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.shape_size.large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.shape_top != 'none' or section.settings.shape_bottom != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.comparison.name",
      "category": "t:categories.sections.storytelling",
      "blocks": {
        "heading": {
          "type": "section-heading",
          "static": true,
          "settings": {
            "alignment": "center"
          },
          "blocks": {
            "heading": {
              "type": "heading",
              "settings": {
                "heading": "t:defaults.comparison_heading",
                "type_preset": "display_m",
                "text_color": "gradient",
                "stroke": true,
                "shadow": true,
                "alignment": "center",
                "alignment_mobile": "center"
              }
            },
            "text": {
              "type": "text",
              "settings": {
                "text": "",
                "type_preset": "subheading",
                "alignment": "center",
                "alignment_mobile": "center",
                "max_width_preset": "large"
              }
            }
          },
          "block_order": [
            "heading",
            "text"
          ]
        },
        "row_1": {
          "type": "_comparison-row"
        },
        "row_2": {
          "type": "_comparison-row"
        },
        "row_3": {
          "type": "_comparison-row"
        },
        "row_4": {
          "type": "_comparison-row"
        }
      },
      "block_order": [
        "row_1",
        "row_2",
        "row_3",
        "row_4"
      ]
    }
  ]
}
{% endschema %}
