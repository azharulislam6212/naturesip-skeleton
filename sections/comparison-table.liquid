{%- comment -%}
  Comparison table: a heading group, then a card (static `_comparison-card`
  block) holding the comparison: your brand against "others", one
  `_comparison-row` block per feature. App blocks render under the card.
{%- endcomment -%}

{{ 'section-comparison-table.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section section-surface comparison color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%}"
  {% render 'shape-attributes', settings: s %}
>
  {% render 'background', settings: s %}

  <div class="layout-stack" style="--gap: var(--space-2xl);">
    {% content_for 'block', type: 'section-heading', id: 'heading' %}
    {% content_for 'block', type: '_comparison-card', id: 'card' %}
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.comparison.name",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "t:settings.background_image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "shape_top",
      "label": "t:settings.shape_top",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_bottom",
      "label": "t:settings.shape_bottom",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_size",
      "label": "t:settings.shape_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.shape_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.shape_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.shape_size.large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.shape_top != 'none' or section.settings.shape_bottom != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_width.header"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.all.section_width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.section_width.options__2.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.section_width.options__3.label"
        },
        {
          "value": "standard",
          "label": "t:sections.all.section_width.options__4.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.section_width.options__5.label"
        },
        {
          "value": "custom",
          "label": "t:sections.all.section_width.options__6.label"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.section_width == 'custom' }}",
      "type": "range",
      "id": "section_custom_width",
      "label": "t:sections.all.section_width.custom.label",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.comparison.name",
      "category": "t:categories.sections.storytelling",
      "blocks": {
        "heading": {
          "type": "section-heading",
          "static": true,
          "settings": {
            "alignment": "center"
          },
          "blocks": {
            "heading": {
              "type": "heading",
              "settings": {
                "heading": "t:defaults.comparison_heading",
                "type_preset": "display_m",
                "text_color": "gradient",
                "stroke": true,
                "shadow": true,
                "alignment": "center",
                "alignment_mobile": "center"
              }
            },
            "text": {
              "type": "text",
              "settings": {
                "text": "",
                "type_preset": "default",
                "alignment": "center",
                "alignment_mobile": "center",
                "max_width_preset": "large"
              }
            }
          },
          "block_order": [
            "heading",
            "text"
          ]
        },
        "card": {
          "type": "_comparison-card",
          "static": true,
          "settings": {
            "background_gradient": "linear-gradient(110deg, rgba(251, 199, 228, 1), rgba(251, 153, 207, 1) 100%)",
            "us_gradient": "linear-gradient(270deg, rgba(100, 13, 95, 1), rgba(103, 25, 111, 1) 46%, rgba(105, 36, 124, 1) 100%)"
          },
          "blocks": {
            "row_1": {
              "type": "_comparison-row",
              "settings": {
                "label": "Probiotic-rich digestive support"
              }
            },
            "row_2": {
              "type": "_comparison-row",
              "settings": {
                "label": "Antioxidant properties"
              }
            },
            "row_3": {
              "type": "_comparison-row",
              "settings": {
                "label": "Lower caffeine content"
              }
            },
            "row_4": {
              "type": "_comparison-row",
              "settings": {
                "label": "No artificial additives"
              }
            },
            "row_5": {
              "type": "_comparison-row",
              "settings": {
                "label": "Clean label ingredients"
              }
            }
          },
          "block_order": [
            "row_1",
            "row_2",
            "row_3",
            "row_4",
            "row_5"
          ]
        }
      }
    }
  ]
}
{% endschema %}
