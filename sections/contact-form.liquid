{%- comment -%} Contact form. {%- endcomment -%}

{{ 'section-content.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="section section-surface color-{{ s.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: s -%}">
  <div class="section-surface__background" aria-hidden="true"></div>
  <div class="contact">
    <div class="section-heading layout-stack" style="--align: center; --gap: 12px;">
      {% content_for 'blocks' %}
    </div>
    {%- assign form_id = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: form_id, class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
          <p>{{ 'contact.error_heading' | t }}</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="contact__row">
        <div class="field">
          <label class="field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
          <input class="input" id="{{ form_id }}-name" type="text" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="field">
          <label class="field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="input" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" value="{{ form.email }}" required aria-required="true" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
        <input class="input" id="{{ form_id }}-phone" type="tel" name="contact[{{ 'contact.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="field">
        <label class="field__label" for="{{ form_id }}-message">{{ 'contact.message' | t }}</label>
        <textarea class="textarea" id="{{ form_id }}-message" name="contact[body]">{{ form.body }}</textarea>
      </div>
      {%- assign send_label = 'contact.send' | t -%}
      {% render 'button', label: send_label, type: 'submit', icon: 'plane' %}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.name",
      "category": "t:categories.forms",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "t:defaults.contact_heading",
            "type_preset": "display_m",
            "text_color": "gradient",
            "stroke": true,
            "shadow": true,
            "alignment": "center",
            "alignment_mobile": "center"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "t:defaults.contact_text",
            "type_preset": "subheading",
            "alignment": "center",
            "alignment_mobile": "center",
            "max_width": 70
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ]
    }
  ]
}
{% endschema %}
