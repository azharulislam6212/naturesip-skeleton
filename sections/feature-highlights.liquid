{%- comment -%}
  Featured highlights: a heading group, then a central image (a hand holding
  the can) between two columns of highlight blocks (icon block, title and
  text), set in a zigzag. A hatched wave runs across the full width behind
  it, its hatching flowing along the wave in an endless loop.
  The highlights animate in one after another.
{%- endcomment -%}

{{ 'section-feature-highlights.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign rows = section.blocks.size | plus: 1 | divided_by: 2 | at_least: 1
-%}

<section
  class="section section-surface feature-highlights color-{{ s.color_scheme.id }} spacing-style{% if s.image_bleed %} feature-highlights--bleed{% endif %}{% if s.zigzag %} feature-highlights--zigzag{% endif %}{% if s.uppercase %} feature-highlights--uppercase{% endif %}"
  style="
    {%- render 'spacing-style', settings: s -%}
    --highlight-rows: {{ rows }};
    --highlight-offset: {{ s.zigzag_offset | divided_by: 16.0 }}rem;
    --highlight-image-width: {{ s.image_width | divided_by: 16.0 }}rem;
    --fh-padding-bottom: {{ s.padding_bottom }}px;
    --fh-padding-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --wave-opacity: {{ s.wave_opacity | divided_by: 100.0 }};
    --wave-duration: {{ s.wave_speed }}s;
  "
  {% render 'shape-attributes', settings: s %}
>
  {% render 'background', settings: s %}

  {%- if s.show_waves -%}
    <div class="feature-highlights__waves full-width" aria-hidden="true" style="--wave-top: {{ s.wave_position }}%;">
      <svg class="feature-highlights__waves-art" viewBox="0 0 1440 530" preserveAspectRatio="none" focusable="false">
        <defs>
          <linearGradient id="HighlightsWave-{{ section.id }}" x1="730.421" y1="174.064" x2="714.292" y2="282.875" gradientUnits="userSpaceOnUse">
            <stop style="stop-color: var(--wave-start, #fac67a)"/>
            <stop offset="1" style="stop-color: var(--wave-end, #fe8a80)"/>
          </linearGradient>
        </defs>
        <g class="feature-highlights__waves-motion" fill="none" stroke="url(#HighlightsWave-{{ section.id }})" stroke-width="200">
          <path class="feature-highlights__band" d="M-184.128 149.699L-63.7612 111.94C12.2581 88.0933 95.0112 100.36 160.844 145.234C226.676 190.108 309.429 202.375 385.449 178.528C461.468 154.681 544.221 166.948 610.054 211.822C675.886 256.696 758.639 268.963 834.659 245.116C910.678 221.269 993.431 233.536 1059.26 278.41C1125.1 323.284 1207.85 335.551 1283.87 311.704C1359.89 287.857 1442.64 300.124 1508.47 344.998L1612.71 416.05"/>
          <path class="feature-highlights__hatch" d="M-184.128 149.699L-63.7612 111.94C12.2581 88.0933 95.0112 100.36 160.844 145.234C226.676 190.108 309.429 202.375 385.449 178.528C461.468 154.681 544.221 166.948 610.054 211.822C675.886 256.696 758.639 268.963 834.659 245.116C910.678 221.269 993.431 233.536 1059.26 278.41C1125.1 323.284 1207.85 335.551 1283.87 311.704C1359.89 287.857 1442.64 300.124 1508.47 344.998L1612.71 416.05" transform="translate(-4.547 30.665)"/>
        </g>
      </svg>
    </div>
  {%- endif -%}

  <div class="feature-highlights__inner layout-stack" style="--gap: var(--space-2xl);">
    {% content_for 'block', type: 'section-heading', id: 'heading' %}
    <div class="feature-highlights__grid" {% render 'animation-attributes', animation: 'none', stagger: true %}>
      <div class="feature-highlights__image" {% render 'animation-attributes', image: true %}>
        {% render 'image', image: s.image, alt: s.image.alt, sizes: '(min-width: 990px) 36vw, 80vw', placeholder: 'product-apparel-2' %}
      </div>
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.feature_highlights.name",
  "class": "section-wrapper",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "_highlight"
