    {
      "type": "header",
      "content": "t:headers.layout"
    },
    {
      "type": "checkbox",
      "id": "zigzag",
      "label": "t:settings.zigzag",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.zigzag }}",
      "type": "range",
      "id": "zigzag_offset",
      "label": "t:settings.zigzag_offset",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "t:settings.uppercase_highlights",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.waves"
    },
    {
      "type": "checkbox",
      "id": "show_waves",
      "label": "t:settings.show_waves",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.show_waves }}",
      "type": "range",
      "id": "wave_position",
      "label": "t:settings.wave_position",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 29
    },
    {
      "visible_if": "{{ section.settings.show_waves }}",
      "type": "range",
      "id": "wave_opacity",
      "label": "t:settings.wave_opacity",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "visible_if": "{{ section.settings.show_waves }}",
      "type": "range",
      "id": "wave_speed",
      "label": "t:settings.wave_speed",
      "info": "t:settings.wave_speed_info",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "t:settings.background_image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "shape_top",
      "label": "t:settings.shape_top",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
