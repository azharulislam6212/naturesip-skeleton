{%- comment -%}
  Featured collection: section heading, then products as a grid or a
  carousel (optionally a carousel on mobile only).
{%- endcomment -%}

{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign products = s.collection.products
  assign column_style = '--columns-desktop: ' | append: s.columns_desktop | append: '; --columns-tablet: ' | append: s.columns_tablet | append: '; --columns-mobile: ' | append: s.columns_mobile | append: ';'
-%}

<section
  class="section section-surface featured-collection color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%}"
  {% render 'shape-attributes', settings: s %}
>
  {% render 'background', settings: s %}

  <div class="layout-stack" style="--gap: var(--space-xl);">
    {% content_for 'block', type: 'section-heading', id: 'heading' %}

    {%- if s.layout == 'carousel' or s.carousel_on_mobile -%}
      {%- assign mobile_only = false -%}
      {%- if s.layout == 'grid' -%}{%- assign mobile_only = true -%}{%- endif -%}
      <slider-component
        class="featured-collection__slider product-grid--mobile-{{ s.columns_mobile }}"
        style="{{ column_style }} --slide-width-mobile: {{ 100 | divided_by: s.columns_mobile | minus: 8 }}%;"
        aria-roledescription="{{ 'accessibility.carousel' | t }}"
        {% render 'carousel-attributes', settings: s, mobile_only: mobile_only %}
      >
        <ul class="slider__track" ref="track" role="list" {% render 'animation-attributes', animation: 'none', stagger: true %}>
          {%- for product in products limit: s.limit -%}
            <li class="slider__slide">{% render 'product-card', product: product, section_id: section.id %}</li>
          {%- else -%}
            {%- for i in (1..4) -%}
              <li class="slider__slide">{% render 'product-card', section_id: section.id %}</li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
        {%- liquid
          assign slide_count = products.size | at_most: s.limit
          if slide_count == 0
            assign slide_count = 4
          endif
        -%}
        {% render 'carousel-controls', settings: s, slides: slide_count %}
      </slider-component>
    {%- else -%}
      <ul class="grid product-grid product-grid--mobile-{{ s.columns_mobile }}" role="list" style="{{ column_style }}" {% render 'animation-attributes', stagger: true %}>
        {%- for product in products limit: s.limit -%}
          <li>{% render 'product-card', product: product, section_id: section.id %}</li>
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>{% render 'product-card', section_id: section.id %}</li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.view_all and s.collection != blank -%}
      <div class="featured-collection__footer">
        {%- assign view_all_label = 'sections.featured_collection.view_all' | t -%}
        {% render 'button', label: view_all_label, url: s.collection.url, variant: s.view_all_style, icon: 'arrow' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:settings.product_limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:headers.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "carousel",
          "label": "t:options.list_layout.carousel"
        },
        {
          "value": "grid",
          "label": "t:options.list_layout.grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:carousel.on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:settings.columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.columns.one"
        },
        {
          "value": "2",
          "label": "t:options.columns.two"
        }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "t:settings.view_all",
      "default": true
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "t:settings.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:options.button_style.primary"
        },
        {
          "value": "secondary",
          "label": "t:options.button_style.secondary"
        },
        {
          "value": "link",
          "label": "t:options.button_style.link"
        }
      ],
      "default": "secondary",
      "visible_if": "{{ section.settings.view_all }}"
    },
    {
      "type": "header",
      "content": "t:carousel.headers.carousel",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_loop",
      "label": "t:carousel.loop",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:carousel.autoplay",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "range",
      "id": "carousel_autoplay_delay",
      "label": "t:carousel.autoplay_delay",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.carousel_autoplay and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:carousel.headers.navigation",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_navigation",
      "label": "t:carousel.navigation",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_icon",
      "label": "t:carousel.nav_icon.label",
      "options": [
        {
          "value": "curved",
          "label": "t:carousel.nav_icon.curved"
        },
        {
          "value": "arrow",
          "label": "t:carousel.nav_icon.arrow"
        },
        {
          "value": "chevron",
          "label": "t:carousel.nav_icon.chevron"
        },
        {
          "value": "arrow-large",
          "label": "t:carousel.nav_icon.arrow_large"
        },
        {
          "value": "chevron-large",
          "label": "t:carousel.nav_icon.chevron_large"
        },
        {
          "value": "none",
          "label": "t:carousel.nav_icon.none"
        }
      ],
      "default": "curved",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_shape",
      "label": "t:carousel.nav_shape.label",
      "options": [
        {
          "value": "none",
          "label": "t:carousel.nav_shape.none"
        },
        {
          "value": "circle",
          "label": "t:carousel.nav_shape.circle"
        },
        {
          "value": "square",
          "label": "t:carousel.nav_shape.square"
        }
      ],
      "default": "circle",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_nav_border_style",
      "label": "t:carousel.nav_border_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:carousel.nav_border_style.solid"
        },
        {
          "value": "dashed",
          "label": "t:carousel.nav_border_style.dashed"
        },
        {
          "value": "none",
          "label": "t:carousel.nav_border_style.none"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.carousel_nav_shape != 'none' and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_style",
      "label": "t:carousel.controls_style.label",
      "options": [
        {
          "value": "split",
          "label": "t:carousel.controls_style.split"
        },
        {
          "value": "ghost",
          "label": "t:carousel.controls_style.ghost"
        },
        {
          "value": "solid",
          "label": "t:carousel.controls_style.solid"
        }
      ],
      "default": "ghost",
      "visible_if": "{{ section.settings.carousel_navigation and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:carousel.headers.pagination",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "t:carousel.pagination.label",
      "options": [
        {
          "value": "none",
          "label": "t:carousel.pagination.none"
        },
        {
          "value": "dots",
          "label": "t:carousel.pagination.dots"
        },
        {
          "value": "numbers",
          "label": "t:carousel.pagination.numbers"
        },
        {
          "value": "progress",
          "label": "t:carousel.pagination.progress"
        },
        {
          "value": "controls",
          "label": "t:carousel.pagination.controls"
        }
      ],
      "default": "controls",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination_align",
      "label": "t:carousel.pagination_align.label",
      "options": [
        {
          "value": "start",
          "label": "t:carousel.pagination_align.start"
        },
        {
          "value": "center",
          "label": "t:carousel.pagination_align.center"
        },
        {
          "value": "end",
          "label": "t:carousel.pagination_align.end"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:carousel.headers.controls",
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_inherit_scheme",
      "label": "t:carousel.inherit_scheme",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "color_scheme",
      "id": "carousel_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.carousel_inherit_scheme == false and section.settings.layout == 'carousel' or section.settings.carousel_on_mobile }}"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "t:settings.background_image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "shape_top",
      "label": "t:settings.shape_top",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_bottom",
      "label": "t:settings.shape_bottom",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_size",
      "label": "t:settings.shape_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.shape_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.shape_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.shape_size.large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.shape_top != 'none' or section.settings.shape_bottom != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_width.header"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.all.section_width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.section_width.options__2.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.section_width.options__3.label"
        },
        {
          "value": "standard",
          "label": "t:sections.all.section_width.options__4.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.section_width.options__5.label"
        },
        {
          "value": "custom",
          "label": "t:sections.all.section_width.options__6.label"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.section_width == 'custom' }}",
      "type": "range",
      "id": "section_custom_width",
      "label": "t:sections.all.section_width.custom.label",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name",
      "category": "t:categories.sections.collections",
      "blocks": {
        "heading": {
          "type": "section-heading",
          "static": true,
          "settings": {
            "alignment": "center"
          },
          "blocks": {
            "heading": {
              "type": "heading",
              "settings": {
                "heading": "t:defaults.collection_heading",
                "type_preset": "display_m",
                "text_color": "gradient",
                "stroke": true,
                "shadow": true,
                "alignment": "center",
                "alignment_mobile": "center"
              }
            },
            "text": {
              "type": "text",
              "settings": {
                "text": "t:defaults.section_text",
                "type_preset": "paragraph",
                "alignment": "center",
                "alignment_mobile": "center",
                "max_width_preset": "large"
              }
            }
          },
          "block_order": [
            "heading",
            "text"
          ]
        }
      }
    }
  ]
}
{% endschema %}
