{%- comment -%}
  Featured steps: a heading group, then a row of steps (icon, heading and
  text blocks) joined by hand-drawn arrows, with an optional stagger.
{%- endcomment -%}

{{ 'section-featured-steps.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section section-surface featured-steps color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%} --steps-columns: {{ s.columns }};"
  {% render 'shape-attributes', settings: s %}
  {% if s.stagger %}
    data-stagger
  {% endif %}
  {% if s.connectors %}
    data-connectors
  {% endif %}
>
  {% render 'background', settings: s %}

  {%- if s.decor_start != blank -%}
    {% render 'image', image: s.decor_start, alt: '', sizes: '120px', max_width: 360, class: 'featured-steps__decor featured-steps__decor--start' %}
  {%- endif -%}
  {%- if s.decor_end != blank -%}
    {% render 'image', image: s.decor_end, alt: '', sizes: '120px', max_width: 360, class: 'featured-steps__decor featured-steps__decor--end' %}
  {%- endif -%}

  <div class="featured-steps__inner">
    {% content_for 'block', type: 'section-heading', id: 'heading' %}
    <div class="featured-steps__list" {% render 'animation-attributes', animation: 'none', stagger: true %}>
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

