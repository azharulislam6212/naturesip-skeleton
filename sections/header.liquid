{%- comment -%}
  Header: logo, main menu (dropdowns, mega menus and "More" on desktop, a
  drawer on mobile), search, account, cart and optional country/language
  selectors. It can sit transparent over the first section, per page type,
  and turns solid once the page scrolls.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign menu = s.menu
  assign cart_opener = ''
  if settings.cart_type == 'drawer'
    assign cart_opener = 'data-dialog-open="CartDrawer" aria-haspopup="dialog"'
  endif

  assign transparent = false
  if s.transparent_header
    case request.page_type
      when 'index'
        assign transparent = s.transparent_home
      when 'collection'
        assign transparent = s.transparent_collection
      when 'product'
        assign transparent = s.transparent_product
      when 'list-collections'
        assign transparent = s.transparent_list_collections
      else
        assign transparent = s.transparent_other
    endcase
  endif

  # Drawer menu: the toggle shows on desktop too, before the logo.
  assign drawer_menu = false
  if s.menu_type == 'drawer'
    assign drawer_menu = true
  endif

  assign scheme_class = 'color-' | append: s.color_scheme.id
  assign transparent_class = 'color-' | append: s.transparent_color_scheme.id
-%}

<header-component
  class="header-wrapper {% if transparent %}{{ transparent_class }}{% else %}{{ scheme_class }}{% endif %}{% if s.border %} header-wrapper--border{% endif %}"
  data-sticky="{{ s.sticky }}"
  {% if transparent %}
    data-transparent
    data-scheme="{{ scheme_class }}"
    data-transparent-scheme="{{ transparent_class }}"
  {% endif %}
>
  <header
    class="header header--{{ s.layout }}{% if drawer_menu %} header--drawer{% endif %}{% if s.menu_divider %} header--divider{% endif %} page-width"
    style="--logo-width: {{ s.logo_width }}px; --logo-width-mobile: {{ s.logo_width_mobile }}px; --header-padding: {{ s.padding | divided_by: 16.0 }}rem;"
  >
    <header-drawer class="header__drawer{% unless drawer_menu %} hide-desktop{% endunless %}">
      <button class="icon-button header__icon" type="button" ref="trigger" aria-haspopup="dialog" aria-expanded="false">
        {%- render 'icon', name: 'menu' -%}
        <span class="visually-hidden">{{ 'header.menu' | t }}</span>
      </button>
      <dialog class="drawer drawer--start color-{{ s.drawer_color_scheme.id }}" ref="dialog" aria-label="{{ 'header.menu' | t }}" data-lenis-prevent>
        <div class="drawer__inner">
          <div class="drawer__header">
            <span class="type-h5">{{ shop.name | escape }}</span>
            <button class="icon-button" type="button" ref="close">
              {%- render 'icon', name: 'close' -%}
              <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
            </button>
          </div>
          <nav class="drawer__body mobile-nav" aria-label="{{ 'header.menu' | t }}">
            <ul class="mobile-nav__list" role="list">
              {%- for link in menu.links -%}
                <li>
                  {%- if link.links.size > 0 -%}
                    <details class="accordion mobile-nav__details">
                      <summary class="accordion__summary mobile-nav__link">
                        {{ link.title | escape }}
                        <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
                      </summary>
                      <ul class="mobile-nav__sublist" role="list">
                        <li><a class="mobile-nav__sublink" href="{{ link.url }}">{%- assign escaped_value = link.title | escape -%}{{ 'header.view_all' | t: title: escaped_value }}</a></li>
                        {%- for child in link.links -%}
                          <li>
                            <a class="mobile-nav__sublink" href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="mobile-nav__sublist" role="list">
                                {%- for grandchild in child.links -%}
                                  <li><a class="mobile-nav__sublink" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {%- else -%}
                    <a class="mobile-nav__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- if shop.customer_accounts_enabled -%}
              <a class="mobile-nav__account" href="{{ routes.account_url }}">
                {%- render 'icon', name: 'account' -%}
                {%- if customer -%}{{ 'header.account' | t }}{%- else -%}{{ 'header.log_in' | t }}{%- endif -%}
              </a>
            {%- endif -%}
            {% render 'localization-form', id: 'HeaderDrawerLocalization', show_country: s.show_country, show_language: s.show_language %}
          </nav>
        </div>
      </dialog>
    </header-drawer>

    {%- capture logo -%}
      <a class="header__logo" href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          {%- assign logo_width_2x = s.logo_width | times: 2 -%}
          {{
            settings.logo
            | image_url: width: logo_width_2x
            | image_tag: alt: shop.name, width: s.logo_width, loading: 'eager', fetchpriority: 'high', class: 'header__logo-image', widths: '120, 180, 240, 360, 480'
          }}
          {%- if transparent and s.transparent_logo != blank -%}
            {{
              s.transparent_logo
              | image_url: width: logo_width_2x
              | image_tag: alt: shop.name, width: s.logo_width, loading: 'eager', class: 'header__logo-image header__logo-image--transparent', widths: '120, 180, 240, 360, 480'
            }}
          {%- endif -%}
        {%- else -%}
          <span class="header__logo-text">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>
    {%- endcapture -%}
    {%- if request.page_type == 'index' -%}
      <h1 class="header__heading">{{ logo }}</h1>
    {%- else -%}
      <div class="header__heading">{{ logo }}</div>
    {%- endif -%}

    {%- comment -%} Menu below the logo: search moves to the start of the top row (desktop). {%- endcomment -%}
    {%- if s.show_search and s.layout == 'logo-top' and drawer_menu == false -%}
      <a class="icon-button header__icon header__search header__search--start hide-mobile" href="{{ routes.search_url }}" data-dialog-open="SearchModal" aria-haspopup="dialog">
        {%- render 'icon', name: 'search' -%}
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>
    {%- endif -%}

    {%- if menu.links.size > 0 and drawer_menu == false -%}
      {% render 'header-menu', menu: menu, section: section %}
    {%- endif -%}

    <div class="header__icons">
      {%- if s.show_localization_desktop -%}
        <div class="header__localization hide-mobile">
          {% render 'localization-form', id: 'HeaderLocalization', show_country: s.show_country, show_language: s.show_language, inline: true %}
        </div>
      {%- endif -%}

      {%- if s.show_search -%}
        <a class="icon-button header__icon header__search" href="{{ routes.search_url }}" data-dialog-open="SearchModal" aria-haspopup="dialog">
          {%- render 'icon', name: 'search' -%}
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and s.show_account -%}
        <a class="icon-button header__icon hide-mobile" href="{{ routes.account_url }}">
          {%- render 'icon', name: 'account-plus' -%}
          <span class="visually-hidden">{%- if customer -%}{{ 'header.account' | t }}{%- else -%}{{ 'header.log_in' | t }}{%- endif -%}</span>
        </a>
      {%- endif -%}

      <a class="icon-button header__icon header__cart" href="{{ routes.cart_url }}" {{ cart_opener }}>
        {%- render 'icon', name: s.cart_icon -%}
        <span class="visually-hidden">{{ 'header.cart' | t }}</span>
        <span data-section-target="cart-count">{% render 'cart-count' %}</span>
      </a>
    </div>
  </header>

  {%- comment -%} Mega menu panels; assets/header.js moves each into its menu item. {%- endcomment -%}
  {%- unless drawer_menu -%}
    <div class="header__mega-menus hide-mobile">
      {% content_for 'blocks' %}
    </div>
  {%- endunless -%}

  {%- unless drawer_menu -%}
    <script>
      (() => {
        // One-line menu: items that don't fit hide and their copies in "More"
        // show. Runs inline, so the first paint is already right (nothing cut
        // off or overlapping); assets/header.js runs it again on resize.
        const fit = (list) => {
          const more = list.querySelector(':scope > [data-more]');
          if (!more) return;
          const items = [...list.querySelectorAll(':scope > [data-index]')];
          for (const item of items) item.hidden = false;
          more.hidden = true;

          const available = list.clientWidth;
          const gap = parseFloat(getComputedStyle(list).columnGap) || 0;
          const total = items.reduce((sum, item) => sum + item.offsetWidth + gap, -gap);
          if (total > available) {
            more.hidden = false;
            let used = more.offsetWidth;
            let fits = true;
            for (const item of items) {
              used += gap + item.offsetWidth;
              if (used > available) fits = false;
              item.hidden = !fits;
            }
          }
          for (const entry of more.querySelectorAll('[data-more-index]')) {
            entry.hidden = !items[Number(entry.dataset.moreIndex)]?.hidden;
          }
        };

        window.Theme = window.Theme || {};
        window.Theme.fitHeaderMenu = fit;
        const list = document.currentScript.closest('header-component')?.querySelector('.header__menu-list');
        if (!list) return;
        fit(list);
        // Web fonts change the item widths: fit again once they are in.
        document.fonts?.ready.then(() => fit(list));
      })();
    </script>
  {%- endunless -%}

  {%- if s.show_search -%}
    <search-modal>
      <dialog class="search-modal modal color-{{ s.drawer_color_scheme.id }}" id="SearchModal" ref="dialog" aria-label="{{ 'header.search' | t }}" data-lenis-prevent>
        <div class="search-modal__inner page-width">
          <predictive-search class="predictive-search">
            <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
              <input type="hidden" name="options[prefix]" value="last">
              <label class="visually-hidden" for="SearchModalInput">{{ 'search.label' | t }}</label>
              <input
                class="input search-form__input"
                id="SearchModalInput"
                type="search"
                name="q"
                placeholder="{{ 'search.placeholder' | t }}"
                autocomplete="off"
                role="combobox"
                aria-expanded="false"
                aria-controls="PredictiveSearchResults"
                aria-autocomplete="list"
                ref="input"
              >
              <button class="icon-button search-form__submit" type="submit">
                {%- render 'icon', name: 'search' -%}
                <span class="visually-hidden">{{ 'search.submit' | t }}</span>
              </button>
            </form>
            <div class="predictive-search__results" id="PredictiveSearchResults" ref="results"></div>
          </predictive-search>
          <button class="icon-button search-modal__close" type="button" ref="close">
            {%- render 'icon', name: 'close' -%}
            <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
          </button>
        </div>
      </dialog>
    </search-modal>
  {%- endif -%}
</header-component>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "header-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "logo-left-menu-center",
          "label": "t:options.header_layout.logo_left_menu_center"
        },
        {
          "value": "logo-left",
          "label": "t:options.header_layout.logo_left"
        },
        {
          "value": "logo-center",
          "label": "t:options.header_layout.logo_center"
        },
        {
          "value": "logo-right",
          "label": "t:options.header_layout.logo_right"
        },
        {
          "value": "logo-top",
          "label": "t:options.header_layout.logo_top"
        }
      ],
      "default": "logo-left-menu-center"
    },
    {
      "type": "checkbox",
      "id": "menu_divider",
      "label": "t:settings.header_menu_divider",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'logo-top' }}"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:settings.logo_width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "t:settings.logo_width_mobile",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 110
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "menu_type",
      "label": "t:settings.menu_type",
      "options": [
        {
          "value": "menu",
          "label": "t:options.menu_type.menu"
        },
        {
          "value": "drawer",
          "label": "t:options.menu_type.drawer"
        }
      ],
      "default": "menu"
    },
    {
      "type": "select",
      "id": "menu_open_on",
      "label": "t:settings.menu_open_on",
      "options": [
        {
          "value": "hover",
          "label": "t:options.open_on.hover"
        },
        {
          "value": "click",
          "label": "t:options.open_on.click"
        }
      ],
      "default": "hover",
      "visible_if": "{{ section.settings.menu_type == 'menu' }}"
    },
    {
      "type": "select",
      "id": "menu_animation",
      "label": "t:settings.menu_animation",
      "options": [
        {
          "value": "fade",
          "label": "t:options.menu_animation.fade"
        },
        {
          "value": "fade-up",
          "label": "t:options.menu_animation.fade_up"
        },
        {
          "value": "fade-down",
          "label": "t:options.menu_animation.fade_down"
        }
      ],
      "default": "fade-up",
      "visible_if": "{{ section.settings.menu_type == 'menu' }}"
    },
    {
      "type": "select",
      "id": "menu_link_hover",
      "label": "t:settings.menu_link_hover",
      "options": [
        {
          "value": "grow",
          "label": "t:options.menu_link_hover.grow"
        },
        {
          "value": "center",
          "label": "t:options.menu_link_hover.center"
        },
        {
          "value": "slide",
          "label": "t:options.menu_link_hover.slide"
        },
        {
          "value": "none",
          "label": "t:options.menu_link_hover.none"
        }
      ],
      "default": "slide",
      "visible_if": "{{ section.settings.menu_type == 'menu' }}"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "t:settings.sticky_header",
      "options": [
        {
          "value": "none",
          "label": "t:options.sticky.none"
        },
        {
          "value": "always",
          "label": "t:options.sticky.always"
        },
        {
          "value": "scroll-up",
          "label": "t:options.sticky.scroll_up"
        }
      ],
      "default": "scroll-up"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:settings.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:settings.show_account",
      "default": true
    },
    {
      "type": "select",
      "id": "cart_icon",
      "label": "t:settings.cart_icon",
      "options": [
        {
          "value": "bag",
          "label": "t:options.icon.bag"
        },
        {
          "value": "cart",
          "label": "t:options.icon.cart"
        },
        {
          "value": "basket",
          "label": "t:options.icon.basket"
        }
      ],
      "default": "bag"
    },
    {
      "type": "header",
      "content": "t:headers.localization"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "t:settings.show_country",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:settings.show_language",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization_desktop",
      "label": "t:settings.show_localization_desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "t:headers.transparent_header"
    },
    {
      "type": "paragraph",
      "content": "t:settings.transparent_header_info"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "t:settings.transparent_header",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "t:settings.transparent_home",
      "default": true,
      "visible_if": "{{ section.settings.transparent_header }}"
    },
    {
      "type": "checkbox",
      "id": "transparent_collection",
      "label": "t:settings.transparent_collection",
      "default": false,
      "visible_if": "{{ section.settings.transparent_header }}"
    },
    {
      "type": "checkbox",
      "id": "transparent_product",
      "label": "t:settings.transparent_product",
      "default": false,
      "visible_if": "{{ section.settings.transparent_header }}"
    },
    {
      "type": "checkbox",
      "id": "transparent_list_collections",
      "label": "t:settings.transparent_list_collections",
      "default": false,
      "visible_if": "{{ section.settings.transparent_header }}"
    },
    {
      "type": "checkbox",
      "id": "transparent_other",
      "label": "t:settings.transparent_other",
      "default": false,
      "visible_if": "{{ section.settings.transparent_header }}"
    },
    {
      "type": "color_scheme",
      "id": "transparent_color_scheme",
      "label": "t:settings.transparent_color_scheme",
      "default": "scheme-2",
      "visible_if": "{{ section.settings.transparent_header }}"
    },
    {
      "type": "image_picker",
      "id": "transparent_logo",
      "label": "t:settings.transparent_logo",
      "visible_if": "{{ section.settings.transparent_header }}"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dropdown_color_scheme",
      "label": "t:settings.dropdown_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "drawer_color_scheme",
      "label": "t:settings.drawer_color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "t:settings.border",
      "default": false
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:settings.vertical_padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "_mega-menu"
    }
  ]
}
{% endschema %}
