{%- comment -%}
  Slideshow (hero): one 3D can over a gradient hero with a wavy edge. Each
  slide brings its own gradient, can (a product's 3D model, a GLB link or a
  flat image), big word behind the can, copy and floating images.

  Gradient, can and the rest are drawn by each slide (blocks/_hero-slide.liquid):
  a section can't read its theme blocks' settings. Each can sits on a stage
  fixed to the viewport (assets/hero-slideshow.js): it stays in view and
  turns while the page scrolls through the next sections, then scrolls away
  with the last of them.
{%- endcomment -%}

{{ 'section-hero-slideshow.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<hero-slideshow
  class="hero-slideshow"
  data-travel="{{ s.travel }}"
  data-end-x="{{ s.end_offset }}"
  data-end-scale="{{ s.end_scale | divided_by: 100.0 }}"
  {% if s.autoplay %}
    data-autoplay="{{ s.autoplay_speed | times: 1000 }}"
  {% endif %}
  {% if s.wave_style != 'none' %}
    data-wave
  {% endif %}
  {% if s.grid %}
    data-grid
  {% endif %}
  style="{% render 'section-height', settings: s %} {% if s.wave_style != 'none' %}{% render 'hero-wave', shape: s.wave_style %} {% endif %}--hero-can: {{ s.can_size }}; --hero-word-scale: {{ s.word_size | divided_by: 100.0 }}; --hero-below: {{ s.below_color }};{% if s.grid and s.grid_image != blank %} --hero-grid-image: url('{{ s.grid_image | image_url: width: 800 }}'); --hero-grid-size: {{ s.grid_size }}vw auto;{% endif %}"
  role="region"
  aria-roledescription="{{ 'accessibility.carousel' | t }}"
  aria-label="{{ s.accessible_name | escape }}"
>
  <div class="hero-slideshow__slides" id="HeroSlides-{{ section.id }}">
    {% content_for 'blocks' %}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slideshow__nav">
      <button class="hero-slideshow__arrow" type="button" ref="previous" aria-controls="HeroSlides-{{ section.id }}" aria-label="{{ 'accessibility.previous' | t }}">
        {%- render 'icon', name: 'undo' -%}
      </button>
      <button class="hero-slideshow__arrow hero-slideshow__arrow--next" type="button" ref="next" aria-controls="HeroSlides-{{ section.id }}" aria-label="{{ 'accessibility.next' | t }}">
        {%- render 'icon', name: 'redo' -%}
      </button>
    </div>
    <p class="visually-hidden" aria-live="polite" ref="status"></p>
  {%- endif -%}
</hero-slideshow>

{% schema %}
{
  "name": "t:sections.hero_slideshow.name",
  "class": "section-wrapper",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "_hero-slide"
    }
