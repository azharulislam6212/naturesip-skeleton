      "id": "accessible_name",
      "label": "t:settings.accessible_name",
      "default": "Featured flavours"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.height_header.content"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.slideshow.settings.height.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.height.small"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.height.medium"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.height.large"
        },
        {
          "value": "full",
          "label": "t:sections.slideshow.settings.height.full"
        },
        {
          "value": "custom",
          "label": "t:sections.slideshow.settings.height.custom"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.height == 'custom' }}",
      "type": "range",
      "id": "height_custom",
      "min": 300,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "t:sections.slideshow.settings.height_custom.label",
      "default": 720
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:sections.slideshow.settings.height_mobile.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.height.small"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.height.medium"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.height.large"
        },
        {
          "value": "full",
          "label": "t:sections.slideshow.settings.height.full"
        },
        {
          "value": "custom",
          "label": "t:sections.slideshow.settings.height.custom"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.height_mobile == 'custom' }}",
      "type": "range",
      "id": "height_mobile_custom",
      "min": 240,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "t:sections.slideshow.settings.height_mobile_custom.label",
      "default": 600
    },
    {
      "type": "range",
      "id": "word_size",
      "label": "t:sections.hero_slideshow.settings.word_size",
      "min": 50,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "wave_style",
      "label": "t:sections.hero_slideshow.settings.wave",
      "options": [
        {
          "value": "none",
          "label": "t:sections.hero_slideshow.options.wave_none"
        },
        {
          "value": "wave",
          "label": "t:sections.hero_slideshow.options.wave_wave"
        },
        {
          "value": "waves",
          "label": "t:sections.hero_slideshow.options.wave_waves"
        },
        {
          "value": "curve",
          "label": "t:sections.hero_slideshow.options.wave_curve"
        },
        {
          "value": "arch",
          "label": "t:sections.hero_slideshow.options.wave_arch"
        },
        {
          "value": "slant",
          "label": "t:sections.hero_slideshow.options.wave_slant"
        },
        {
          "value": "zigzag",
          "label": "t:sections.hero_slideshow.options.wave_zigzag"
        },
        {
          "value": "scallop",
          "label": "t:sections.hero_slideshow.options.wave_scallop"
        }
      ],
      "default": "wave"
    },
    {
      "type": "color",
      "id": "below_color",
      "label": "t:sections.hero_slideshow.settings.below_color",
      "default": "#FEF6F2"
    },
    {
      "type": "checkbox",
      "id": "grid",
      "label": "t:sections.hero_slideshow.settings.grid",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "grid_image",
      "label": "t:sections.hero_slideshow.settings.grid_image",
      "visible_if": "{{ section.settings.grid }}"
    },
    {
      "type": "range",
      "id": "grid_size",
      "label": "t:sections.hero_slideshow.settings.grid_size",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 27,
      "visible_if": "{{ section.settings.grid and section.settings.grid_image != blank }}"
    },
    {
      "type": "header",
      "content": "t:sections.hero_slideshow.headers.can"
    },
    {
      "type": "range",
      "id": "can_size",
      "label": "t:sections.hero_slideshow.settings.can_size",
      "min": 40,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 72
    },
    {
      "type": "select",
      "id": "travel",
      "label": "t:sections.hero_slideshow.settings.travel",
      "options": [
        {
          "value": "0",
          "label": "t:sections.hero_slideshow.options.travel_none"
        },
        {
          "value": "1",
          "label": "t:sections.hero_slideshow.options.travel_one"
        },
        {
          "value": "2",
          "label": "t:sections.hero_slideshow.options.travel_two"
        },
        {
          "value": "3",
          "label": "t:sections.hero_slideshow.options.travel_three"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "end_offset",
      "label": "t:sections.hero_slideshow.settings.end_offset",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "end_scale",
      "label": "t:sections.hero_slideshow.settings.end_scale",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "header",
      "content": "t:carousel.headers.carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.autoplay",
