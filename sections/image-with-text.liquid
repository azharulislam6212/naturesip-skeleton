        },
        "media": {
          "type": "_image-with-text-media",
          "static": true,
          "settings": {
            "ratio": "square",
            "radius": 24,
            "scroll_animation": "sequence",
            "strength": 100
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "button",
        "floating_image"
      ]
    }
  ]
}
