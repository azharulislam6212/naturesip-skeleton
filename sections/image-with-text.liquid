{%- comment -%}
  Image with text: a large image (static `_image-with-text-media` block) that
  animates in with the page scroll, beside heading, text and button blocks.
  Floating images (`_floating-image` blocks) sit anywhere over the section
  with their own loop animation and scroll parallax.
{%- endcomment -%}

{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  case s.content_alignment
    when 'center'
      assign stack_align = 'center'
      assign text_align = 'center'
    when 'right'
      assign stack_align = 'flex-end'
      assign text_align = 'end'
    else
      assign stack_align = 'flex-start'
      assign text_align = 'start'
  endcase
-%}

<section
  class="section section-surface image-with-text color-{{ s.color_scheme.id }} spacing-style"
  style="
    {%- render 'spacing-style', settings: s -%}
    --iwt-media-width: {{ s.media_width }};
    --iwt-gap: {{ s.gap | divided_by: 16.0 }}rem;
    --iwt-gap-mobile: {{ s.gap_mobile | divided_by: 16.0 }}rem;
  "
  {% render 'shape-attributes', settings: s %}
>
  {% render 'background', settings: s %}

  <div class="image-with-text__grid image-with-text__grid--media-{{ s.media_position }} image-with-text__grid--{{ s.vertical_alignment }}{% unless s.media_first_mobile %} image-with-text__grid--text-first-mobile{% endunless %}">
    {% content_for 'block', type: '_image-with-text-media', id: 'media' %}

    <div
      class="image-with-text__content layout-stack"
      style="
        --align: {{ stack_align }};
        --gap: {{ s.content_gap }}px;
        --gap-mobile: {{ s.content_gap_mobile }}px;
        --stack-text-align: {{ text_align }};
      "
      {% render 'animation-attributes', animation: 'none', stagger: true %}
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "_floating-image"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:headers.layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.side.left"
        },
        {
          "value": "right",
          "label": "t:options.side.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "t:settings.media_column_width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 49
    },
    {
      "type": "checkbox",
      "id": "media_first_mobile",
      "label": "t:settings.media_first_mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "gap_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.column_gap",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:settings.column_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:headers.content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:settings.content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.text_align.left"
        },
        {
          "value": "center",
          "label": "t:options.text_align.center"
        },
        {
          "value": "right",
          "label": "t:options.text_align.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.vertical_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.vertical.top"
        },
        {
          "value": "center",
          "label": "t:options.vertical.middle"
        },
        {
          "value": "end",
          "label": "t:options.vertical.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_gap_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.content_gap_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "t:settings.gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.content_gap_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "t:settings.background_image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.background_image != blank }}"
