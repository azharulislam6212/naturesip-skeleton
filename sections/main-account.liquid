{%- comment -%} Customer account: order history and default address. {%- endcomment -%}

<section class="section customer color-{{ section.settings.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: section.settings -%}">
  <div class="customer__account">
    <div class="customer__account-header">
      <h1 class="type-heading type-h2">{{ 'customer.account.title' | t }}</h1>
      <a class="link" href="{{ routes.account_logout_url }}">{% render 'icon', name: 'account' %}{{ 'customer.account.log_out' | t }}</a>
    </div>

    <div class="customer__account-grid">
      <div>
        <h2 class="type-heading type-h4">{{ 'customer.account.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="customer__table">
              <caption class="visually-hidden">{{ 'customer.account.orders' | t }}</caption>
              <thead>
                <tr>
                  <th scope="col">{{ 'customer.order.number' | t }}</th>
                  <th scope="col">{{ 'customer.order.date' | t }}</th>
                  <th scope="col">{{ 'customer.order.payment_status' | t }}</th>
                  <th scope="col">{{ 'customer.order.fulfillment_status' | t }}</th>
                  <th scope="col">{{ 'customer.order.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <th scope="row"><a href="{{ order.customer_url }}">{{ order.name }}</a></th>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money_with_currency }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>{{ 'customer.account.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <div>
        <h2 class="type-heading type-h4">{{ 'customer.account.details' | t }}</h2>
        {{ customer.default_address | format_address }}
        <a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_account.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
