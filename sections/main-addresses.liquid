{%- comment -%} Customer addresses: list, edit and add. Forms open in native <details>. {%- endcomment -%}

<section class="section customer color-{{ section.settings.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: section.settings -%}">
  <div class="customer__account">
    <a class="link" href="{{ routes.account_url }}">{% render 'icon', name: 'arrow-left' %}{{ 'customer.account.back' | t }}</a>
    <h1 class="type-heading type-h2">{{ 'customer.addresses.title' | t }}</h1>

    <details class="accordion customer__address-form" {% if customer.addresses_count == 0 %}open{% endif %}>
      <summary class="accordion__summary">{{ 'customer.addresses.add' | t }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
      <div class="accordion__content">
        {%- form 'customer_address', customer.new_address -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          {% render 'address-fields', form: form, id: 'new' %}
          {%- assign save_label = 'customer.addresses.save' | t -%}
          {% render 'button', label: save_label, type: 'submit' %}
        {%- endform -%}
      </div>
    </details>

    {%- paginate customer.addresses by 20 -%}
      <ul class="customer__addresses" role="list">
        {%- for address in customer.addresses -%}
          <li class="customer__address">
            {%- if address == customer.default_address -%}<p class="badge">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
            {{ address | format_address }}
            <details class="accordion">
              <summary class="accordion__summary">{{ 'customer.addresses.edit' | t }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
              <div class="accordion__content">
                {%- form 'customer_address', address -%}
                  {%- assign address_id = 'edit-' | append: address.id -%}
                  {% render 'address-fields', form: form, id: address_id %}
                  {%- assign update_label = 'customer.addresses.update' | t -%}
                  {% render 'button', label: update_label, type: 'submit' %}
                {%- endform -%}
              </div>
            </details>
            <form action="{{ address.url }}" method="post">
              <input type="hidden" name="_method" value="delete">
              <button class="link" type="submit">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_addresses.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_width.header"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.all.section_width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.section_width.options__2.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.section_width.options__3.label"
        },
        {
          "value": "standard",
          "label": "t:sections.all.section_width.options__4.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.section_width.options__5.label"
        },
        {
          "value": "custom",
          "label": "t:sections.all.section_width.options__6.label"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.section_width == 'custom' }}",
      "type": "range",
      "id": "section_custom_width",
      "label": "t:sections.all.section_width.custom.label",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
