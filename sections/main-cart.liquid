{%- comment -%}
  Cart page. Two static blocks make the layout: `_cart-items` (title, line
  items or the empty cart) and `_cart-summary` (shipping extras, note and the
  static checkout block). Blocks added to the section itself render full
  width under them. The whole section re-renders after every cart change
  (data-cart-section, assets/cart.js). Same structure as sections/main-product.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}
{%- capture section_blocks -%}{% content_for 'blocks' %}{%- endcapture -%}

<section
  class="section section-surface color-{{ s.color_scheme.id }} spacing-style"
  style="
    {%- render 'spacing-style', settings: s -%}
    --cart-summary-width: {{ s.summary_width | divided_by: 16.0 }}rem;
    --cart-gap: {{ s.gap | divided_by: 16.0 }}rem;
    --cart-gap-mobile: {{ s.gap_mobile | divided_by: 16.0 }}rem;
  "
  data-cart-section="{{ section.id }}"
  {% render 'shape-attributes', settings: s %}
>
  {% render 'background', settings: s %}

  <div class="cart-page{% if cart.item_count == 0 %} cart-page--empty{% endif %}">
    {% content_for 'block', type: '_cart-items', id: 'items' %}
    {%- if cart.item_count > 0 -%}
      {% content_for 'block', type: '_cart-summary', id: 'summary' %}
    {%- endif -%}
  </div>

  {%- if section_blocks != blank -%}
    <div class="cart-page__blocks">{{ section_blocks }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "icon-text"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:headers.layout"
    },
    {
      "type": "range",
      "id": "summary_width",
      "label": "t:settings.summary_width",
      "min": 300,
      "max": 520,
      "step": 4,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.column_gap",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:settings.column_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "t:settings.background_image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "shape_top",
      "label": "t:settings.shape_top",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_bottom",
      "label": "t:settings.shape_bottom",
      "options": [
        {
          "value": "none",
          "label": "t:options.shape.none"
        },
        {
          "value": "wave",
          "label": "t:options.shape.wave"
        },
        {
          "value": "waves",
          "label": "t:options.shape.waves"
        },
        {
          "value": "curve",
          "label": "t:options.shape.curve"
        },
        {
          "value": "arch",
          "label": "t:options.shape.arch"
        },
        {
          "value": "slant",
          "label": "t:options.shape.slant"
        },
        {
          "value": "triangle",
          "label": "t:options.shape.triangle"
        },
        {
          "value": "zigzag",
          "label": "t:options.shape.zigzag"
        },
        {
          "value": "scallop",
          "label": "t:options.shape.scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "shape_size",
      "label": "t:settings.shape_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.shape_size.small"
        },
        {
          "value": "medium",
          "label": "t:options.shape_size.medium"
        },
        {
          "value": "large",
          "label": "t:options.shape_size.large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.shape_top != 'none' or section.settings.shape_bottom != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_width.header"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.all.section_width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.section_width.options__2.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.section_width.options__3.label"
        },
        {
          "value": "standard",
          "label": "t:sections.all.section_width.options__4.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.section_width.options__5.label"
        },
        {
          "value": "custom",
          "label": "t:sections.all.section_width.options__6.label"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.section_width == 'custom' }}",
      "type": "range",
      "id": "section_custom_width",
      "label": "t:sections.all.section_width.custom.label",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "enabled_on": {
    "templates": [
      "cart"
    ]
  }
}
{% endschema %}
