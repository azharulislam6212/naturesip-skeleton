{%- comment -%} Cart page: line items beside the order summary. Re-rendered after every cart change. {%- endcomment -%}

{%- assign s = section.settings -%}
<section class="section section-surface color-{{ s.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: s -%}" data-cart-section="{{ section.id }}">
  {% render 'background' %}
  <div class="cart-page">
    <h1 class="type-heading type-{{ s.title_size | replace: '_', '-' }} cart-page__title">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <cart-items class="cart-page__items cart-items">
        {% render 'cart-line-items', context: 'page' %}
      </cart-items>
      <aside class="cart-page__summary" aria-label="{{ 'cart.summary' | t }}">
        {% render 'cart-summary', context: 'page', show_note: settings.cart_note, show_dynamic_checkout: s.show_dynamic_checkout %}
      </aside>
    {%- else -%}
      <div class="cart-page__empty">
        {% render 'cart-empty', context: 'page' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "title_size",
      "label": "t:settings.title_size",
      "options": [
        {
          "value": "display_xl",
          "label": "t:options.type_preset.display_xl"
        },
        {
          "value": "display_l",
          "label": "t:options.type_preset.display_l"
        },
        {
          "value": "display_m",
          "label": "t:options.type_preset.display_m"
        },
        {
          "value": "display_s",
          "label": "t:options.type_preset.display_s"
        },
        {
          "value": "h1",
          "label": "t:options.type_preset.h1"
        },
        {
          "value": "h2",
          "label": "t:options.type_preset.h2"
        },
        {
          "value": "h3",
          "label": "t:options.type_preset.h3"
        }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:settings.show_dynamic_checkout",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_width.header"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.all.section_width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.section_width.options__2.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.section_width.options__3.label"
        },
        {
          "value": "standard",
          "label": "t:sections.all.section_width.options__4.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.section_width.options__5.label"
        },
        {
          "value": "custom",
          "label": "t:sections.all.section_width.options__6.label"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.section_width == 'custom' }}",
      "type": "range",
      "id": "section_custom_width",
      "label": "t:sections.all.section_width.custom.label",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
