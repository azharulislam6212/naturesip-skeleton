{%- comment -%} All collections as image cards. {%- endcomment -%}

{%- assign s = section.settings -%}
<section class="section section-surface color-{{ s.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: s -%}">
  {% render 'background' %}
  <div class="layout-stack" style="--gap: var(--space-xl);">
    <h1 class="type-heading type-{{ s.title_size | replace: '_', '-' }}">{{ 'collections.title' | t }}</h1>
    {%- paginate collections by 24 -%}
      <ul class="grid" role="list" style="--columns-desktop: {{ s.columns_desktop }}; --columns-tablet: 3; --columns-mobile: {{ s.columns_mobile }};" {% render 'animation-attributes', stagger: true %}>
        {%- for item in collections -%}
          <li>
            {% render 'collection-card', collection: item, ratio: s.image_ratio, sizes: '(min-width: 990px) 25vw, 50vw' %}
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "title_size",
      "label": "t:settings.title_size",
      "options": [
        {
          "value": "display_xl",
          "label": "t:options.type_preset.display_xl"
        },
        {
          "value": "display_l",
          "label": "t:options.type_preset.display_l"
        },
        {
          "value": "display_m",
          "label": "t:options.type_preset.display_m"
        },
        {
          "value": "display_s",
          "label": "t:options.type_preset.display_s"
        },
        {
          "value": "h1",
          "label": "t:options.type_preset.h1"
        },
        {
          "value": "h2",
          "label": "t:options.type_preset.h2"
        },
        {
          "value": "h3",
          "label": "t:options.type_preset.h3"
        }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.columns.one"
        },
        {
          "value": "2",
          "label": "t:options.columns.two"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "1",
          "label": "t:options.ratio.square"
        },
        {
          "value": "0.8",
          "label": "t:options.ratio.portrait"
        },
        {
          "value": "1.5",
          "label": "t:options.ratio.landscape"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
