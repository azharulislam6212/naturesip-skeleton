{%- comment -%} Customer login, password recovery (via #recover) and guest checkout. {%- endcomment -%}

{{ 'section-customer.css' | asset_url | stylesheet_tag }}

<section class="section customer color-{{ section.settings.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: section.settings -%}">
  <div class="customer__panel">
    <div class="customer__recover" id="recover" tabindex="-1">
      <h2 class="type-heading type-h3">{{ 'customer.recover.title' | t }}</h2>
      <p>{{ 'customer.recover.subtext' | t }}</p>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ 'customer.recover.success' | t }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.email' | t }}</label>
          <input class="input" id="RecoverEmail" type="email" name="email" autocomplete="email" required {% if form.errors %}aria-invalid="true" aria-describedby="RecoverEmail-error"{% endif %}>
          {%- if form.errors -%}<p class="form-message form-message--error" id="RecoverEmail-error">{{ form.errors.messages.form }}</p>{%- endif -%}
        </div>
        {%- assign submit_label = 'customer.recover.submit' | t -%}
        {% render 'button', label: submit_label, type: 'submit', full_width: true %}
        <a class="link" href="#login">{{ 'customer.recover.cancel' | t }}</a>
      {%- endform -%}
    </div>

    <div class="customer__login" id="login" tabindex="-1">
      <h1 class="type-heading type-h2">{{ 'customer.login.title' | t }}</h1>
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="CustomerEmail">{{ 'customer.email' | t }}</label>
          <input class="input" id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label class="field__label" for="CustomerPassword">{{ 'customer.password' | t }}</label>
            <input class="input" id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
          </div>
          <a class="link" href="#recover">{{ 'customer.login.forgot' | t }}</a>
        {%- endif -%}
        {%- assign submit_label = 'customer.login.submit' | t -%}
        {% render 'button', label: submit_label, type: 'submit', full_width: true %}
        <a class="link" href="{{ routes.account_register_url }}">{{ 'customer.login.create' | t }}</a>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      <div class="customer__guest">
        <h2 class="type-heading type-h4">{{ 'customer.login.guest_title' | t }}</h2>
        {%- form 'guest_login' -%}
          {%- assign guest_label = 'customer.login.guest_continue' | t -%}
          {% render 'button', label: guest_label, type: 'submit', variant: 'secondary', full_width: true %}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_login.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
