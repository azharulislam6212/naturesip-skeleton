{%- comment -%} A single customer order. {%- endcomment -%}

{{ 'section-customer.css' | asset_url | stylesheet_tag }}

<section class="section customer color-{{ section.settings.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: section.settings -%}">
  <div class="customer__account">
    <a class="link" href="{{ routes.account_url }}">{% render 'icon', name: 'arrow-left' %}{{ 'customer.account.back' | t }}</a>
    <h1 class="type-heading type-h2">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p>{{ 'customer.order.placed_on' | t: date: order.created_at }}</p>
    {%- if order.cancelled -%}
      <p class="form-message form-message--error">{{ 'customer.order.cancelled' | t: date: order.cancelled_at, reason: order.cancel_reason_label }}</p>
    {%- endif -%}

    <table class="customer__table">
      <caption class="visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ 'customer.order.product' | t }}</th>
          <th scope="col">{{ 'customer.order.price' | t }}</th>
          <th scope="col">{{ 'customer.order.quantity' | t }}</th>
          <th scope="col">{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <th scope="row">
              {{ line_item.title | link_to: line_item.product.url }}
              {%- if line_item.fulfillment -%}
                <br><small>{{ 'customer.order.fulfilled_at' | t: date: line_item.fulfillment.created_at }}</small>
                {%- if line_item.fulfillment.tracking_url -%}
                  <br><a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track' | t }}</a>
                {%- endif -%}
              {%- endif -%}
            </th>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><th scope="row" colspan="3">{{ 'customer.order.subtotal' | t }}</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for discount in order.cart_level_discount_applications -%}
          <tr><th scope="row" colspan="3">{{ discount.title | escape }}</th><td>−{{ discount.total_allocated_amount | money }}</td></tr>
        {%- endfor -%}
        {%- for shipping_method in order.shipping_methods -%}
          <tr><th scope="row" colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title | escape }})</th><td>{{ shipping_method.price | money }}</td></tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr><th scope="row" colspan="3">{{ tax_line.title | escape }} ({{ tax_line.rate_percentage }}%)</th><td>{{ tax_line.price | money }}</td></tr>
        {%- endfor -%}
        <tr><th scope="row" colspan="3">{{ 'customer.order.total' | t }}</th><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
      </tfoot>
    </table>

    <div class="customer__account-grid">
      <div>
        <h2 class="type-heading type-h5">{{ 'customer.order.billing_address' | t }}</h2>
        <p>{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </div>
      <div>
        <h2 class="type-heading type-h5">{{ 'customer.order.shipping_address' | t }}</h2>
        <p>{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        {{ order.shipping_address | format_address }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_order.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
