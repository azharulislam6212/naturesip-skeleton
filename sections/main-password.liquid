{%- comment -%} Password page: shop message, email sign-up and owner login. {%- endcomment -%}

{{ 'section-content.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="section section-surface color-{{ s.color_scheme.id }} spacing-style password" style="{%- render 'spacing-style', settings: s -%}">
  <div class="section-surface__background" aria-hidden="true">
    {%- if s.background_image != blank -%}{% render 'image', image: s.background_image, alt: '', sizes: '100vw', eager: true %}{%- endif -%}
  </div>
  <div class="password__inner">
    <h1 class="type-heading type-display-s text-gradient text-stroke text-shadow">{{ shop.name | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="type-h5">{{ shop.password_message }}</p>{%- endif -%}
    {% content_for 'blocks' %}

    <details class="accordion password__login">
      <summary class="accordion__summary">{{ 'password.owner_login' | t }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
      <div class="accordion__content">
        {%- form 'storefront_password', class: 'password__form' -%}
          {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors.messages.form }}</p>{%- endif -%}
          <div class="field">
            <label class="field__label" for="Password">{{ 'password.password' | t }}</label>
            <input class="input" id="Password" type="password" name="password" autocomplete="current-password" required>
          </div>
          {%- assign enter_label = 'password.enter' | t -%}
          {% render 'button', label: enter_label, type: 'submit' %}
        {%- endform -%}
        <p class="price__note">{{ 'password.admin_link_html' | t }}</p>
      </div>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "blocks": [
    {
      "type": "email-signup"
    },
    {
      "type": "text"
    },
    {
      "type": "social-links"
    }
  ]
}
{% endschema %}
