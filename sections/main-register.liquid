{%- comment -%} Customer registration. {%- endcomment -%}

<section class="section customer color-{{ section.settings.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: section.settings -%}">
  <div class="customer__panel">
    <h1 class="type-heading type-h2">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'customer.first_name' | t }}</label>
        <input class="input" id="RegisterFirstName" type="text" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'customer.last_name' | t }}</label>
        <input class="input" id="RegisterLastName" type="text" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.email' | t }}</label>
        <input class="input" id="RegisterEmail" type="email" name="customer[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" required {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.password' | t }}</label>
        <input class="input" id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}>
      </div>
      {%- assign submit_label = 'customer.register.submit' | t -%}
      {% render 'button', label: submit_label, type: 'submit', full_width: true %}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_register.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
