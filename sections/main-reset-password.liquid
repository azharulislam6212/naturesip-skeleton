{%- comment -%} Reset a customer password. {%- endcomment -%}

{{ 'section-customer.css' | asset_url | stylesheet_tag }}

<section class="section customer color-{{ section.settings.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: section.settings -%}">
  <div class="customer__panel">
    <h1 class="type-heading type-h2">{{ 'customer.reset.title' | t }}</h1>
    <p>{{ 'customer.reset.subtext' | t }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.password' | t }}</label>
        <input class="input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label>
        <input class="input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      {%- assign submit_label = 'customer.reset.submit' | t -%}
      {% render 'button', label: submit_label, type: 'submit', full_width: true %}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_reset_password.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_width.header"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.all.section_width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.section_width.options__2.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.section_width.options__3.label"
        },
        {
          "value": "standard",
          "label": "t:sections.all.section_width.options__4.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.all.section_width.options__5.label"
        },
        {
          "value": "custom",
          "label": "t:sections.all.section_width.options__6.label"
        }
      ]
    },
    {
      "visible_if": "{{ section.settings.section_width == 'custom' }}",
      "type": "range",
      "id": "section_custom_width",
      "label": "t:sections.all.section_width.custom.label",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
