{%- comment -%} Search results with filters, sorting and mixed result types. {%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="section section-surface color-{{ s.color_scheme.id }} spacing-style" style="{%- render 'spacing-style', settings: s -%}">
  <div class="section-surface__background" aria-hidden="true"></div>

  <div class="search-header">
    <h1 class="type-heading type-h2">{{ 'search.title' | t }}</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="options[prefix]" value="last">
      <label class="visually-hidden" for="MainSearch-{{ section.id }}">{{ 'search.label' | t }}</label>
      <input class="input search-form__input" id="MainSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button class="icon-button search-form__submit" type="submit">
        {%- render 'icon', name: 'search' -%}
        <span class="visually-hidden">{{ 'search.submit' | t }}</span>
      </button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.results_per_page -%}
      <div class="collection-layout collection-layout--{{ s.filter_layout }}">
        {% render 'facets', results: search, section_id: section.id, enable_filtering: s.enable_filtering, enable_sorting: s.enable_sorting, layout: s.filter_layout %}
        <div class="collection-results" data-facets-results>
          {%- if search.results_count > 0 -%}
            <ul class="grid product-grid" role="list" style="--columns-desktop: {{ s.columns_desktop }}; --columns-tablet: 3; --columns-mobile: 2;">
              {%- for item in search.results -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% render 'product-card', product: item, section_id: section.id %}
                    {%- else -%}
                      <article class="result-card">
                        {%- if item.image -%}
                          <div class="media" style="--ratio: 1.5;">{% render 'image', image: item.image, sizes: '(min-width: 990px) 25vw, 50vw' %}</div>
                        {%- endif -%}
                        <p class="type-subheading">
                          {%- if item.object_type == 'article' -%}{{ 'search.article' | t }}{%- else -%}{{ 'search.page' | t }}{%- endif -%}
                        </p>
                        <h2 class="type-heading type-h6"><a class="product-card__link" href="{{ item.url }}">{{ item.title | escape }}</a></h2>
                        <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                      </article>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>
            {% render 'pagination', paginate: paginate, facets: true %}
          {%- else -%}
            <div class="empty-state">
              <p class="type-h5">{%- assign escaped_value = search.terms | escape -%}{{ 'search.no_results_html' | t: terms: escaped_value }}</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:headers.filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:settings.enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:settings.enable_sorting",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:settings.filter_layout",
      "options": [
        {
          "value": "sidebar",
          "label": "t:options.filter_layout.sidebar"
        },
        {
          "value": "drawer",
          "label": "t:options.filter_layout.drawer"
        }
      ],
      "default": "sidebar"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ]
}
{% endschema %}
