{%- comment -%}
  Scrolling ribbon of theme blocks: text, heading and icon. Their output is
  captured once and printed twice, so the second copy (aria-hidden, inert)
  joins the first into a seamless loop. Pauses on hover; static under
  prefers-reduced-motion. A keyboard-only pause button appears on focus.
{%- endcomment -%}

{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  if s.text_size == 'default'
    assign list_class = 'marquee__list marquee__list--default'
  else
    assign list_class = 'marquee__list type-heading type-' | append: s.text_size | replace: '_', '-'
  endif
-%}
{%- capture items -%}{% content_for 'blocks' %}{%- endcapture -%}

<section
  class="section section--full-width marquee-section color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%} --marquee-duration: {{ s.speed }}s; --marquee-tilt: {{ s.tilt }}deg;"
>
  <marquee-banner class="marquee{% if s.reverse %} marquee--reverse{% endif %}{% if s.bordered %} marquee--bordered{% endif %}">
    <div class="marquee__track">
      <div class="{{ list_class }}">{{ items }}</div>
      <div class="{{ list_class }}" aria-hidden="true" inert>{{ items }}</div>
    </div>
    <button class="marquee__toggle" type="button" ref="toggle" aria-pressed="false">
      {{- 'accessibility.pause_animation' | t -}}
    </button>
  </marquee-banner>
</section>

{% schema %}
{
  "name": "t:sections.marquee.name",
  "class": "section-wrapper",
  "max_blocks": 24,
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "heading"
    },
    {
      "type": "icon"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "text_size",
      "label": "t:settings.type_preset",
      "options": [
        {
          "value": "default",
          "label": "t:options.type_preset.default"
        },
        {
          "value": "h4",
          "label": "t:options.type_preset.h4"
        },
        {
          "value": "h5",
          "label": "t:options.type_preset.h5"
        },
        {
          "value": "h6",
          "label": "t:options.type_preset.h6"
        }
      ],
      "default": "default",
      "info": "t:settings.marquee_type_info"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.marquee_speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "t:settings.reverse_direction",
      "default": false
    },
    {
      "type": "range",
      "id": "tilt",
      "label": "t:settings.tilt",
      "min": -4,
      "max": 4,
      "step": 0.1,
      "unit": "deg",
      "default": 1.3
    },
    {
      "type": "checkbox",
      "id": "bordered",
      "label": "t:settings.border",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.name",
      "category": "t:categories.sections.banners",
      "blocks": {
        "text_1": {
          "type": "text",
          "settings": {
            "text": "<p>135MG Caffeine</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_1": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "size": 28,
            "animation": "none"
          }
        },
        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>Sustainable Production</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_2": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "size": 28,
            "animation": "none"
          }
        },
        "text_3": {
          "type": "text",
          "settings": {
            "text": "<p>9 Essential Amino Acids</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_3": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "size": 28,
            "animation": "none"
          }
        },
        "text_4": {
          "type": "text",
          "settings": {
            "text": "<p>100% Natural Ingredients</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_4": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "size": 28,
            "animation": "none"
          }
        },
        "text_5": {
          "type": "text",
          "settings": {
            "text": "<p>Made From Nature</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_5": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "size": 28,
            "animation": "none"
          }
        }
      },
      "block_order": [
        "text_1",
        "icon_1",
        "text_2",
        "icon_2",
        "text_3",
        "icon_3",
        "text_4",
        "icon_4",
        "text_5",
        "icon_5"
      ]
    }
  ]
}
{% endschema %}
