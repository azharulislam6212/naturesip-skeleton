{%- comment -%}
  Scrolling text: a looping ribbon of text and separator blocks. Pauses on
  hover, on focus and with its pause button; static under prefers-reduced-motion.
{%- endcomment -%}

{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  if s.text_size == 'default'
    assign list_class = 'marquee__list marquee__list--default'
  else
    assign list_class = 'marquee__list type-heading type-' | append: s.text_size | replace: '_', '-'
  endif
-%}
<section
  class="section section--full-width marquee-section color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%} --marquee-duration: {{ s.speed }}s; --marquee-tilt: {{ s.tilt }}deg;"
>
  <svg class="visually-hidden" aria-hidden="true" focusable="false">
    <linearGradient id="marquee-burst-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FAC67A"/>
      <stop offset="1" stop-color="#FE8A80"/>
    </linearGradient>
  </svg>

  <marquee-banner class="marquee{% if s.reverse %} marquee--reverse{% endif %}{% if s.bordered %} marquee--bordered{% endif %}">
    <div class="marquee__track">
      <ul class="{{ list_class }}" role="list">
        {% content_for 'blocks' %}
      </ul>
      <ul class="{{ list_class }}" role="list" aria-hidden="true">
        {%- for block in section.blocks -%}
          {% render 'marquee-item', block: block %}
        {%- endfor -%}
      </ul>
    </div>
    <button class="icon-button marquee__toggle" type="button" ref="toggle" aria-pressed="false">
      <span class="marquee__toggle-pause">{% render 'icon', name: 'pause' %}</span>
      <span class="marquee__toggle-play">{% render 'icon', name: 'play' %}</span>
      <span class="visually-hidden">{{ 'accessibility.pause_animation' | t }}</span>
    </button>
  </marquee-banner>
</section>

{% schema %}
{
  "name": "t:sections.marquee.name",
  "class": "section-wrapper",
  "max_blocks": 24,
  "blocks": [
    {
      "type": "_marquee-text"
    },
    {
      "type": "_marquee-separator"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "text_size",
      "label": "t:settings.type_preset",
      "options": [
        {
          "value": "default",
          "label": "t:options.type_preset.default"
        },
        {
          "value": "h4",
          "label": "t:options.type_preset.h4"
        },
        {
          "value": "h5",
          "label": "t:options.type_preset.h5"
        },
        {
          "value": "h6",
          "label": "t:options.type_preset.h6"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.marquee_speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "t:settings.reverse_direction",
      "default": false
    },
    {
      "type": "range",
      "id": "tilt",
      "label": "t:settings.tilt",
      "min": -4,
      "max": 4,
      "step": 0.1,
      "unit": "deg",
      "default": 1.3
    },
    {
      "type": "checkbox",
      "id": "bordered",
      "label": "t:settings.border",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.name",
      "category": "t:categories.sections.banners",
      "blocks": {
        "text_1": {
          "type": "_marquee-text",
          "settings": {
            "text": "t:defaults.marquee_1"
          }
        },
        "separator_1": {
          "type": "_marquee-separator"
        },
        "text_2": {
          "type": "_marquee-text",
          "settings": {
            "text": "t:defaults.marquee_2"
          }
        },
        "separator_2": {
          "type": "_marquee-separator"
        },
        "text_3": {
          "type": "_marquee-text",
          "settings": {
            "text": "t:defaults.marquee_3"
          }
        },
        "separator_3": {
          "type": "_marquee-separator"
        },
        "text_4": {
          "type": "_marquee-text",
          "settings": {
            "text": "t:defaults.marquee_4"
          }
        },
        "separator_4": {
          "type": "_marquee-separator"
        },
        "text_5": {
          "type": "_marquee-text",
          "settings": {
            "text": "t:defaults.marquee_5"
          }
        },
        "separator_5": {
          "type": "_marquee-separator"
        }
      },
      "block_order": [
        "text_1",
        "separator_1",
        "text_2",
        "separator_2",
        "text_3",
        "separator_3",
        "text_4",
        "separator_4",
        "text_5",
        "separator_5"
      ]
    }
  ]
}
{% endschema %}
