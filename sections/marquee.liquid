{%- comment -%}
  Scrolling ribbon of theme blocks: text, heading and icon. Their output is
  captured once and printed twice, so the second copy (aria-hidden, inert)
  joins the first into a seamless loop. The ribbon has its own colour scheme
  and optional top/bottom borders. Pauses on hover; static under
  prefers-reduced-motion. A keyboard-only pause button appears on focus.
{%- endcomment -%}

{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign border_top = 0
  assign border_bottom = 0
  if s.border_position == 'top' or s.border_position == 'both'
    assign border_top = s.border_width
  endif
  if s.border_position == 'bottom' or s.border_position == 'both'
    assign border_bottom = s.border_width
  endif
-%}
{%- capture items -%}{% content_for 'blocks' %}{%- endcapture -%}

<section
  class="section section--full-width marquee-section color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%} --marquee-duration: {{ s.speed }}s; --marquee-tilt: {{ s.tilt }}deg;"
>
  <marquee-banner
    class="marquee color-{{ s.panel_color_scheme.id }}{% if s.reverse %} marquee--reverse{% endif %}"
    style="
      --marquee-border-style: {{ s.border_style }};
      --marquee-border-top: {{ border_top }}px;
      --marquee-border-bottom: {{ border_bottom }}px;
      --marquee-border-top-color: {{ s.border_color_top }};
      --marquee-border-bottom-color: {{ s.border_color_bottom }};
    "
  >
    <div class="marquee__track">
      <div class="marquee__list">{{ items }}</div>
      <div class="marquee__list" aria-hidden="true" inert>{{ items }}</div>
    </div>
    <button class="marquee__toggle" type="button" ref="toggle" aria-pressed="false">
      {{- 'accessibility.pause_animation' | t -}}
    </button>
  </marquee-banner>
</section>

{% schema %}
{
  "name": "t:sections.marquee.name",
  "class": "section-wrapper",
  "max_blocks": 24,
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "heading"
    },
    {
      "type": "icon"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.marquee_speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "t:settings.reverse_direction",
      "default": false
    },
    {
      "type": "range",
      "id": "tilt",
      "label": "t:settings.tilt",
      "min": -4,
      "max": 4,
      "step": 0.1,
      "unit": "deg",
      "default": 1.3
    },
    {
      "type": "header",
      "content": "t:headers.border"
    },
    {
      "type": "select",
      "id": "border_position",
      "label": "t:settings.border_position",
      "options": [
        {
          "value": "none",
          "label": "t:options.border_position.none"
        },
        {
          "value": "top",
          "label": "t:options.border_position.top"
        },
        {
          "value": "bottom",
          "label": "t:options.border_position.bottom"
        },
        {
          "value": "both",
          "label": "t:options.border_position.both"
        }
      ],
      "default": "both"
    },
    {
      "visible_if": "{{ section.settings.border_position != 'none' }}",
      "type": "select",
      "id": "border_style",
      "label": "t:settings.border_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.border_style.solid"
        },
        {
          "value": "dashed",
          "label": "t:options.border_style.dashed"
        },
        {
          "value": "dotted",
          "label": "t:options.border_style.dotted"
        }
      ],
      "default": "dashed"
    },
    {
      "visible_if": "{{ section.settings.border_position != 'none' }}",
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "visible_if": "{{ section.settings.border_position == 'top' or section.settings.border_position == 'both' }}",
      "type": "color",
      "id": "border_color_top",
      "label": "t:settings.border_color_top",
      "default": "#fac67a"
    },
    {
      "visible_if": "{{ section.settings.border_position == 'bottom' or section.settings.border_position == 'both' }}",
      "type": "color",
      "id": "border_color_bottom",
      "label": "t:settings.border_color_bottom",
      "default": "#fe8a80"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.section_color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "color_scheme",
      "id": "panel_color_scheme",
      "label": "t:settings.ribbon_color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.name",
      "category": "t:categories.sections.banners",
      "blocks": {
        "text_1": {
          "type": "text",
          "settings": {
            "text": "<p>135MG Caffeine</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_1": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "animation": "none",
            "size_preset": "small"
          }
        },
        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>Sustainable Production</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_2": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "animation": "none",
            "size_preset": "small"
          }
        },
        "text_3": {
          "type": "text",
          "settings": {
            "text": "<p>9 Essential Amino Acids</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_3": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "animation": "none",
            "size_preset": "small"
          }
        },
        "text_4": {
          "type": "text",
          "settings": {
            "text": "<p>100% Natural Ingredients</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_4": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "animation": "none",
            "size_preset": "small"
          }
        },
        "text_5": {
          "type": "text",
          "settings": {
            "text": "<p>Made From Nature</p>",
            "type_preset": "default",
            "animation": "none"
          }
        },
        "icon_5": {
          "type": "icon",
          "settings": {
            "icon": "sparkle",
            "animation": "none",
            "size_preset": "small"
          }
        }
      },
      "block_order": [
        "text_1",
        "icon_1",
        "text_2",
        "icon_2",
        "text_3",
        "icon_3",
        "text_4",
        "icon_4",
        "text_5",
        "icon_5"
      ]
    }
  ]
}
{% endschema %}
