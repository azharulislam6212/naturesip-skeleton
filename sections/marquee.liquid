{%- comment -%}
  Scrolling text: a looping ribbon of short messages. Pauses on hover, on
  focus and with its pause button; static under prefers-reduced-motion.
{%- endcomment -%}

{%- assign s = section.settings -%}
<section
  class="section section--full-width marquee-section color-{{ s.color_scheme.id }} spacing-style"
  style="{%- render 'spacing-style', settings: s -%} --marquee-duration: {{ s.speed }}s; --marquee-tilt: {{ s.tilt }}deg;"
>
  <marquee-banner class="marquee{% if s.reverse %} marquee--reverse{% endif %}{% if s.bordered %} marquee--bordered{% endif %}">
    <div class="marquee__track">
      <ul class="marquee__list type-heading type-{{ s.text_size | replace: '_', '-' }}" role="list">
        {% content_for 'blocks' %}
      </ul>
      <ul class="marquee__list type-heading type-{{ s.text_size | replace: '_', '-' }}" role="list" aria-hidden="true">
        {%- for block in section.blocks -%}
          <li class="marquee__item">
            <span>{{ block.settings.text }}</span>
            {%- if s.separator != 'none' -%}
              <span class="marquee__separator">{% render 'icon', name: s.separator %}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <button class="icon-button marquee__toggle" type="button" ref="toggle" aria-pressed="false">
      <span class="marquee__toggle-pause">{% render 'icon', name: 'pause' %}</span>
      <span class="marquee__toggle-play">{% render 'icon', name: 'play' %}</span>
      <span class="visually-hidden">{{ 'accessibility.pause_animation' | t }}</span>
    </button>
  </marquee-banner>
</section>

{% schema %}
{
  "name": "t:sections.marquee.name",
  "class": "section-wrapper",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "_marquee-item"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "text_size",
      "label": "t:settings.text_size",
      "options": [
        {
          "value": "h4",
          "label": "t:options.type_preset.h4"
        },
        {
          "value": "h5",
          "label": "t:options.type_preset.h5"
        },
        {
          "value": "h6",
          "label": "t:options.type_preset.h6"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "t:settings.separator",
      "options": [
        {
          "value": "none",
          "label": "t:options.icon.none"
        },
        {
          "value": "sparkle",
          "label": "t:options.icon.sparkle"
        },
        {
          "value": "star",
          "label": "t:options.icon.star"
        },
        {
          "value": "leaf",
          "label": "t:options.icon.leaf"
        },
        {
          "value": "heart",
          "label": "t:options.icon.heart"
        },
        {
          "value": "bolt",
          "label": "t:options.icon.bolt"
        }
      ],
      "default": "sparkle"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.marquee_speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "t:settings.reverse_direction",
      "default": false
    },
    {
      "type": "range",
      "id": "tilt",
      "label": "t:settings.tilt",
      "min": -4,
      "max": 4,
      "step": 0.5,
      "unit": "deg",
      "default": -1
    },
    {
      "type": "checkbox",
      "id": "bordered",
      "label": "t:settings.border",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:headers.padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "t:settings.device",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.device.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.device.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.name",
      "category": "t:categories.sections.banners",
      "blocks": [
        {
          "type": "_marquee-item",
          "settings": {
            "text": "t:defaults.marquee_1"
          }
        },
        {
          "type": "_marquee-item",
          "settings": {
            "text": "t:defaults.marquee_2"
          }
        },
        {
          "type": "_marquee-item",
          "settings": {
            "text": "t:defaults.marquee_3"
          }
        },
        {
          "type": "_marquee-item",
          "settings": {
            "text": "t:defaults.marquee_4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
