{%- comment -%}
  Slideshow: full-width slides, each with its own image, colour scheme and
  content blocks. A carousel with the shared loop, autoplay, arrows and pagination settings.
{%- endcomment -%}

{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section section--full-width slideshow color-{{ s.color_scheme.id }}"
  style="{% render 'section-height', settings: s %}"
  {% render 'shape-attributes', settings: s %}
>
  <slider-component
    class="slideshow__slider"
    aria-roledescription="{{ 'accessibility.carousel' | t }}"
    aria-label="{{ s.accessible_name | escape }}"
    {% render 'carousel-attributes', settings: s %}
  >
    <ul class="slider__track slideshow__track" ref="track" role="list">
      {% content_for 'blocks' %}
    </ul>
    {%- if section.blocks.size > 1 -%}
      {% render 'carousel-controls', settings: s, slides: section.blocks.size, class: 'slideshow__controls page-width' %}
    {%- endif -%}
  </slider-component>
</section>

{% schema %}
{
