{% doc %}
  Data attributes for scroll-reveal animations (read by assets/animations.js).
  Outputs nothing when animations are off in theme settings.

  @param {string} [animation] - Block/section choice: 'theme' (theme default), 'none', or a preset name.
  @param {string} [text] - Text animation: 'none', 'words' or 'theme'.
  @param {number} [delay] - Delay in ms.
  @param {boolean} [stagger] - Animate direct children one after another.
  @param {boolean} [image] - Element is an image: uses the theme image reveal setting.

  @example
  <div {% render 'animation-attributes', animation: block.settings.animation %}>
{% enddoc %}

{%- if settings.animations_reveal -%}
  {%- liquid
    assign preset = animation | default: 'theme'
    if image and preset == 'theme'
      assign preset = settings.animations_image
    elsif preset == 'theme'
      assign preset = settings.animations_style
    endif

    assign text_effect = text | default: 'none'
    if text_effect == 'theme'
      assign text_effect = settings.animations_text
    endif
  -%}
  {%- if preset != 'none' or text_effect == 'words' %} data-animate="{% if preset == 'none' %}fade{% else %}{{ preset }}{% endif %}"{% endif -%}
  {%- if text_effect == 'words' %} data-animate-text="words"{% endif -%}
  {%- if delay > 0 %} data-animate-delay="{{ delay }}"{% endif -%}
  {%- if stagger %} data-animate-stagger{% endif -%}
{%- endif -%}
