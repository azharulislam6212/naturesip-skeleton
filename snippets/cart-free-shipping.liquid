{% doc %}
  Free shipping progress (Theme settings > Cart > Free shipping bar): how much
  more to spend, or that free shipping is unlocked. The threshold is in the
  store's currency; carts in another currency compare in their own amounts.

  @example
  {% render 'cart-free-shipping' %}
{% enddoc %}

{%- if settings.cart_free_shipping and settings.cart_free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.cart_free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
    assign remaining_money = remaining | money
  -%}
  <div class="cart-free-shipping{% if remaining <= 0 %} cart-free-shipping--unlocked{% endif %}">
    <p class="cart-free-shipping__text">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {%- render 'icon', name: 'truck' -%}
        {{ 'cart.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div
      class="cart-free-shipping__bar"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress }}"
      aria-label="{{ 'cart.free_shipping_unlocked' | t | escape }}"
      style="--progress: {{ progress }}%;"
    ></div>
  </div>
{%- endif -%}
