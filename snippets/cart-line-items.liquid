{% doc %}
  Cart line items, shared by the cart page and the cart drawer.
  Quantity and remove controls are enhanced by <cart-items>.

  @param {string} context - 'page' or 'drawer' (keeps ids unique).

  @example
  {% render 'cart-line-items', context: 'drawer' %}
{% enddoc %}

<ul class="cart-items__list" role="list">
  {%- for item in cart.items -%}
    {%- assign line = forloop.index -%}
    <li class="cart-item" id="CartItem-{{ context }}-{{ line }}">
      <a class="cart-item__media media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {% render 'image', image: item.image, sizes: '96px', max_width: 240, alt: '' %}
        {%- else -%}
          {% render 'image', placeholder: 'product-1' %}
        {%- endif -%}
      </a>

      <div class="cart-item__details">
        <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

        {%- unless item.product.has_only_default_variant -%}
          <ul class="cart-item__meta" role="list">
            {%- for option in item.options_with_values -%}
              <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endunless -%}

        {%- for property in item.properties -%}
          {%- assign first_character = property.first | slice: 0 -%}
          {%- if property.last != blank and first_character != '_' -%}
            <p class="cart-item__meta">
              {{ property.first | escape }}:
              {%- if property.last contains '/uploads/' -%}
                <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
              {%- else -%}
                {{ property.last | escape }}
              {%- endif -%}
            </p>
          {%- endif -%}
        {%- endfor -%}

        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
        {%- endif -%}

        <div class="price">
          {%- if item.original_line_price != item.final_line_price -%}
            <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
            <span class="price__current">{{ item.final_line_price | money }}</span>
            <s class="price__compare">{{ item.original_line_price | money }}</s>
          {%- else -%}
            <span class="price__current">{{ item.final_line_price | money }}</span>
          {%- endif -%}
          {%- if item.unit_price_measurement -%}
            {%- assign item_unit_price = item.unit_price | money -%}
            <span class="price__unit">{{ 'products.price.unit_price_html' | t: price: item_unit_price, unit: item.unit_price_measurement.reference_unit }}</span>
          {%- endif -%}
        </div>

        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">
            {%- render 'icon', name: 'gift' -%}
            {%- assign discount_amount = discount.amount | money -%}
            {{ discount.discount_application.title | escape }} (−{{ discount_amount }})
          </p>
        {%- endfor -%}

        <div class="cart-item__controls">
          {%- assign quantity_id = 'Quantity-' | append: context | append: '-' | append: line -%}
          {%- assign cart_form = 'CartForm-' | append: context -%}
          {% render 'quantity-input',
            id: quantity_id,
            name: 'updates[]',
            value: item.quantity,
            min: 0,
            max: item.variant.quantity_rule.max,
            step: item.variant.quantity_rule.increment,
            label: item.product.title,
            line: line,
            form: cart_form
          %}
          <a
            class="cart-item__remove icon-button"
            href="{{ item.url_to_remove }}"
            data-line-remove="{{ line }}"
          >
            {%- render 'icon', name: 'trash' -%}
            <span class="visually-hidden">{%- assign escaped_value = item.title | escape -%}{{ 'cart.remove_item' | t: title: escaped_value }}</span>
          </a>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
<p class="form-message form-message--error" role="alert" data-cart-error hidden></p>
