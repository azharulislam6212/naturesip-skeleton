{% doc %}
  Order note field in an accordion, saved as it changes (<cart-note> in
  assets/cart.js). Belongs to the cart form of the same context.

  @param {string} context - 'page' or 'drawer', for unique ids.
  @param {boolean} [open] - Start expanded.

  @example
  {% render 'cart-note', context: 'drawer' %}
{% enddoc %}

<details class="accordion cart-summary__note"{% if open %} open{% endif %}>
  <summary class="accordion__summary">
    {{ 'cart.note' | t }}
    <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
  </summary>
  <div class="accordion__content">
    <label class="visually-hidden" for="CartNote-{{ context }}">{{ 'cart.note' | t }}</label>
    <cart-note>
      <textarea class="textarea" id="CartNote-{{ context }}" name="note" form="CartForm-{{ context }}">{{ cart.note }}</textarea>
    </cart-note>
  </div>
</details>
