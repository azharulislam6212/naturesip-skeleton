{% doc %}
  Cart totals, discounts and checkout buttons, plus the extras from Theme
  settings > Cart: free shipping progress, gift wrap, shipping calculator and
  order note.

  @param {string} context - 'page' or 'drawer'.
  @param {boolean} [show_note] - Show the order note field.
  @param {boolean} [show_dynamic_checkout] - Show accelerated checkout buttons.

  @example
  {% render 'cart-summary', context: 'drawer', show_note: settings.cart_note %}
{% enddoc %}

<div class="cart-summary">
  {% render 'cart-free-shipping' %}
  {% render 'cart-gift-wrap', context: context %}
  {% render 'cart-shipping-estimator', context: context %}

  {%- if show_note -%}
    <details class="accordion cart-summary__note">
      <summary class="accordion__summary">
        {{ 'cart.note' | t }}
        <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
      </summary>
      <div class="accordion__content">
        <label class="visually-hidden" for="CartNote-{{ context }}">{{ 'cart.note' | t }}</label>
        <cart-note>
          <textarea class="textarea" id="CartNote-{{ context }}" name="note" form="CartForm-{{ context }}">{{ cart.note }}</textarea>
        </cart-note>
      </div>
    </details>
  {%- endif -%}

  {%- if cart.cart_level_discount_applications.size > 0 -%}
    <ul class="cart-summary__discounts" role="list">
      {%- for discount in cart.cart_level_discount_applications -%}
        <li>
          {%- render 'icon', name: 'gift' -%}
          {{ discount.title | escape }}
          <span>−{{ discount.total_allocated_amount | money }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="cart-summary__total">
    <span>{{ 'cart.subtotal' | t }}</span>
    <span class="cart-summary__amount">
      {%- if settings.currency_code_enabled -%}
        {{ cart.total_price | money_with_currency }}
      {%- else -%}
        {{ cart.total_price | money }}
      {%- endif -%}
    </span>
  </div>

  <p class="cart-summary__tax">
    {%- if cart.duties_included and cart.taxes_included -%}
      {{ 'cart.duties_and_taxes_included_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
    {%- elsif cart.taxes_included -%}
      {{ 'cart.taxes_included_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
    {%- else -%}
      {{ 'cart.taxes_and_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
    {%- endif -%}
  </p>

  <form id="CartForm-{{ context }}" action="{{ routes.cart_url }}" method="post" novalidate>
    {%- assign checkout_label = 'cart.checkout' | t -%}
    {% render 'button', label: checkout_label, type: 'submit', icon: 'lock', full_width: true, attributes: 'name="checkout"' %}
  </form>

  {%- if show_dynamic_checkout and additional_checkout_buttons -%}
    <div class="cart-summary__dynamic">{{ content_for_additional_checkout_buttons }}</div>
  {%- endif -%}
</div>
