{% doc %}
  Cart drawer summary: the extras from Theme settings > Cart (free shipping
  progress, gift wrap, shipping calculator, order note), then totals and
  checkout. The cart page builds the same parts from blocks instead
  (blocks/_cart-summary.liquid).

  @param {string} context - 'page' or 'drawer'.
  @param {boolean} [show_note] - Show the order note field.
  @param {boolean} [show_dynamic_checkout] - Show accelerated checkout buttons.

  @example
  {% render 'cart-summary', context: 'drawer', show_note: settings.cart_note %}
{% enddoc %}

<div class="cart-summary">
  {% render 'cart-free-shipping' %}
  {% render 'cart-gift-wrap', context: context %}
  {% render 'cart-shipping-estimator', context: context %}
  {%- if show_note -%}
    {% render 'cart-note', context: context %}
  {%- endif -%}
  {% render 'cart-totals' %}
  {% render 'cart-checkout', context: context, show_dynamic_checkout: show_dynamic_checkout %}
</div>
