{% doc %}
  Collection card: image with the collection title, used by the collection
  list section and the all-collections page. Look and content come from
  Theme settings > Collection cards; a section can still set its own ratio.

  @param {object} [collection] - The collection. Blank shows placeholder content.
  @param {object} [image] - Image override; defaults to the collection image.
  @param {string} [title] - Title override; defaults to the collection title.
  @param {string} [ratio] - Section ratio; blank or 'theme' uses the theme setting.
  @param {string} [sizes] - Image sizes attribute.

  @example
  {% render 'collection-card', collection: item, ratio: section.settings.image_ratio %}
{% enddoc %}

{%- liquid
  assign card_image = image | default: collection.featured_image | default: collection.products.first.featured_media.preview_image
  assign card_title = title | default: collection.title
  if card_title == blank
    assign card_title = 'onboarding.collection_title' | t
  endif
  assign card_url = collection.url | default: routes.collections_url

  assign ratio_key = ratio
  if ratio == blank or ratio == 'theme'
    assign ratio_key = settings.collection_card_image_ratio
  endif
-%}
{%- capture card_ratio -%}{% render 'image-ratio', key: ratio_key, image: card_image %}{%- endcapture -%}

<a
  class="collection-card collection-card--{{ settings.collection_card_text_align }}{% if settings.collection_card_title_position == 'overlay' %} collection-card--overlay{% endif %}"
  href="{{ card_url }}"
  style="--card-radius: {{ settings.collection_card_radius }}px; --card-focus: {{ settings.collection_card_image_align }}; --card-background: {{ settings.collection_card_background }}; --card-border: {{ settings.collection_card_border }}; --card-label: {{ settings.collection_card_label_color }};"
>
  <span class="collection-card__media media media--hover" data-hover="{{ settings.image_hover }}" style="--ratio: {{ card_ratio }};">
    {% render 'image', image: card_image, alt: '', sizes: sizes, placeholder: 'collection-apparel-1' %}
  </span>
  <span class="collection-card__info">
    <span class="collection-card__title type-heading type-h5">{{ card_title | escape }}</span>
    {%- if settings.collection_card_show_count and collection.products_count != blank -%}
      <span class="collection-card__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
    {%- endif -%}
    {%- if settings.collection_card_show_description and collection.description != blank -%}
      <span class="collection-card__description">{{ collection.description | strip_html | truncatewords: 14 }}</span>
    {%- endif -%}
    {%- if settings.collection_card_show_link -%}
      <span class="collection-card__link">{{ 'collections.shop_now' | t }}{% render 'icon', name: 'arrow' %}</span>
    {%- endif -%}
  </span>
</a>

{% stylesheet %}
@layer components {
  .collection-card {
    position: relative;
    display: grid;
    gap: var(--space-sm);
    text-decoration: none;
  }

  .collection-card__media {
    border: 1px solid var(--card-border, transparent);
    border-radius: var(--card-radius, var(--radius-media));
    background-color: var(--card-background, transparent);
    --media-radius: var(--card-radius, var(--radius-media));
  }

  .collection-card__media :is(img, svg) {
    object-position: center var(--card-focus, center);
  }

  .collection-card__info {
    display: grid;
    justify-items: start;
    gap: var(--space-3xs);
  }

  .collection-card--center .collection-card__info {
    justify-items: center;
    text-align: center;
  }

  .collection-card--end .collection-card__info {
    justify-items: end;
    text-align: end;
  }

  .collection-card__count {
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--card-label, var(--color-accent)) 12%, transparent);
    color: var(--card-label, var(--color-accent));
    font-size: 0.8125rem;
    font-weight: var(--font-body--weight-bold);
  }

  .collection-card__description {
    color: var(--color-subtext);
    font-size: 0.9375rem;
  }

  .collection-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-3xs);
    font-weight: var(--font-body--weight-bold);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    --icon-size: 1rem;
  }

  .collection-card__link .icon {
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .collection-card:hover .collection-card__link .icon {
    translate: 4px 0;
  }

  .collection-card--overlay .collection-card__info {
    position: absolute;
    inset-inline: 1px;
    inset-block-end: 1px;
    z-index: 1;
    padding: var(--space-sm);
    border-end-start-radius: var(--card-radius, var(--radius-media));
    border-end-end-radius: var(--card-radius, var(--radius-media));
    background-image: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent);
    color: #fff;
    pointer-events: none;
  }

  .collection-card--overlay :is(.collection-card__title, .collection-card__description) {
    color: inherit;
  }

  .collection-card--overlay .collection-card__count {
    background-color: rgb(255 255 255 / 0.9);
  }
}
{% endstylesheet %}
