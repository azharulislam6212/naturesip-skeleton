{% doc %}
  Storefront filters, sorting and active-filter pills for collection and
  search results. Works without JavaScript (plain GET form); <facets-form>
  applies changes in place.

  @param {object} results - collection or search object.
  @param {string} section_id - Owning section id.
  @param {boolean} [enable_filtering] - Show filters. Default: true.
  @param {boolean} [enable_sorting] - Show the sort select. Default: true.
  @param {string} [layout] - 'sidebar' (desktop sidebar + mobile drawer) or 'drawer' (drawer everywhere).

  @example
  {% render 'facets', results: collection, section_id: section.id %}
{% enddoc %}

{%- liquid
  assign css_colours = ',aliceblue,antiquewhite,aqua,aquamarine,azure,beige,bisque,black,blanchedalmond,blue,blueviolet,brown,burlywood,cadetblue,chartreuse,chocolate,coral,cornflowerblue,cornsilk,crimson,cyan,darkblue,darkcyan,darkgoldenrod,darkgray,darkgreen,darkgrey,darkkhaki,darkmagenta,darkolivegreen,darkorange,darkorchid,darkred,darksalmon,darkseagreen,darkslateblue,darkslategray,darkslategrey,darkturquoise,darkviolet,deeppink,deepskyblue,dimgray,dimgrey,dodgerblue,firebrick,floralwhite,forestgreen,fuchsia,gainsboro,ghostwhite,gold,goldenrod,gray,green,greenyellow,grey,honeydew,hotpink,indianred,indigo,ivory,khaki,lavender,lavenderblush,lawngreen,lemonchiffon,lightblue,lightcoral,lightcyan,lightgoldenrodyellow,lightgray,lightgreen,lightgrey,lightpink,lightsalmon,lightseagreen,lightskyblue,lightslategray,lightslategrey,lightsteelblue,lightyellow,lime,limegreen,linen,magenta,maroon,mediumaquamarine,mediumblue,mediumorchid,mediumpurple,mediumseagreen,mediumslateblue,mediumspringgreen,mediumturquoise,mediumvioletred,midnightblue,mintcream,mistyrose,moccasin,navajowhite,navy,oldlace,olive,olivedrab,orange,orangered,orchid,palegoldenrod,palegreen,paleturquoise,palevioletred,papayawhip,peachpuff,peru,pink,plum,powderblue,purple,rebeccapurple,red,rosybrown,royalblue,saddlebrown,salmon,sandybrown,seagreen,seashell,sienna,silver,skyblue,slateblue,slategray,slategrey,snow,springgreen,steelblue,tan,teal,thistle,tomato,turquoise,violet,wheat,white,whitesmoke,yellow,yellowgreen,'
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total = results.products_count | default: results.results_count
  if results.terms
    assign escaped_terms = results.terms | url_param_escape
    assign clear_url = routes.search_url | append: '?q=' | append: escaped_terms | append: '&options%5Bprefix%5D=last'
  else
    assign clear_url = results.url
  endif
-%}

<facets-form class="facets facets--{{ layout | default: 'sidebar' }}">
  <div class="facets__bar">
    {%- if enable_filtering != false and results.filters.size > 0 -%}
      <button class="button button--secondary button--small facets__open" type="button" data-hover="{{ settings.button_hover_effect }}" data-dialog-open="Facets-{{ section_id }}" aria-haspopup="dialog">
        <span class="button__fill" aria-hidden="true"></span>
        <span class="button__fill button__fill--hover" aria-hidden="true"></span>
        <span class="button__icon">{% render 'icon', name: 'filter' %}</span>
        <span class="button__label">{{ 'products.facets.filter_button' | t }}</span>
      </button>
    {%- endif -%}

    <p class="facets__count" data-facets-count role="status">
      {{ 'products.facets.product_count' | t: count: total }}
    </p>

    {%- if enable_sorting != false -%}
      <form class="facets__sort" data-facets>
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input type="hidden" name="options[prefix]" value="last">
        {%- endif -%}
        {%- liquid
          assign sort_label = 'products.facets.sort_by' | t
          assign sort_id = 'SortBy-' | append: section_id
          assign sort_selected = ''
        -%}
        {%- capture sort_tags -%}
          {%- for option in results.sort_options -%}
            {%- if option.value == sort_by -%}
              {%- assign sort_selected = option.name | escape -%}
            {%- endif -%}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
              {{- option.name | escape -}}
            </option>
          {%- endfor -%}
        {%- endcapture -%}
        {% render 'custom-select',
          id: sort_id,
          name: 'sort_by',
          label: sort_label,
          label_hidden: true,
          options: sort_tags,
          selected_label: sort_selected
        %}
        <noscript><button class="link" type="submit">{{ 'products.facets.apply' | t }}</button></noscript>
      </form>
    {%- endif -%}
  </div>

  <div class="facets__active" data-facets-active>
    {%- liquid
      assign has_active = false
      for filter in results.filters
        if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
          assign has_active = true
        endif
      endfor
    -%}
    {%- if has_active -%}
      <ul class="facets__pills" role="list">
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            <li>
              <a class="facets__pill" href="{{ value.url_to_remove }}" data-facets-link>
                {{ filter.label | escape }}: {{ value.label | escape }}
                {%- render 'icon', name: 'close' -%}
                <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
              </a>
            </li>
          {%- endfor -%}
          {%- liquid
            assign price_active = false
            if filter.type == 'price_range'
              if filter.min_value.value != nil or filter.max_value.value != nil
                assign price_active = true
              endif
            endif
          -%}
          {%- if price_active -%}
            <li>
              <a class="facets__pill" href="{{ filter.url_to_remove }}" data-facets-link>
                {{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }}
                {%- render 'icon', name: 'close' -%}
                <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
        <li><a class="link" href="{{ clear_url }}" data-facets-link>{{ 'products.facets.clear_all' | t }}</a></li>
      </ul>
    {%- endif -%}
  </div>

  {%- if enable_filtering != false and results.filters.size > 0 -%}
    <dialog-component class="facets__panel">
      <dialog
        class="facets__dialog drawer drawer--start color-{{ settings.color_schemes.first.id }}"
        id="Facets-{{ section_id }}"
        aria-labelledby="FacetsTitle-{{ section_id }}"
        ref="dialog"
        data-lenis-prevent
      >
        <div class="drawer__inner">
          <div class="drawer__header">
            <h2 class="type-h5" id="FacetsTitle-{{ section_id }}">{{ 'products.facets.filters' | t }}</h2>
            <button class="icon-button" type="button" data-dialog-close>
              {%- render 'icon', name: 'close' -%}
              <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
            </button>
          </div>

          <form class="drawer__body facets__form" data-facets data-facets-filters>
            {%- if results.terms -%}
              <input type="hidden" name="q" value="{{ results.terms | escape }}">
              <input type="hidden" name="options[prefix]" value="last">
            {%- endif -%}
            {%- if sort_by -%}
              <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
            {%- endif -%}

            {%- for filter in results.filters -%}
              {%- liquid
                # Internal tags ("__badge:…" and any other "__" tag) never show
                # as filter values; a filter with nothing else is left out.
                assign shown_values = 0
                for value in filter.values
                  assign value_prefix = value.label | slice: 0, 2
                  if value_prefix != '__'
                    assign shown_values = shown_values | plus: 1
                  endif
                endfor
                if filter.type == 'list' and shown_values == 0
                  continue
                endif
              -%}
              <details class="accordion" {% if forloop.index <= 2 or filter.active_values.size > 0 %}open{% endif %}>
                <summary class="accordion__summary">
                  {{ filter.label | escape }}
                  {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
                  <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
                </summary>
                <div class="accordion__content">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      {%- liquid
                        # Shopify filter values are in cents; the URL takes whole units with a dot decimal.
                        assign range_max = filter.range_max | divided_by: 100.0 | ceil
                        assign min_cents = filter.min_value.value
                        assign max_cents = filter.max_value.value

                        assign min_input = ''
                        assign min_position = 0
                        if min_cents != nil
                          assign min_position = min_cents | divided_by: 100
                          assign min_remainder = min_cents | modulo: 100
                          if min_remainder == 0
                            assign min_input = min_position
                          else
                            assign min_input = min_cents | divided_by: 100.0 | round: 2
                          endif
                        endif

                        assign max_input = ''
                        assign max_position = range_max
                        if max_cents != nil
                          assign max_position = max_cents | divided_by: 100.0 | ceil
                          assign max_remainder = max_cents | modulo: 100
                          if max_remainder == 0
                            assign max_input = max_cents | divided_by: 100
                          else
                            assign max_input = max_cents | divided_by: 100.0 | round: 2
                          endif
                        endif

                        assign start_percent = 0
                        assign end_percent = 100
                        if range_max > 0
                          assign start_percent = min_position | times: 100.0 | divided_by: range_max | at_most: 100
                          assign end_percent = max_position | times: 100.0 | divided_by: range_max | at_most: 100
                        endif

                        assign min_id = filter.min_value.param_name | handleize | append: '-' | append: section_id
                        assign max_id = filter.max_value.param_name | handleize | append: '-' | append: section_id
                      -%}
                      <price-range class="price-range" style="--range-start: {{ start_percent }}%; --range-end: {{ end_percent }}%;">
                        {%- if range_max > 0 -%}
                          <div class="price-range__slider">
                            <input
                              class="price-range__thumb"
                              type="range"
                              min="0"
                              max="{{ range_max }}"
                              step="1"
                              value="{{ min_position }}"
                              ref="minRange"
                              aria-label="{{ 'products.facets.from' | t }}"
                            >
                            <input
                              class="price-range__thumb"
                              type="range"
                              min="0"
                              max="{{ range_max }}"
                              step="1"
                              value="{{ max_position }}"
                              ref="maxRange"
                              aria-label="{{ 'products.facets.to' | t }}"
                            >
                          </div>
                        {%- endif -%}
                        <div class="facets__price">
                          <div class="field">
                            <label class="field__label" for="{{ min_id }}">{{ 'products.facets.from' | t }}</label>
                            <div class="price-range__input">
                              <span class="price-range__currency" aria-hidden="true">{{ cart.currency.symbol }}</span>
                              <input
                                class="input"
                                type="number"
                                inputmode="decimal"
                                id="{{ min_id }}"
                                name="{{ filter.min_value.param_name }}"
                                value="{{ min_input }}"
                                placeholder="0"
                                min="0"
                                max="{{ range_max }}"
                                step="any"
                                ref="minInput"
                              >
                            </div>
                          </div>
                          <div class="field">
                            <label class="field__label" for="{{ max_id }}">{{ 'products.facets.to' | t }}</label>
                            <div class="price-range__input">
                              <span class="price-range__currency" aria-hidden="true">{{ cart.currency.symbol }}</span>
                              <input
                                class="input"
                                type="number"
                                inputmode="decimal"
                                id="{{ max_id }}"
                                name="{{ filter.max_value.param_name }}"
                                value="{{ max_input }}"
                                placeholder="{{ range_max }}"
                                min="0"
                                max="{{ range_max }}"
                                step="any"
                                ref="maxInput"
                              >
                            </div>
                          </div>
                        </div>
                      </price-range>
                    {%- when 'boolean' -%}
                      <ul class="facets__values" role="list">
                        {%- for value in filter.values -%}
                          {%- assign value_prefix = value.label | slice: 0, 2 -%}{%- if value_prefix == '__' -%}{%- continue -%}{%- endif -%}
                          <li>
                            <label class="checkbox">
                              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                              {{ value.label | escape }} ({{ value.count }})
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      {%- liquid
                        # Colour filters show as round swatches: when Search & Discovery
                        # presents them as swatches, or when the filter is about colour.
                        assign filter_key = filter.param_name | append: ' ' | append: filter.label | downcase
                        assign is_colour_filter = false
                        if filter.presentation == 'swatch' or filter_key contains 'color' or filter_key contains 'colour'
                          assign is_colour_filter = true
                        endif
                      -%}
                      {%- if is_colour_filter -%}
                        <ul class="facets__swatches" role="list">
                          {%- for value in filter.values -%}
                            {%- assign value_prefix = value.label | slice: 0, 2 -%}{%- if value_prefix == '__' -%}{%- continue -%}{%- endif -%}
                            <li>
                              <label class="facets__swatch">
                                <input
                                  class="visually-hidden"
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {% if value.active %}checked{% endif %}
                                  {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                >
                                {%- liquid
                                  # Colour from Shopify's swatch data, else the value name when it
                                  # is a CSS colour (Black, Navy…), else a blank neutral swatch.
                                  assign swatch_style = ''
                                  assign colour_name = value.label | downcase | remove: ' ' | remove: '-'
                                  assign colour_key = ',' | append: colour_name | append: ','
                                  if value.swatch.image
                                    assign swatch_url = value.swatch.image | image_url: width: 80
                                    assign swatch_style = '--swatch-background: url(' | append: swatch_url | append: ') center / cover;'
                                  elsif value.swatch.color
                                    assign swatch_style = '--swatch-background: ' | append: value.swatch.color | append: ';'
                                  elsif css_colours contains colour_key
                                    assign swatch_style = '--swatch-background: ' | append: colour_name | append: ';'
                                  endif
                                -%}
                                <span
                                  class="swatch{% if swatch_style == blank %} swatch--blank{% endif %}"
                                  {% if swatch_style != blank %}
                                    style="{{ swatch_style }}"
                                  {% endif %}
                                  aria-hidden="true"
                                ></span>
                                <span class="facets__swatch-tooltip" aria-hidden="true">
                                  {{- value.label | escape }} <span class="facets__swatch-count">({{ value.count }})</span>
                                </span>
                                <span class="visually-hidden">{{ value.label | escape }} ({{ value.count }})</span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                      <ul class="facets__values" role="list">
                        {%- for value in filter.values -%}
                          {%- assign value_prefix = value.label | slice: 0, 2 -%}{%- if value_prefix == '__' -%}{%- continue -%}{%- endif -%}
                          <li>
                            <label class="checkbox">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              {%- if filter.presentation == 'image' and value.image -%}
                                {{ value.image | image_url: width: 64 | image_tag: alt: '', class: 'facets__image', loading: 'lazy' }}
                              {%- endif -%}
                              <span>{{ value.label | escape }} <span class="facets__value-count">({{ value.count }})</span></span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                      {%- endif -%}
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}

            <div class="facets__form-footer">
              <a class="link" href="{{ clear_url }}" data-facets-link>{{ 'products.facets.clear_all' | t }}</a>
              {%- assign apply_label = 'products.facets.apply' | t -%}
              {% render 'button', label: apply_label, type: 'submit', size: 'small', attributes: 'data-dialog-close' %}
            </div>
          </form>
        </div>
      </dialog>
    </dialog-component>
  {%- endif -%}
</facets-form>
