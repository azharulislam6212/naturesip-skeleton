{% doc %}
  Storefront filters, sorting and active-filter pills for collection and
  search results. Works without JavaScript (plain GET form); <facets-form>
  applies changes in place.

  @param {object} results - collection or search object.
  @param {string} section_id - Owning section id.
  @param {boolean} [enable_filtering] - Show filters. Default: true.
  @param {boolean} [enable_sorting] - Show the sort select. Default: true.
  @param {string} [layout] - 'sidebar' (desktop sidebar + mobile drawer) or 'drawer' (drawer everywhere).

  @example
  {% render 'facets', results: collection, section_id: section.id %}
{% enddoc %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total = results.products_count | default: results.results_count
  if results.terms
    assign escaped_terms = results.terms | url_param_escape
    assign clear_url = routes.search_url | append: '?q=' | append: escaped_terms | append: '&options%5Bprefix%5D=last'
  else
    assign clear_url = results.url
  endif
-%}

<facets-form class="facets facets--{{ layout | default: 'sidebar' }}">
  <div class="facets__bar">
    {%- if enable_filtering != false and results.filters.size > 0 -%}
      <button class="button button--secondary button--small facets__open" type="button" data-dialog-open="Facets-{{ section_id }}" aria-haspopup="dialog">
        <span class="button__fill" aria-hidden="true"></span>
        <span class="button__fill button__fill--hover" aria-hidden="true"></span>
        <span class="button__icon">{% render 'icon', name: 'filter' %}</span>
        <span class="button__label">{{ 'products.facets.filter_button' | t }}</span>
      </button>
    {%- endif -%}

    <p class="facets__count" data-facets-count role="status">
      {{ 'products.facets.product_count' | t: count: total }}
    </p>

    {%- if enable_sorting != false -%}
      <form class="facets__sort" data-facets>
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input type="hidden" name="options[prefix]" value="last">
        {%- endif -%}
        <label class="visually-hidden" for="SortBy-{{ section_id }}">{{ 'products.facets.sort_by' | t }}</label>
        <select class="select" id="SortBy-{{ section_id }}" name="sort_by">
          {%- for option in results.sort_options -%}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
              {{- option.name | escape -}}
            </option>
          {%- endfor -%}
        </select>
        <noscript><button class="link" type="submit">{{ 'products.facets.apply' | t }}</button></noscript>
      </form>
    {%- endif -%}
  </div>

  <div class="facets__active" data-facets-active>
    {%- liquid
      assign has_active = false
      for filter in results.filters
        if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
          assign has_active = true
        endif
      endfor
    -%}
    {%- if has_active -%}
      <ul class="facets__pills" role="list">
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            <li>
              <a class="facets__pill" href="{{ value.url_to_remove }}" data-facets-link>
                {{ filter.label | escape }}: {{ value.label | escape }}
                {%- render 'icon', name: 'close' -%}
                <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
              </a>
            </li>
          {%- endfor -%}
          {%- liquid
            assign price_active = false
            if filter.type == 'price_range'
              if filter.min_value.value != nil or filter.max_value.value != nil
                assign price_active = true
              endif
            endif
          -%}
          {%- if price_active -%}
            <li>
              <a class="facets__pill" href="{{ filter.url_to_remove }}" data-facets-link>
                {{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }}
                {%- render 'icon', name: 'close' -%}
                <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
        <li><a class="link" href="{{ clear_url }}" data-facets-link>{{ 'products.facets.clear_all' | t }}</a></li>
      </ul>
    {%- endif -%}
  </div>

  {%- if enable_filtering != false and results.filters.size > 0 -%}
    <dialog-component class="facets__panel">
      <dialog
        class="facets__dialog drawer drawer--start color-{{ settings.body_color_scheme.id }}"
        id="Facets-{{ section_id }}"
        aria-labelledby="FacetsTitle-{{ section_id }}"
        ref="dialog"
        data-lenis-prevent
      >
        <div class="drawer__inner">
          <div class="drawer__header">
            <h2 class="type-h5" id="FacetsTitle-{{ section_id }}">{{ 'products.facets.filters' | t }}</h2>
            <button class="icon-button" type="button" data-dialog-close>
              {%- render 'icon', name: 'close' -%}
              <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
            </button>
          </div>

          <form class="drawer__body facets__form" data-facets data-facets-filters>
            {%- if results.terms -%}
              <input type="hidden" name="q" value="{{ results.terms | escape }}">
              <input type="hidden" name="options[prefix]" value="last">
            {%- endif -%}
            {%- if sort_by -%}
              <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
            {%- endif -%}

            {%- for filter in results.filters -%}
              <details class="accordion" {% if forloop.index <= 2 or filter.active_values.size > 0 %}open{% endif %}>
                <summary class="accordion__summary">
                  {{ filter.label | escape }}
                  {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
                  <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
                </summary>
                <div class="accordion__content">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      {%- assign max = filter.range_max | money_without_currency | remove: ',' -%}
                      <div class="facets__price">
                        <div class="field">
                          <label class="field__label" for="{{ filter.min_value.param_name | handleize }}-{{ section_id }}">{{ 'products.facets.from' | t }}</label>
                          <input
                            class="input"
                            type="number"
                            inputmode="decimal"
                            id="{{ filter.min_value.param_name | handleize }}-{{ section_id }}"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                            placeholder="0"
                            min="0"
                            max="{{ max }}"
                          >
                        </div>
                        <div class="field">
                          <label class="field__label" for="{{ filter.max_value.param_name | handleize }}-{{ section_id }}">{{ 'products.facets.to' | t }}</label>
                          <input
                            class="input"
                            type="number"
                            inputmode="decimal"
                            id="{{ filter.max_value.param_name | handleize }}-{{ section_id }}"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                            placeholder="{{ max }}"
                            min="0"
                            max="{{ max }}"
                          >
                        </div>
                      </div>
                    {%- when 'boolean' -%}
                      <ul class="facets__values" role="list">
                        {%- for value in filter.values -%}
                          <li>
                            <label class="checkbox">
                              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                              {{ value.label | escape }} ({{ value.count }})
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <ul class="facets__values{% if filter.presentation == 'swatch' %} facets__values--swatches{% endif %}" role="list">
                        {%- for value in filter.values -%}
                          <li>
                            <label class="checkbox">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              {%- if filter.presentation == 'swatch' -%}
                                {% render 'swatch', value: value %}
                              {%- elsif filter.presentation == 'image' and value.image -%}
                                {{ value.image | image_url: width: 64 | image_tag: alt: '', class: 'facets__image', loading: 'lazy' }}
                              {%- endif -%}
                              <span>{{ value.label | escape }} <span class="facets__value-count">({{ value.count }})</span></span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}

            <div class="facets__form-footer">
              <a class="link" href="{{ clear_url }}" data-facets-link>{{ 'products.facets.clear_all' | t }}</a>
              {%- assign apply_label = 'products.facets.apply' | t -%}
              {% render 'button', label: apply_label, type: 'submit', size: 'small', attributes: 'data-dialog-close' %}
            </div>
          </form>
        </div>
      </dialog>
    </dialog-component>
  {%- endif -%}
</facets-form>
