{% doc %}
  The can of one Slideshow (hero) slide: the product's 3D model (its GLB
  source), else the slide's can image (or the product's image), else a
  placeholder.

  A 3D can never shows an image first: a slim loading bar stands in (from
  the first paint) until the model is ready and framed, then the model
  fades in (reveal="manual", see assets/hero-slideshow.js). The first
  slide's GLB downloads alongside the model-viewer script.

  @param {object} block - The _hero-slide block.
  @param {number} index - The slide's position (the first loads its model at once).

  @example
  {% render 'hero-can', block: block, index: 0 %}
{% enddoc %}

{%- liquid
  assign b = block.settings
  assign model_src = blank
  assign poster = b.image
  if b.product != blank
    for media in b.product.media
      if media.media_type == 'model'
        for source in media.sources
          if source.format == 'glb'
            assign model_src = source.url
          endif
        endfor
        break
      endif
    endfor
    if poster == blank
      assign poster = b.product.featured_image
    endif
  endif
-%}

<div class="hero-slideshow__model">
  {%- if model_src != blank -%}
    {%- comment -%}
      The GLB is product media (not a theme asset, so no preload_tag) and
      model-viewer isn't on the Shopify CDN.
    {%- endcomment -%}
    {% # theme-check-disable AssetPreload, RemoteAsset %}
    {%- if index == 0 -%}
      <link rel="preload" href="{{ model_src }}" as="fetch" crossorigin="anonymous" fetchpriority="high">
    {%- endif -%}
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js" async></script>
    {% # theme-check-enable AssetPreload, RemoteAsset %}
    <model-viewer
      src="{{ model_src }}"
      loading="{% if index == 0 %}eager{% else %}lazy{% endif %}"
      reveal="manual"
      environment-image="neutral"
      exposure="1.05"
      shadow-intensity="0"
      interaction-prompt="none"
      disable-tap
      disable-zoom
      disable-pan
      field-of-view="35deg"
      camera-orbit="11.31deg 90deg auto"
      min-camera-orbit="auto 0deg 0m"
      max-camera-orbit="auto 180deg 1000m"
      orientation="0deg 0deg 0deg"
    ></model-viewer>
    <div class="hero-slideshow__loader" aria-hidden="true"><span></span></div>
  {%- elsif poster != blank -%}
    {%- comment -%}
      The first slide's can is the hero's LCP candidate: fetched first, at
      high priority. The rest wait until the page is idle.
    {%- endcomment -%}
    {%- liquid
      if index == 0
        assign loading = 'eager'
        assign priority = 'high'
      else
        assign loading = 'lazy'
        assign priority = 'low'
      endif
    -%}
    {{
      poster
      | image_url: width: 1200
      | image_tag:
        class: 'hero-slideshow__can-image',
        alt: '',
        loading: loading,
        fetchpriority: priority,
        sizes: '(min-width: 750px) 45vw, 92vw',
        widths: '400, 600, 800, 1000, 1200'
    }}
  {%- else -%}
    {{ 'product-1' | placeholder_svg_tag: 'hero-slideshow__can-image hero-slideshow__can-image--placeholder' }}
  {%- endif -%}
</div>
