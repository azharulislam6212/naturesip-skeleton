{% doc %}
  The can of one Slideshow (hero) slide: the product's 3D model, else the
  slide's GLB link, else its can image (or the product's image), else a
  placeholder.

  @param {object} block - The _hero-slide block.
  @param {number} index - The slide's position (the first loads its model at once).

  @example
  {% render 'hero-can', block: block, index: 0 %}
{% enddoc %}

{%- liquid
  assign b = block.settings
  assign model_src = b.model_url
  assign poster = b.image
  if b.product != blank
    for media in b.product.media
      if media.media_type == 'model'
        for source in media.sources
          if source.format == 'glb'
            assign model_src = source.url
          endif
        endfor
        if poster == blank
          assign poster = media.preview_image
        endif
        break
      endif
    endfor
    if poster == blank
      assign poster = b.product.featured_image
    endif
  endif
-%}

<div class="hero-slideshow__model">
  {%- if model_src != blank -%}
    <model-viewer
      src="{{ model_src }}"
      loading="{% if index == 0 %}eager{% else %}lazy{% endif %}"
      reveal="auto"
      environment-image="neutral"
      exposure="1.05"
      shadow-intensity="0"
      interaction-prompt="none"
      disable-tap
      disable-zoom
      disable-pan
      field-of-view="30deg"
      camera-orbit="0deg 90deg auto"
      min-camera-orbit="auto 0deg 0m"
      max-camera-orbit="auto 180deg 1000m"
      orientation="0deg 0deg 0deg"
    ></model-viewer>
  {%- elsif poster != blank -%}
    {{
      poster
      | image_url: width: 1200
      | image_tag:
        class: 'hero-slideshow__can-image',
        alt: '',
        loading: 'eager',
        sizes: '(min-width: 750px) 40vw, 70vw',
        widths: '400, 600, 800, 1000, 1200'
    }}
  {%- else -%}
    {{ 'product-1' | placeholder_svg_tag: 'hero-slideshow__can-image hero-slideshow__can-image--placeholder' }}
  {%- endif -%}
</div>
