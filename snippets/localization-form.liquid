{% doc %}
  Country/region and language selectors (shown only when the store offers
  more than one). Submits automatically via <localization-form>.

  @param {string} id - Unique id prefix.
  @param {boolean} [show_country] - Show the country selector.
  @param {boolean} [show_language] - Show the language selector.

  @example
  {% render 'localization-form', id: 'Footer', show_country: true, show_language: true %}
{% enddoc %}

{%- liquid
  assign country_enabled = false
  if show_country and localization.available_countries.size > 1
    assign country_enabled = true
  endif
  assign language_enabled = false
  if show_language and localization.available_languages.size > 1
    assign language_enabled = true
  endif
-%}

{%- if country_enabled or language_enabled -%}
  <localization-form class="localization">
    {%- form 'localization', id: id -%}
      <input type="hidden" name="return_to" value="{{ request.path }}">
      {%- if country_enabled -%}
        {%- liquid
          assign country_label = 'localization.country_label' | t
          assign search_placeholder = 'localization.search_placeholder' | t
          assign country_select_id = id | append: '-Country'
          assign country_selected = ''
        -%}
        {%- capture country_tags -%}
          {%- for country in localization.available_countries -%}
            {%- capture country_name -%}
              {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
            {%- endcapture -%}
            {%- if country.iso_code == localization.country.iso_code -%}
              {%- assign country_selected = country_name -%}
            {%- endif -%}
            <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
              {{- country_name -}}
            </option>
          {%- endfor -%}
        {%- endcapture -%}
        <div class="field">
          {% render 'custom-select',
            id: country_select_id,
            name: 'country_code',
            label: country_label,
            options: country_tags,
            selected_label: country_selected,
            searchable: true,
            search_placeholder: search_placeholder
          %}
        </div>
      {%- endif -%}
      {%- if language_enabled -%}
        {%- liquid
          assign language_label = 'localization.language_label' | t
          assign language_select_id = id | append: '-Language'
          assign language_selected = localization.language.endonym_name | capitalize
        -%}
        {%- capture language_tags -%}
          {%- for language in localization.available_languages -%}
            <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
              {{- language.endonym_name | capitalize -}}
            </option>
          {%- endfor -%}
        {%- endcapture -%}
        <div class="field">
          {% render 'custom-select',
            id: language_select_id,
            name: 'language_code',
            label: language_label,
            options: language_tags,
            selected_label: language_selected
          %}
        </div>
      {%- endif -%}
      <noscript><button class="link" type="submit">{{ 'localization.update' | t }}</button></noscript>
    {%- endform -%}
  </localization-form>
{%- endif -%}
