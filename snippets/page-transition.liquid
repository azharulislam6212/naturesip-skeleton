{% doc %}
  Page transitions between pages, driven by the `page_transition` theme setting
  (fade, slide or reveal) and coloured by `page_transition_color`.
  Render once, first thing inside <body>. Outputs nothing when the setting is 'none'.

  A full-screen curtain (<page-transition>, assets/page-transition.js):
  - is drawn covering the page on first paint, then animates away once the page loads;
  - animates back in when a same-site link is clicked, then navigates.
  A CSS failsafe removes the curtain if the module never runs.

  @example
  {% render 'page-transition' %}
{% enddoc %}

{%- if settings.page_transition != 'none' -%}
  <style>
    @layer components {
      page-transition {
        --page-transition-duration: 700ms;
        position: fixed;
        inset: 0;
        z-index: 2147483000;
        display: block;
        background-color: {{ settings.page_transition_color | default: '#000000' }};
        pointer-events: none;
        will-change: opacity, transform, clip-path;
        transition-property: opacity, transform, clip-path, visibility;
        transition-duration: var(--page-transition-duration);
        transition-timing-function: var(--ease-in-out, cubic-bezier(0.65, 0, 0.35, 1));
      }

      /* Covering the page: block clicks while it is up. */
      page-transition[data-state='covered'] {
        pointer-events: auto;
      }

      /* Waiting off-screen for the next click; jump there without animating. */
      page-transition[data-state='ready'] {
        visibility: hidden;
        transition: none;
      }

      /* Failsafe: if the module never runs, get out of the way. */
      page-transition:not([data-armed]) {
        animation: page-transition-failsafe 0.4s ease 2.5s forwards;
      }

      @keyframes page-transition-failsafe {
        to { opacity: 0; visibility: hidden; pointer-events: none; }
      }

      {%- case settings.page_transition -%}
        {%- when 'fade' -%}
          page-transition:is([data-state='out'], [data-state='ready']) {
            opacity: 0;
          }
        {%- when 'slide' -%}
          /* Leaves through the top, comes back from the bottom. */
          page-transition[data-state='out'] {
            transform: translateY(-100%);
          }
          page-transition[data-state='ready'] {
            transform: translateY(100%);
          }
        {%- when 'reveal' -%}
          /* Wipes up off the page, wipes up over it again. */
          page-transition[data-state='out'] {
            clip-path: inset(0 0 100% 0);
          }
          page-transition[data-state='ready'] {
            clip-path: inset(100% 0 0 0);
          }
      {%- endcase -%}

      @media (prefers-reduced-motion: reduce) {
        page-transition {
          display: none;
        }
      }
    }
  </style>

  <page-transition data-state="covered" aria-hidden="true"></page-transition>
{%- endif -%}
