{% doc %}
  Pagination for every paginated list (collection, search, blog, comments,
  collection list, orders, addresses), loaded in place with fetch() through
  the Section Rendering API by <pagination-component> (assets/pagination.js).

  - numbered: page links. A click fetches the section for that page, replaces
    `[data-pagination-results]` (or the whole section), and updates the URL.
  - load_more / infinite: appends the next page's items to `[data-pagination-grid]`.
  Every control is a real link, so pagination still works without JavaScript.

  @param {object} paginate - The paginate object.
  @param {string} [type] - 'numbered' (default), 'load_more' or 'infinite'.
    load_more / infinite need a `[data-pagination-grid]` in the section.

  @example
  {% render 'pagination', paginate: paginate, type: 'load_more' %}
{% enddoc %}

{%- assign type = type | default: 'numbered' -%}

{%- if paginate.pages > 1 -%}
  {%- if type == 'numbered' -%}
    <pagination-component class="pagination-component" data-type="numbered">
      <nav aria-label="{{ 'general.pagination.label' | t }}">
        <ul class="pagination" role="list">
          {%- if paginate.previous -%}
            <li>
              <a href="{{ paginate.previous.url }}" data-pagination-link>
                {%- render 'icon', name: 'chevron-left' -%}
                <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
              </a>
            </li>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            <li>
              {%- if part.is_link -%}
                <a href="{{ part.url }}" data-pagination-link>
                  <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
                  <span aria-hidden="true">{{ part.title }}</span>
                </a>
              {%- elsif part.title == paginate.current_page -%}
                <span aria-current="page">
                  <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
                  <span aria-hidden="true">{{ part.title }}</span>
                </span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- if paginate.next -%}
            <li>
              <a href="{{ paginate.next.url }}" data-pagination-link>
                {%- render 'icon', name: 'chevron-right' -%}
                <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    </pagination-component>
  {%- else -%}
    {%- liquid
      assign shown = paginate.current_offset | plus: paginate.page_size
      if shown > paginate.items
        assign shown = paginate.items
      endif
      assign progress = shown | times: 100 | divided_by: paginate.items
    -%}
    <pagination-component
      class="pagination-component load-more"
      data-type="{{ type }}"
      data-next-url="{{ paginate.next.url }}"
    >
      <p class="load-more__status" role="status">
        {{ 'general.pagination.showing' | t: shown: shown, total: paginate.items }}
      </p>
      <div class="load-more__progress" aria-hidden="true">
        <span style="width: {{ progress }}%;"></span>
      </div>
      {%- if paginate.next -%}
        <a
          class="button button--secondary load-more__button"
          href="{{ paginate.next.url }}"
          data-hover="{{ settings.button_hover_effect }}"
          data-load-more
        >
          <span class="button__fill" aria-hidden="true"></span>
          <span class="button__fill button__fill--hover" aria-hidden="true"></span>
          <span class="button__label">{{ 'general.pagination.load_more' | t }}</span>
        </a>
        <span class="load-more__spinner" aria-hidden="true"></span>
      {%- endif -%}
    </pagination-component>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
@layer components {
  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .pagination a,
  .pagination span {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding-inline: var(--space-2xs);
    border-radius: var(--radius-input);
    text-decoration: none;
  }

  .pagination [aria-current='page'] {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .pagination-component {
    display: block;
  }


  /* Load more / infinite scroll */
  .load-more {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
    text-align: center;
  }

  .load-more__status {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-subtext, var(--color-foreground));
  }

  .load-more__progress {
    width: min(14rem, 100%);
    height: 3px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-foreground) 12%, transparent);
    overflow: hidden;
  }

  .load-more__progress > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background-image: var(--gradient-accent);
    background-color: var(--color-accent);
    transition: width var(--duration-slow) var(--ease-out);
  }

  .load-more__spinner {
    display: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-block-start-color: var(--color-foreground);
    border-radius: 50%;
    animation: load-more-spin 0.8s linear infinite;
  }

  .load-more[aria-busy='true'] .load-more__spinner {
    display: block;
  }

  .load-more[aria-busy='true'] .load-more__button {
    display: none;
  }

  /* Infinite scroll loads on its own; the link stays only as a no-JS fallback. */
  .load-more[data-type='infinite'][data-ready] .load-more__button {
    display: none;
  }

  /* Infinite scroll: status + progress float at the bottom of the screen while
     the grid scrolls, so progress stays visible. Back in place on the last page. */
  .load-more[data-type='infinite'][data-ready]:not([data-next-url='']) {
    position: sticky;
    inset-block-end: var(--space-md);
    z-index: 5;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: var(--space-sm);
    row-gap: var(--space-2xs);
    width: fit-content;
    margin-inline: auto;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-card, var(--color-background));
    color: var(--color-foreground);
    box-shadow: 0 12px 32px -16px var(--color-shadow);
  }

  .load-more[data-type='infinite'][data-ready]:not([data-next-url='']) .load-more__status {
    grid-column: 1;
  }

  .load-more[data-type='infinite'][data-ready]:not([data-next-url='']) .load-more__progress {
    grid-column: 1;
    width: 100%;
    min-width: 10rem;
  }

  .load-more[data-type='infinite'][data-ready]:not([data-next-url='']) .load-more__spinner {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Keep the pill the same size while loading (spinner swaps visibility only). */
  .load-more[data-type='infinite'][data-ready]:not([data-next-url='']) .load-more__spinner {
    display: block;
    visibility: hidden;
  }

  .load-more[data-type='infinite'][data-ready][aria-busy='true'] .load-more__spinner {
    visibility: visible;
  }

  @keyframes load-more-spin {
    to { rotate: 360deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .load-more__spinner {
      animation-duration: 2.4s;
    }
  }
}
{% endstylesheet %}
