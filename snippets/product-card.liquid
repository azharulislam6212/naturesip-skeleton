{% doc %}
  Product card used by collection grids, search, carousels and recommendations.
  Layout and content toggles come from the "Product cards" theme settings.

  @param {object} [product] - Product object; omit for a placeholder card.
  @param {string} [sizes] - Image sizes attribute.
  @param {boolean} [eager] - First row above the fold: load the image eagerly.
  @param {string} [section_id] - Used to build unique ids.
  @param {string} [heading_tag] - Title element. Default: 'h3'.

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
{% enddoc %}

{%- liquid
  assign heading_tag = heading_tag | default: 'h3'
  assign sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign variant = product.selected_or_first_available_variant
  assign ratio_class = ''
  case settings.card_image_ratio
    when 'portrait'
      assign ratio = '0.8'
    when 'landscape'
      assign ratio = '1.33'
    when 'natural'
      assign ratio = product.featured_media.aspect_ratio | default: 1
      assign ratio_class = ' product-card__media--natural'
    else
      assign ratio = '1'
  endcase
  assign second_image = nil
  if settings.card_show_second_image and product.media.size > 1
    assign second_image = product.media[1].preview_image
  endif
  assign card_id = section_id | append: '-' | append: product.id
  assign title = product.title | default: 'onboarding.product_title'
  if product == blank
    assign title = 'onboarding.product_title' | t
  endif
  assign escaped_title = title | escape
  assign describedby = 'aria-describedby="CardLink-' | append: card_id | append: '"'
-%}

<article
  class="product-card product-card--{{ settings.card_style }}"
  style="--card-ratio: {{ ratio }};"
  {% render 'animation-attributes' %}
>
  <div class="product-card__media media{{ ratio_class }}" data-hover="{{ settings.image_hover }}">
    {%- if product.featured_media -%}
      {% render 'image', image: product.featured_media.preview_image, sizes: sizes, eager: eager, max_width: 1200, class: 'product-card__image' %}
      {%- if second_image -%}
        {% render 'image', image: second_image, sizes: sizes, max_width: 1200, alt: '', class: 'product-card__image product-card__image--hover' %}
      {%- endif -%}
    {%- else -%}
      {% render 'image', placeholder: 'product-apparel-1' %}
    {%- endif -%}

    {%- if product != blank -%}{% render 'product-badges', product: product %}{%- endif -%}
  </div>

  <div class="product-card__body">
    {%- if settings.card_show_rating -%}
      {% render 'rating', product: product, show_count: true %}
    {%- endif -%}

    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor type-subheading">{{ product.vendor | escape }}</p>
    {%- endif -%}

    <{{ heading_tag }} class="product-card__title">
      <a class="product-card__link" href="{{ product.url | default: '#' }}" id="CardLink-{{ card_id }}">
        {{- title | escape -}}
      </a>
    </{{ heading_tag }}>

    {% render 'price', product: product, show_from: true %}

    {%- if settings.card_show_swatches -%}
      {%- for option in product.options_with_values -%}
        {%- capture is_swatch -%}{% render 'swatch-option', option: option %}{%- endcapture -%}
        {%- if is_swatch == 'true' -%}
          {%- if settings.product_card_swatch_style == 'text' -%}
            <p class="product-card__swatch-count">
              {{- 'products.product.option_count' | t: count: option.values.size, option: option.name -}}
            </p>
          {%- else -%}
            {%- assign limit = settings.swatch_limit -%}
            <ul class="product-card__swatches" role="list" aria-label="{{ option.name | escape }}">
              {%- for value in option.values limit: limit -%}
                {%- liquid
                  assign value_unavailable = true
                  if value.available
                    assign value_unavailable = false
                  endif
                -%}
                <li>
                  <a href="{{ value.variant.url | default: product.url }}">
                    {% render 'swatch', value: value, unavailable: value_unavailable %}
                    <span class="visually-hidden">{{ value.name | escape }}</span>
                  </a>
                </li>
              {%- endfor -%}
              {%- if option.values.size > limit -%}
                {%- assign more_count = option.values.size | minus: limit -%}
                <li><a class="product-card__swatch-more" href="{{ product.url }}">{{ 'products.product.more_values' | t: count: more_count }}</a></li>
              {%- endif -%}
            </ul>
          {%- endif -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if product != blank and settings.card_quick_action != 'none' -%}
      <div class="product-card__actions">
        {%- if settings.card_quick_action == 'add' or settings.card_quick_action == 'both' -%}
          {%- if product.has_only_default_variant and variant.available -%}
            {%- assign add_label = 'products.product.add_to_cart_short' | t -%}
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product', product, id: nil, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                {% render 'button', label: add_label, type: 'submit', size: 'small', icon: 'bag', attributes: describedby %}
              {%- endform -%}
            </product-form>
          {%- elsif product.available -%}
            {%- assign options_label = 'products.product.choose_options' | t -%}
            {%- assign options_attributes = 'aria-haspopup="dialog" ' | append: describedby -%}
            <quick-view-button data-product-url="{{ product.url }}">
              {% render 'button', label: options_label, size: 'small', icon: 'bag', attributes: options_attributes %}
            </quick-view-button>
          {%- else -%}
            {%- assign sold_out_label = 'products.product.sold_out' | t -%}
            {% render 'button', label: sold_out_label, size: 'small', attributes: 'aria-disabled="true"' %}
          {%- endif -%}
        {%- endif -%}

        {%- if settings.card_quick_action == 'quick_view' or settings.card_quick_action == 'both' -%}
          <quick-view-button data-product-url="{{ product.url }}">
            <button class="icon-button product-card__quick-view" type="button" aria-haspopup="dialog">
              {%- render 'icon', name: 'eye' -%}
              <span class="visually-hidden">{{ 'products.product.quick_view_for' | t: product: escaped_title }}</span>
            </button>
          </quick-view-button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
@layer components {
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
    text-align: var(--card-align, start);
  }

  .product-card--card {
    padding: var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-card);
    box-shadow: var(--card-shadow-offset, 0px) var(--card-shadow-offset, 0px) 0 var(--color-shadow);
  }

  .product-card__media {
    --media-radius: calc(var(--radius-card) - var(--space-3xs));
    aspect-ratio: var(--card-ratio, 1);
  }

  .product-card__media > img {
    position: absolute;
    inset: 0;
  }

  .product-card__media--natural {
    aspect-ratio: auto;
  }

  .product-card__media--natural > img:first-child {
    position: static;
  }

  .product-card__image--hover {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) {
    .product-card:hover .product-card__image--hover {
      opacity: 1;
    }
  }

  .product-card__badges {
    position: absolute;
    inset-block-start: var(--space-xs);
    inset-inline-start: var(--space-xs);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .product-card__badges--top-end {
    inset-inline: auto var(--space-xs);
    justify-content: flex-end;
  }

  .product-card__badges--bottom-start {
    inset-block: auto var(--space-xs);
  }

  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: var(--card-items, flex-start);
    gap: var(--space-2xs);
  }

  .product-card__vendor {
    color: var(--color-subtext);
  }

  .product-card__title {
    font-family: var(--card-title-family, var(--font-heading--family));
    font-weight: var(--card-title-weight, var(--font-heading--weight));
    font-size: var(--card-title-size, 1rem);
    text-transform: var(--card-title-case, none);
    line-height: 1.35;
  }

  /* The whole card is clickable through the title link's pseudo-element. */
  .product-card__link {
    color: inherit;
    text-decoration: none;
  }

  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .product-card__link:focus-visible {
    outline: none;
  }

  .product-card:has(.product-card__link:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  .product-card__swatches {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs);
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  .product-card__swatches a {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }

  .product-card__swatch-more,
  .product-card__swatch-count {
    margin: 0;
    color: var(--color-subtext);
    font-size: 0.8125rem;
  }

  .product-card__actions {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: var(--card-items, flex-start);
    gap: var(--space-2xs);
    margin-block-start: auto;
  }

  .product-card__actions form {
    display: contents;
  }

  /* The row never gets wider than the card: the main button shrinks (icon
     hidden on narrow cards, label ellipsised as a last resort), the quick
     view button keeps its size. */
  .product-card__actions {
    /* Full card width: a size container gets no width from its content,
       so without this it collapses to nothing in a centred card. */
    container-type: inline-size;
    width: 100%;
    min-width: 0;
  }

  .product-card__actions > :is(product-form, quick-view-button, .button) {
    display: flex;
    flex: 0 1 auto;
    min-width: 0;
  }

  .product-card__actions > quick-view-button:has(.product-card__quick-view) {
    flex: none;
  }

  .product-card__actions .button {
    min-width: 0;
    max-width: 100%;
  }

  .product-card__actions .button__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-card__actions .button__icon {
    flex: none;
  }

  /* Narrower cards (4 columns on desktop): a little tighter, icon kept. */
  @container (max-width: 20rem) {
    .product-card__actions .button {
      --b-padding: 0.875rem;
      --b-font-size: 0.8125rem;
    }
  }

  /* Two cards per row on mobile: smaller label, icon and button. One card per
     row keeps the regular size. */
  @media (max-width: 749px) {
    .product-grid--mobile-2 .product-card__actions {
      gap: 0.375rem;
    }

    .product-grid--mobile-2 .product-card__actions .button {
      --b-padding: 0.625rem;
      --b-font-size: 0.6875rem;
      --b-height: 2.25rem;
      gap: 0.25rem;
      letter-spacing: 0.02em;
    }

    .product-grid--mobile-2 .product-card__actions .button__icon {
      width: 0.9375rem;
      height: 0.9375rem;
    }

    /* Long labels ("Choose options") wrap to two short lines instead of being cut. */
    .product-grid--mobile-2 .product-card__actions .button__label {
      white-space: normal;
      text-overflow: clip;
      line-height: 1.1;
      text-align: center;
    }

    .product-grid--mobile-2 .product-card__quick-view {
      width: 2.25rem;
      height: 2.25rem;
    }

    .product-grid--mobile-2 .product-card__quick-view svg {
      width: 1rem;
      height: 1rem;
    }
  }

  .product-card__quick-view {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-input);
  }
}
{% endstylesheet %}
