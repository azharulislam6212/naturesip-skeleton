{% doc %}
  Keeps the visitor exactly where they were when the page is reloaded or
  revisited with back/forward: same section, same spot in it, no jump up or
  down, no blank screen. Render once inside <head>, before any stylesheet or
  script.

  - Saves the spot relative to a section (the first one still on screen and
    how far into it the viewport is), not as a raw pixel offset, so fonts,
    images or a changed bar above it can't move the visitor to other content.
  - Restores while the HTML is still being parsed, as soon as that section
    exists and the page is long enough: in practice before the first paint.
    The content stays invisible until then (the page background shows, never
    a white flash), at most 500 ms.
  - Holds the spot while the page settles (stylesheets, images, fonts,
    scripts that size sections): every frame, before it is painted, the spot
    is checked and corrected, so no shift, even of a few pixels, is ever
    seen. Until the visitor scrolls, clicks or types, or 4 s after load.
    Instant jumps only, never a smooth scroll.
  - Tells the rest of the theme: html[data-restore-y] (the saved position,
    so the header can show solid before the first paint) and
    html[data-scroll-held] while the spot is held (the sticky header does
    not hide on these programmatic moves).
  - Off in the theme editor: there Shopify itself scrolls the preview to the
    section being edited. A normal visit starts at the top or at its #anchor.

  Debugging: add ?scroll-debug to the URL to log, in the console, every
  restore step and every script that scrolls the page (with its stack), to
  find anything else that moves the page.

  @example
  {% render 'scroll-restore' %}
{% enddoc %}

{%- unless request.design_mode -%}
<style>
  html.is-restoring-scroll body > * {
    visibility: hidden;
  }
</style>
<script>
  (() => {
    const key = 'theme:scroll:' + location.pathname + location.search;
    const root = document.documentElement;
    const debug = location.search.includes('scroll-debug');
    const log = (...args) => debug && console.log('[scroll-restore]', Math.round(performance.now()) + 'ms', ...args);

    if (debug) {
      // Report every scripted scroll of the page, with who asked for it.
      const report = (name) => (...args) => console.trace('[scroll-restore] ' + name, ...args);
      for (const name of ['scrollTo', 'scroll', 'scrollBy']) {
        const original = window[name];
        window[name] = function (...args) {
          report('window.' + name)(...args);
          return original.apply(this, args);
        };
      }
      const into = Element.prototype.scrollIntoView;
      Element.prototype.scrollIntoView = function (...args) {
        report('scrollIntoView on ' + (this.id || this.className || this.localName))(...args);
        return into.apply(this, args);
      };
      addEventListener('scroll', () => log('scroll event, scrollY =', Math.round(scrollY)), { passive: true });
    }

    /** The first section whose bottom is still on screen, and how far down it the viewport starts. */
    const save = () => {
      try {
        let anchor = '';
        let offset = 0;
        for (const section of document.querySelectorAll('.shopify-section')) {
          const box = section.getBoundingClientRect();
          if (box.bottom > 0 && box.height > 0) {
            anchor = section.id;
            offset = Math.round(-box.top);
            break;
          }
        }
        sessionStorage.setItem(key, JSON.stringify({ y: Math.round(scrollY), anchor, offset }));
      } catch (e) {}
    };
    addEventListener('pagehide', save);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') save();
    });

    let state = null;
    try {
      state = JSON.parse(sessionStorage.getItem(key) || 'null');
    } catch (e) {
      return;
    }

    const type = performance.getEntriesByType('navigation')[0]?.type;
    log('navigation', type, 'saved', state);
    if (!state || state.y <= 0 || location.hash || (type !== 'reload' && type !== 'back_forward')) return;

    history.scrollRestoration = 'manual';
    root.classList.add('is-restoring-scroll');
    root.dataset.restoreY = String(state.y);
    root.setAttribute('data-scroll-held', '');

    const target = () => {
      const anchor = state.anchor && document.getElementById(state.anchor);
      return anchor ? Math.max(0, Math.round(anchor.getBoundingClientRect().top + scrollY + state.offset)) : state.y;
    };

    // Puts the page in place; false while the page is not yet long enough.
    let held = true;
    const place = (reason) => {
      if (!held) return true;
      if (state.anchor && !document.getElementById(state.anchor)) return false;
      const top = target();
      if (top > root.scrollHeight - innerHeight + 1) return false;
      if (Math.abs(scrollY - top) > 1) {
        log('place', reason, 'from', Math.round(scrollY), 'to', top);
        scrollTo({ top, left: 0, behavior: 'instant' });
      }
      return true;
    };

    // While held: check the spot every frame, before it is painted, and
    // correct any drift (stylesheets, images, fonts, scripts sizing sections).
    let frame = 0;
    const hold = () => {
      place('frame');
      if (held) frame = requestAnimationFrame(hold);
    };
    const watch = () => {
      if (!frame && document.body) frame = requestAnimationFrame(hold);
    };
    const stop = (reason) => {
      if (!held) return;
      held = false;
      cancelAnimationFrame(frame);
      root.removeAttribute('data-scroll-held');
      log('released:', reason);
    };

    let shown = false;
    const show = () => {
      if (shown) return;
      shown = true;
      parsing.disconnect();
      root.classList.remove('is-restoring-scroll');
      log('shown at', Math.round(scrollY));
      document.dispatchEvent(new CustomEvent('theme:scroll-restored'));
    };

    // While the HTML is parsed: place the page the moment it can be placed.
    const parsing = new MutationObserver(() => {
      watch();
      if (place('parsing')) show();
    });
    parsing.observe(root, { childList: true, subtree: true });

    // Never leave the page hidden for long.
    setTimeout(() => {
      place('timeout');
      show();
    }, 500);

    // The visitor takes over as soon as they scroll, click or type.
    for (const name of ['wheel', 'touchstart', 'keydown', 'pointerdown']) {
      addEventListener(name, (event) => stop(event.type), { once: true, passive: true, capture: true });
    }

    document.addEventListener('DOMContentLoaded', () => {
      watch();
      place('DOMContentLoaded');
      show();
      document.fonts?.ready.then(() => place('fonts'));
    }, { once: true });

    addEventListener('load', () => {
      place('load');
      setTimeout(() => {
        place('settled');
        stop('settled');
      }, 4000);
    }, { once: true });
  })();
</script>
{%- endunless -%}
