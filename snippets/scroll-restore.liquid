{% doc %}
  Render once inside <head>, as early as possible.

  @example
  {% render 'scroll-restore' %}
{% enddoc %}

<style>
  /* Hide the content while it is moved into place. The page-transition
     curtain stays visible so it covers the page from the very first paint. */
  html.is-restoring-scroll body > :not(page-transition) {
    visibility: hidden;
  }
</style>
<script>
  (() => {
    const key = 'theme:scroll:' + location.pathname + location.search;
    let saved = 0;

    try {
      addEventListener('pagehide', () => sessionStorage.setItem(key, String(Math.round(scrollY))));
      saved = Number(sessionStorage.getItem(key)) || 0;
    } catch (e) {
      return;
    }

    const type = performance.getEntriesByType('navigation')[0]?.type;
    if (saved <= 0 || location.hash || (type !== 'reload' && type !== 'back_forward')) return;

    const root = document.documentElement;
    history.scrollRestoration = 'manual';
    root.classList.add('is-restoring-scroll');

    let shown = false;
    const show = () => {
      if (shown) return;
      shown = true;
      root.classList.remove('is-restoring-scroll');
      document.dispatchEvent(new CustomEvent('theme:scroll-restored'));
    };

    // Rendered in <head>, so the document is always still loading here.
    document.addEventListener('DOMContentLoaded', () => {
      scrollTo(0, saved);
      show();
    }, { once: true });

    // Late images and fonts can change the height: correct once, unless the visitor scrolled.
    addEventListener('load', () => {
      if (scrollY === 0 || Math.abs(scrollY - saved) <= 2) scrollTo(0, saved);
    }, { once: true });

    // Never leave the page hidden.
    setTimeout(show, 3000);
  })();
</script>
