{% doc %}
  Puts the page back where it was on a reload or back/forward visit, without
  showing the top of the page first. Render once inside <head>, as early as
  possible.

  The page stays hidden until it is in place. The position is applied at
  DOMContentLoaded and held while the page settles (late images, fonts and
  scripts that size sections can change the height), until the visitor
  scrolls or four seconds pass. A Slideshow (hero) positions its fixed can
  stage from its own script, so the page is only shown once the hero has
  placed it (or after one second). Instant jumps only: a smooth scroll here
  would play from the top down to the saved spot.

  @example
  {% render 'scroll-restore' %}
{% enddoc %}

<style>
  /* Hide the content while it is moved into place. */
  html.is-restoring-scroll body > * {
    visibility: hidden;
  }
</style>
<script>
  (() => {
    const key = 'theme:scroll:' + location.pathname + location.search;
    let saved = 0;

    try {
      addEventListener('pagehide', () => sessionStorage.setItem(key, String(Math.round(scrollY))));
      saved = Number(sessionStorage.getItem(key)) || 0;
    } catch (e) {
      return;
    }

    const type = performance.getEntriesByType('navigation')[0]?.type;
    if (saved <= 0 || location.hash || (type !== 'reload' && type !== 'back_forward')) return;

    const root = document.documentElement;
    history.scrollRestoration = 'manual';
    root.classList.add('is-restoring-scroll');

    // The visitor takes over as soon as they scroll themselves.
    let held = true;
    const release = () => { held = false; };
    for (const name of ['wheel', 'touchstart', 'keydown', 'pointerdown']) {
      addEventListener(name, release, { once: true, passive: true, capture: true });
    }

    const place = () => {
      if (held && Math.abs(scrollY - saved) > 1) scrollTo({ top: saved, left: 0, behavior: 'instant' });
    };

    let shown = false;
    const show = () => {
      if (shown) return;
      shown = true;
      place();
      root.classList.remove('is-restoring-scroll');
      document.dispatchEvent(new CustomEvent('theme:scroll-restored'));
    };

    // Rendered in <head>, so the document is always still loading here.
    document.addEventListener('DOMContentLoaded', () => {
      place();

      const resize = new ResizeObserver(place);
      resize.observe(document.body);
      setTimeout(() => {
        resize.disconnect();
        held = false;
      }, 4000);

      const hero = document.querySelector('hero-slideshow');
      if (!hero || hero.hasAttribute('data-staged')) {
        requestAnimationFrame(show);
        return;
      }
      const staged = new MutationObserver(() => {
        if (!hero.hasAttribute('data-staged')) return;
        staged.disconnect();
        requestAnimationFrame(show);
      });
      staged.observe(hero, { attributes: true, attributeFilter: ['data-staged'] });
      setTimeout(show, 1000);
    }, { once: true });

    addEventListener('load', place, { once: true });

    // Never leave the page hidden.
    setTimeout(show, 3000);
  })();
</script>
