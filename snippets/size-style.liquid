{% doc %}
  Width custom properties read by `.size-style` (assets/base.css). Output goes
  inside a `style` attribute, next to `spacing-style`. Both values are always
  written, so a nested block never picks up its parent's width.

  Reads: width ('fit', 'fill' or 'custom'), custom_width, custom_width_mobile (%).

  @param {object} settings - block.settings
  @param {string} [default] - Width when the block has no width setting: 'fit' (default) or 'fill'.

  @example
  <div class="button-block spacing-style size-style" style="{% render 'spacing-style', settings: block.settings %} {% render 'size-style', settings: block.settings %}">
{% enddoc %}

{%- liquid
  assign width = settings.width | default: default | default: 'fit'
  case width
    when 'fill'
      assign desktop = '100%'
      assign mobile = '100%'
    when 'custom'
      assign desktop = settings.custom_width | default: 100 | append: '%'
      assign mobile = settings.custom_width_mobile | default: 100 | append: '%'
    else
      assign desktop = 'auto'
      assign mobile = 'auto'
  endcase
-%}
--size-width: {{ desktop }}; --size-width-mobile: {{ mobile }};
