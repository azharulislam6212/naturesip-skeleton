{% doc %}
  Writes the padding custom properties read by `.spacing-style`: desktop
  values from 750px up, mobile values below. Output goes inside a `style`
  attribute. Every value is always written (missing settings as 0), so a
  nested block never picks up its parent's padding, even in browsers that
  ignore the `inherits: false` @property rules in base.css.

  Setting ids: padding_top, padding_bottom, padding_left, padding_right,
  plus the same with a `_mobile` suffix.

  @param {object} settings - block.settings or section.settings

  @example
  <div class="spacing-style" style="{% render 'spacing-style', settings: block.settings %}">
{% enddoc %}

{%- liquid
  assign sides = 'top,bottom,left,right' | split: ','
  assign devices = ',_mobile' | split: ','
-%}
{%- for side in sides -%}
  {%- for device in devices -%}
    {%- assign key = 'padding_' | append: side | append: device -%}
    --padding-{{ side }}{{ device | replace: '_', '-' }}: {{ settings[key] | default: 0 }}px;
  {%- endfor -%}
{%- endfor -%}
