{% doc %}
  A swatch for an option value (Theme settings > Swatches). Its fill, first
  match wins:

  1. "Variant image" fill: the image of the value's variant.
  2. "Theme color list": the value's line in the list (a colour, an image
     URL or a file from Content > Files).
  3. Shopify's swatch for the value (colour or image set in the admin).
  4. The value's name as a CSS colour (Black, Navy, Light Blue…); anything
     else shows a neutral swatch.

  @param {object} value - product_option_value.
  @param {boolean} [unavailable] - Cross the swatch out.

  @example
  {% render 'swatch', value: value %}
{% enddoc %}

{%- liquid
  assign fill = blank
  assign value_name = value.name | default: value

  if settings.swatch_style == 'image' and value.variant.featured_image
    assign image_url = value.variant.featured_image | image_url: width: 80
    assign fill = 'url(' | append: image_url | append: ')'
  endif

  if fill == blank and settings.swatches_type == 'theme' and settings.swatch_color_list != blank
    assign key = value_name | strip | downcase
    assign rows = settings.swatch_color_list | newline_to_br | split: '<br />'
    for row in rows
      assign pair = row | split: ':'
      if pair.size < 2
        continue
      endif
      assign row_key = pair.first | strip | downcase
      if row_key == key
        assign entry = row | remove_first: pair.first | remove_first: ':' | strip
        if entry contains '//'
          assign fill = 'url(' | append: entry | append: ')'
        elsif entry contains '.'
          assign file = entry | file_url
          assign fill = 'url(' | append: file | append: ')'
        else
          assign fill = entry
        endif
        break
      endif
    endfor
  endif

  if fill == blank and value.swatch.image
    assign image_url = value.swatch.image | image_url: width: 80
    assign fill = 'url(' | append: image_url | append: ')'
  elsif fill == blank and value.swatch.color
    assign fill = value.swatch.color
  endif

  if fill == blank
    assign fill = value_name | handleize | remove: '-'
  endif
-%}
<span
  class="swatch{% if unavailable %} swatch--unavailable{% endif %}"
  style="--swatch-background: {{ fill }};"
  {% if settings.swatch_show_tooltip %}
    data-tooltip="{{ value_name | escape }}"
  {% endif %}
  aria-hidden="true"
></span>

{% stylesheet %}
@layer components {
  /* Swatch (snippets/swatch.liquid). The fill sits on its own layer: a
     value that isn't a colour leaves it empty and the neutral base shows. */
  .swatch {
    --swatch-ring: var(--color-foreground);
    position: relative;
    display: inline-block;
    width: var(--swatch-size);
    height: var(--swatch-size);
    border-radius: var(--swatch-radius);
    background-color: color-mix(in srgb, var(--color-foreground) 12%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  .swatch::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--swatch-background);
    background-position: center;
    background-size: cover;
    box-shadow: inherit;
  }

  /* Value name on hover (Theme settings > Swatches). */
  .swatch[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    inset-block-end: calc(100% + 0.5rem);
    inset-inline-start: 50%;
    z-index: 3;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 0.25rem;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      translate var(--duration-fast) var(--ease-out);
  }

  :is(a, label, .option__pill):is(:hover, :focus-visible) > .swatch[data-tooltip]::after,
  .swatch[data-tooltip]:hover::after {
    opacity: 1;
    translate: -50% 0;
  }

  /* Unavailable: a diagonal strike. */
  .swatch--unavailable {
    background-image: linear-gradient(
      -45deg,
      transparent calc(50% - 0.75px),
      var(--color-foreground) calc(50% - 0.75px),
      var(--color-foreground) calc(50% + 0.75px),
      transparent calc(50% + 0.75px)
    );
  }

  .swatch--unavailable::before {
    background:
      linear-gradient(
        -45deg,
        transparent calc(50% - 0.75px),
        var(--color-foreground) calc(50% - 0.75px),
        var(--color-foreground) calc(50% + 0.75px),
        transparent calc(50% + 0.75px)
      ),
      var(--swatch-background);
    background-size: 100% 100%, cover;
    opacity: 0.6;
  }
}
{% endstylesheet %}
