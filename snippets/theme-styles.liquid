{% doc %}
  Fonts, design tokens and colour schemes, generated from theme settings.

  Every gradient token (`--gradient-*`) is always a valid <image>: when a
  gradient setting is empty, its solid colour is wrapped as
  `linear-gradient(colour, colour)`. That is what lets every colour role use
  a gradient — or not — without components caring which one they get.

  @example
  {% render 'theme-styles' %}
{% enddoc %}

{%- liquid
  assign heading_bold = settings.type_heading_font | font_modify: 'weight', 'bold'
  assign body_bold = settings.type_body_font | font_modify: 'weight', 'bold'
  assign body_italic = settings.type_body_font | font_modify: 'style', 'italic'
  assign body_bold_italic = body_bold | font_modify: 'style', 'italic'

  assign mobile_scale = settings.type_mobile_scale | divided_by: 100.0
  assign body_px = settings.type_body_size
  assign type_levels = 'display_xl,display_l,display_m,display_s,h1,h2,h3,h4,h5,h6' | split: ','
-%}

{%- liquid
  assign body_scheme_id = settings.color_schemes.first.id
-%}
{% style %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ heading_bold | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}
  {{ body_italic | font_face: font_display: 'swap' }}
  {{ body_bold_italic | font_face: font_display: 'swap' }}
  {%- liquid
    # The accent font is often the same file as a heading/body face (e.g. Poppins 700 as both
    # heading bold and accent). Declare it only when it adds a new face.
    assign accent_url = settings.type_accent_font | font_url
    assign known_urls = settings.type_heading_font | font_url | append: '|'
    assign known_urls = heading_bold | font_url | prepend: known_urls | append: '|'
    assign known_urls = settings.type_body_font | font_url | prepend: known_urls | append: '|'
    assign known_urls = body_bold | font_url | prepend: known_urls
    unless known_urls contains accent_url
      echo settings.type_accent_font | font_face: font_display: 'swap'
    endunless
  -%}

  @layer tokens {
    :root {
      --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
      --font-heading--style: {{ settings.type_heading_font.style }};
      --font-heading--weight: {{ settings.type_heading_font.weight }};
      --font-heading--weight-bold: {{ heading_bold.weight | default: 700 }};
      --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body--style: {{ settings.type_body_font.style }};
      --font-body--weight: {{ settings.type_body_font.weight }};
      --font-body--weight-bold: {{ body_bold.weight | default: 700 }};
      --font-accent--family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
      --font-accent--style: {{ settings.type_accent_font.style }};
      --font-accent--weight: {{ settings.type_accent_font.weight }};

      --line-height-tight: 0.95;
      --line-height-snug: 1.1;
      --line-height-normal: 1.3;
      --line-height-relaxed: 1.6;

      --type-paragraph-size: {{ body_px | divided_by: 16.0 }}rem;
      --type-paragraph-line-height: var(--line-height-{{ settings.type_body_line_height }});

      {%- for level in type_levels -%}
        {%- liquid
          assign key_font = level | append: '_font'
          assign key_size = level | append: '_size'
          assign key_lh = level | append: '_line_height'
          assign key_ls = level | append: '_letter_spacing'
          assign key_case = level | append: '_case'
          assign role = settings[key_font]
          assign max_px = settings[key_size]
          assign min_px = max_px | times: mobile_scale | at_least: body_px | at_most: max_px
          assign min_rem = min_px | divided_by: 16.0 | round: 3
          assign max_rem = max_px | divided_by: 16.0 | round: 3
          assign slope = max_px | minus: min_px | divided_by: 1065.0 | round: 5
          assign css_level = level | replace: '_', '-'
        -%}
        --type-{{ css_level }}-family: var(--font-{{ role }}--family);
        --type-{{ css_level }}-style: var(--font-{{ role }}--style);
        --type-{{ css_level }}-weight: var(--font-{{ role }}--weight);
        --type-{{ css_level }}-size: clamp({{ min_rem }}rem, calc({{ min_rem }}rem + {{ slope }} * (100vw - 23.4375rem)), {{ max_rem }}rem);
        --type-{{ css_level }}-line-height: var(--line-height-{{ settings[key_lh] }});
        --type-{{ css_level }}-letter-spacing: {{ settings[key_ls] | divided_by: 100.0 }}em;
        --type-{{ css_level }}-case: {{ settings[key_case] }};
      {%- endfor %}

      --type-subheading-family: var(--font-{{ settings.type_subheading_font }}--family);
      --type-subheading-style: var(--font-{{ settings.type_subheading_font }}--style);
      --type-subheading-weight: var(--font-{{ settings.type_subheading_font }}--weight);
      --type-subheading-size: {{ settings.type_subheading_size | divided_by: 16.0 }}rem;
      --type-subheading-letter-spacing: {{ settings.type_subheading_letter_spacing | divided_by: 100.0 }}em;
      --type-subheading-case: {{ settings.type_subheading_case }};

      --type-navigation-family: var(--font-{{ settings.type_navigation_font }}--family);
      --type-navigation-style: var(--font-{{ settings.type_navigation_font }}--style);
      --type-navigation-weight: {% if settings.type_navigation_font == 'body' %}var(--font-body--weight-bold){% else %}var(--font-{{ settings.type_navigation_font }}--weight){% endif %};
      --type-navigation-size: {{ settings.type_navigation_size | divided_by: 16.0 }}rem;
      --type-navigation-letter-spacing: {{ settings.type_navigation_letter_spacing | divided_by: 100.0 }}em;
      --type-navigation-case: {{ settings.type_navigation_case }};

      --heading-stroke-width: {{ settings.heading_stroke_width }}px;
      --heading-shadow-offset: {{ settings.heading_shadow_offset }}px;

      {%- liquid
        case settings.layout_width
          when 'full'
            assign page_width = '100vw'
          when 'wide'
            assign page_width = '100rem'
          when 'narrow'
            assign page_width = '67.5rem'
          when 'custom'
            assign page_width = settings.container_custom_width | divided_by: 16.0 | append: 'rem'
          else
            assign page_width = '82.5rem'
        endcase
      -%}
      --page-width: {{ page_width }};
      --page-margin-mobile: {{ settings.container_gutter | divided_by: 16.0 }}rem;
      --page-margin-desktop: {{ settings.container_gutter_desktop | divided_by: 16.0 }}rem;
      --page-margin: var(--page-margin-mobile);
      --section-gap: {{ settings.spacing_sections | divided_by: 16.0 }}rem;
      --radius-card: {{ settings.radius_card }}px;
      --radius-media: {{ settings.radius_media }}px;
      --radius-input: {{ settings.radius_input }}px;
      --grid-gap-desktop: {{ settings.grid_horizontal_space | divided_by: 16.0 }}rem;
      --grid-row-gap-desktop: {{ settings.grid_vertical_space | divided_by: 16.0 }}rem;
      --grid-scale-mobile: {{ settings.grid_space_scale_mobile | divided_by: 100.0 }};
      /* Mobile first: the desktop spacing scaled down, full size from 750px (base.css). */
      --grid-gap: calc(var(--grid-gap-desktop) * var(--grid-scale-mobile));
      --grid-row-gap: calc(var(--grid-row-gap-desktop) * var(--grid-scale-mobile));

      --space-3xs: 0.25rem;
      --space-2xs: 0.5rem;
      --space-xs: 0.75rem;
      --space-sm: 1rem;
      --space-md: 1.5rem;
      --space-lg: 2rem;
      --space-xl: 3rem;
      --space-2xl: 4rem;

      {%- case settings.button_size -%}
        {%- when 'small' -%}{%- assign button_height = 2.5 -%}
        {%- when 'large' -%}{%- assign button_height = 3.5 -%}
        {%- else -%}{%- assign button_height = 3 -%}
      {%- endcase %}
      --button-height: {{ button_height }}rem;
      --button-padding-inline: {{ settings.button_padding_inline | divided_by: 16.0 }}rem;
      --button-radius: {{ settings.button_radius }}px;
      --button-border-width: {{ settings.button_border_width }}px;
      --button-skew: {{ settings.button_skew }}deg;
      --button-shadow-offset: {{ settings.button_shadow_offset }}px;
      --button-font-family: var(--font-{{ settings.button_font }}--family);
      --button-font-style: var(--font-{{ settings.button_font }}--style);
      --button-font-weight: {% if settings.button_font == 'body' %}var(--font-body--weight-bold){% else %}var(--font-{{ settings.button_font }}--weight){% endif %};
      --button-case: {{ settings.button_case }};
      --button-letter-spacing: {{ settings.button_letter_spacing | divided_by: 100.0 }}em;

      --card-align: {{ settings.card_alignment }};
      --card-items: {% if settings.card_alignment == 'center' %}center{% else %}flex-start{% endif %};
      --card-title-family: var(--font-{{ settings.card_title_font }}--family);
      --card-title-weight: var(--font-{{ settings.card_title_font }}--weight);
      --card-title-size: {{ settings.card_title_size | divided_by: 16.0 }}rem;
      --card-title-case: {{ settings.card_title_case }};
      --card-shadow-offset: {{ settings.card_shadow_offset }}px;

      --badge-radius: {{ settings.badge_radius }}px;
      {%- comment -%} Badge colours: --{type}-badge-background / --{type}-badge-text (snippets/product-badges). {%- endcomment -%}
      {%- assign badge_types = 'sale,sold_out,new,hot,best_seller,preorder,custom' | split: ',' -%}
      {%- for type in badge_types -%}
        {%- liquid
          assign key_background = type | append: '_badge_background'
          assign key_text = type | append: '_badge_text'
          assign token = type | replace: '_', '-'
        -%}
        {%- if settings[key_background] != blank %}--{{ token }}-badge-background: {{ settings[key_background] }};{% endif -%}
        {%- if settings[key_text] != blank %}--{{ token }}-badge-text: {{ settings[key_text] }};{% endif -%}
      {%- endfor %}

      --swatch-size: {{ settings.swatch_size | divided_by: 16.0 }}rem;
      --swatch-radius: {% case settings.swatch_shape %}{% when 'square' %}0px{% when 'round' %}0.375rem{% else %}50%{% endcase %};

      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
      --duration-fast: 160ms;
      --duration-base: 320ms;
      --duration-slow: 600ms;

      --header-height: 4.5rem;
    }

    @media (prefers-reduced-motion: reduce) {
      :root {
        --duration-fast: 0ms;
        --duration-base: 0ms;
        --duration-slow: 0ms;
      }
    }

    {% for scheme in settings.color_schemes -%}
      {%- liquid
        assign s = scheme.settings
        assign pairs = 'background:background_gradient,heading:heading_gradient,highlight:highlight_gradient,accent:accent_gradient,primary_button:primary_button_gradient,primary_button_hover:primary_button_gradient_hover,secondary_button:secondary_button_gradient,secondary_button_hover:secondary_button_gradient_hover' | split: ','
      -%}
      {% if scheme.id == body_scheme_id %}:root,{% endif %}
      .color-{{ scheme.id }} {
        --color-background: {{ s.background }};
        --color-foreground: {{ s.text }};
        --color-subtext: {{ s.subtext }};
        --color-heading: {{ s.heading }};
        --color-heading-stroke: {{ s.heading_stroke }};
        --color-highlight: {{ s.highlight }};
        --color-accent: {{ s.accent }};
        --color-on-accent: {{ s.on_accent }};
        --color-border: {{ s.border }};
        --color-shadow: {{ s.shadow }};
        --color-card: {{ s.card }};
        --color-input-background: {{ s.input_background }};
        --color-input-text: {{ s.input_text }};
        --color-input-border: {{ s.input_border }};
        --color-sale: {{ s.sale }};
        --color-primary-button: {{ s.primary_button }};
        --color-primary-button-text: {{ s.primary_button_label }};
        --color-primary-button-border: {{ s.primary_button_border }};
        --color-primary-button-hover: {{ s.primary_button_hover }};
        --color-primary-button-hover-text: {{ s.primary_button_label_hover }};
        --color-primary-button-hover-border: {{ s.primary_button_border_hover }};
        --color-secondary-button: {{ s.secondary_button }};
        --color-secondary-button-text: {{ s.secondary_button_label }};
        --color-secondary-button-border: {{ s.secondary_button_border }};
        --color-secondary-button-hover: {{ s.secondary_button_hover }};
        --color-secondary-button-hover-text: {{ s.secondary_button_label_hover }};
        --color-secondary-button-hover-border: {{ s.secondary_button_border_hover }};
        {%- for pair in pairs -%}
          {%- liquid
            assign keys = pair | split: ':'
            assign solid = s[keys[0]]
            assign gradient = s[keys[1]]
            assign token = keys[0] | replace: '_', '-'
          -%}
          --gradient-{{ token }}: {% if gradient != blank %}{{ gradient }}{% else %}linear-gradient({{ solid }}, {{ solid }}){% endif %};
        {%- endfor %}
      }
    {% endfor %}
  }

  /* Like Dawn: body takes the body scheme from :root; every scheme class
     paints its own surface; `.gradient` adds the scheme's gradient on top. */
  @layer base {
    body
    {%- for scheme in settings.color_schemes -%}
      , .color-{{ scheme.id }}
    {%- endfor %} {
      color: var(--color-foreground);
      background-color: var(--color-background);
    }

    .gradient
    {%- for scheme in settings.color_schemes -%}
      , .color-{{ scheme.id }}
    {%- endfor %} {
      background-image: var(--gradient-background);
    }
  }
{% endstyle %}
