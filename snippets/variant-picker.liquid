{% doc %}
  Variant option picker. Each option renders as pills, colour swatches (when
  the value has a swatch in the admin), variant image tiles or a dropdown. Enhanced by
  <variant-picker>, which re-renders the section for the chosen option values.

  @param {object} product - Product object.
  @param {string} section_id - Owning section id (keeps radio names unique).
  @param {string} [style] - 'buttons' (default), 'image' (variant image tiles, pills when a value has no image) or 'dropdown'.
  @param {boolean} [show_swatches] - Show swatches for values that have them. Default: true.

  @example
  {% render 'variant-picker', product: product, section_id: section.id, style: block.settings.picker_style %}
{% enddoc %}

{%- unless product.has_only_default_variant -%}
  <variant-picker class="variant-picker" data-product-url="{{ product.url }}">
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_id = section_id | append: '-' | append: option.position
        assign use_swatch = false
      -%}
      {%- if show_swatches != false -%}
        {%- capture is_swatch -%}{% render 'swatch-option', option: option %}{%- endcapture -%}
        {%- if is_swatch == 'true' -%}{%- assign use_swatch = true -%}{%- endif -%}
      {%- endif -%}

      {%- if style == 'dropdown' and use_swatch == false -%}
        {%- liquid
          assign option_label = option.name | escape
          assign select_id = 'Option-' | append: option_id
          assign select_name = 'option-' | append: option_id
          assign selected_label = ''
        -%}
        {%- capture option_tags -%}
          {%- for value in option.values -%}
            {%- capture value_label -%}
              {{- value | escape -}}
              {%- unless value.available %} — {{ 'products.product.unavailable' | t }}{% endunless -%}
            {%- endcapture -%}
            {%- if value.selected -%}
              {%- assign selected_label = value_label -%}
            {%- endif -%}
            <option
              value="{{ value | escape }}"
              data-option-value-id="{{ value.id }}"
              {% if value.selected %}
                selected
              {% endif %}
            >
              {{- value_label -}}
            </option>
          {%- endfor -%}
        {%- endcapture -%}
        <div class="field">
          {% render 'custom-select',
            id: select_id,
            name: select_name,
            label: option_label,
            options: option_tags,
            selected_label: selected_label
          %}
        </div>
      {%- else -%}
        <fieldset class="option-list">
          <legend>
            {{ option.name | escape }}:
            <span class="option-list__value">{{ option.selected_value | escape }}</span>
          </legend>
          {%- for value in option.values -%}
            {%- liquid
              assign value_unavailable = true
              if value.available
                assign value_unavailable = false
              endif
              assign value_image = nil
              if style == 'image' and use_swatch == false
                assign value_image = value.variant.featured_image
              endif
            -%}
            <label class="option">
              <input
                type="radio"
                name="option-{{ option_id }}"
                value="{{ value | escape }}"
                data-option-value-id="{{ value.id }}"
                {% if value.selected %}
                  checked
                {% endif %}
                {% unless value.available %}
                  data-unavailable
                {% endunless %}
              >
              {%- if use_swatch -%}
                <span class="option__pill option__pill--swatch"{% unless settings.swatch_show_tooltip %} title="{{ value | escape }}"{% endunless %}>
                  {% render 'swatch', value: value, unavailable: value_unavailable %}
                  <span class="visually-hidden">
                    {{- value | escape -}}
                    {%- unless value.available %}, {{ 'products.product.unavailable' | t }}{% endunless -%}
                  </span>
                </span>
              {%- elsif value_image != blank -%}
                <span class="option__pill option__pill--image">
                  <span class="option__media">
                    {{- value_image | image_url: width: 192 | image_tag: loading: 'lazy', alt: '', class: 'option__image', sizes: '96px', widths: '96, 192' -}}
                  </span>
                  <span class="option__label">
                    {{- value | escape -}}
                    {%- unless value.available -%}
                      <span class="visually-hidden">, {{ 'products.product.unavailable' | t }}</span>
                    {%- endunless -%}
                  </span>
                </span>
              {%- else -%}
                <span class="option__pill">
                  {{- value | escape -}}
                  {%- unless value.available -%}
                    <span class="visually-hidden">, {{ 'products.product.unavailable' | t }}</span>
                  {%- endunless -%}
                </span>
              {%- endif -%}
            </label>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-picker>
{%- endunless -%}

{% stylesheet %}
@layer components {
  .option-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: 0;
    border: 0;
  }

  .option-list legend {
    width: 100%;
    margin-block-end: var(--space-2xs);
    font-size: 0.875rem;
    font-weight: var(--font-body--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .option-list__value {
    font-weight: var(--font-body--weight);
    text-transform: none;
    color: var(--color-subtext);
  }

  .option {
    position: relative;
    display: inline-flex;
  }

  .option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .option__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    font-size: 0.875rem;
    transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
  }

  .option__pill--swatch {
    min-width: 0;
    min-height: 0;
    padding: 0.1875rem;
    border-radius: var(--swatch-radius);
  }

  .option input:checked + .option__pill {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .option input:focus-visible + .option__pill {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .option input:disabled + .option__pill,
  .option input[data-unavailable] + .option__pill {
    color: var(--color-subtext);
    text-decoration: line-through;
  }

  .option__image {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: cover;
    border-radius: calc(var(--radius-input) - 2px);
  }
}
{% endstylesheet %}
