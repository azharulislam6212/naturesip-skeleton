{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% render 'text-direction' %}">
  <head>
    <style>
      @layer reset, tokens, base, layout, components, sections, utilities;
    </style>
    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    {% render 'stylesheets', context: 'minimal' %}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.body_color_scheme.id }}">
    <main class="gift-card page-width" id="MainContent">
      <header class="gift-card__header">
        <p class="type-subheading">{{ shop.name | escape }}</p>
        {%- assign initial_value = gift_card.initial_value | money -%}
        <h1 class="type-heading type-h2">{{ 'gift_cards.issued.title' | t: value: initial_value }}</h1>
      </header>

      <div class="gift-card__card">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'gift-card__logo', width: 160 }}
        {%- endif -%}
        <p class="gift-card__balance type-heading type-h1">{{ gift_card.balance | money }}</p>
        {%- assign expiry_date = gift_card.expires_on | date: format: 'date' -%}
        {%- if gift_card.expired -%}
          <p class="badge badge--sold-out">{{ 'gift_cards.issued.expired' | t: expiry: expiry_date }}</p>
        {%- elsif gift_card.enabled == false -%}
          <p class="badge badge--sold-out">{{ 'gift_cards.issued.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          <p>{{ 'gift_cards.issued.expires_on' | t: expires_on: expiry_date }}</p>
        {%- endif -%}

        <div class="gift-card__code">
          <label class="field__label" for="GiftCardCode">{{ 'gift_cards.issued.code' | t }}</label>
          <input class="input" id="GiftCardCode" type="text" value="{{ gift_card.code | format_code }}" readonly>
        </div>

        <div class="gift-card__qr" id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
          </a>
        {%- endif -%}
      </div>

      <div class="gift-card__actions">
        {%- assign shop_label = 'gift_cards.issued.shop_link' | t -%}
        {% render 'button', label: shop_label, url: shop.url, icon: 'arrow' %}
        <button class="link" type="button" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
    </main>

    <script>
      window.addEventListener('load', () => {
        const target = document.getElementById('QrCode');
        if (target && window.QRCode) {
          new window.QRCode(target, { text: target.dataset.identifier, width: 120, height: 120 });
        }
      });
    </script>
  </body>
</html>
